<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MyClinic.OriginalTheme.ChildrenDentalChart" FlowDirection="LeftToRight" MinHeight="320" HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MyClinic;component/DentalChartStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="8,0,8,8">
            <TextBlock Text="يمين المريض" HorizontalAlignment="Left" Foreground="{DynamicResource AppTextSecondary}" />
            <TextBlock Text="يسار المريض" HorizontalAlignment="Right" Foreground="{DynamicResource AppTextSecondary}" />
        </Grid>
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="11" Text="الفك العلوي" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" FontSize="13" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="11" Text="الفك السفلي" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" FontSize="13" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="55" Tag="Upper" Grid.Row="1" Grid.Column="0" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="54" Tag="Upper" Grid.Row="1" Grid.Column="1" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="53" Tag="Upper" Grid.Row="1" Grid.Column="2" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="52" Tag="Upper" Grid.Row="1" Grid.Column="3" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="51" Tag="Upper" Grid.Row="1" Grid.Column="4" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="61" Tag="Upper" Grid.Row="1" Grid.Column="6" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="62" Tag="Upper" Grid.Row="1" Grid.Column="7" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="63" Tag="Upper" Grid.Row="1" Grid.Column="8" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="64" Tag="Upper" Grid.Row="1" Grid.Column="9" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="65" Tag="Upper" Grid.Row="1" Grid.Column="10" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="85" Tag="Lower" Grid.Row="3" Grid.Column="0" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="84" Tag="Lower" Grid.Row="3" Grid.Column="1" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="83" Tag="Lower" Grid.Row="3" Grid.Column="2" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="82" Tag="Lower" Grid.Row="3" Grid.Column="3" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="81" Tag="Lower" Grid.Row="3" Grid.Column="4" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="71" Tag="Lower" Grid.Row="3" Grid.Column="6" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="72" Tag="Lower" Grid.Row="3" Grid.Column="7" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="73" Tag="Lower" Grid.Row="3" Grid.Column="8" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="74" Tag="Lower" Grid.Row="3" Grid.Column="9" />
                <ToggleButton Style="{StaticResource AnatomicalTooth}" Content="75" Tag="Lower" Grid.Row="3" Grid.Column="10" />
                <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="5" Width="1" Background="{DynamicResource AppBorder}" Margin="0,8" />
            </Grid>
        </Viewbox>
        <TextBlock Text="ترقيم FDI · انقر على السن لتحديده · مرّر المؤشر لعرض نوع السن" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondary}" FontSize="12" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>