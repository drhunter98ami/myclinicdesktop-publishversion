<UserControl x:Class="MyClinic.OriginalTheme.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:MyClinic"
             FlowDirection="RightToLeft"
             Background="{DynamicResource AppWindowBg}"
             Foreground="{DynamicResource AppTextPrimary}"
             FontFamily="Segoe UI"
             FontSize="14">

    <UserControl.Resources>

        <!-- Main tab button -->
        <Style x:Key="MainTabBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active main tab -->
        <Style x:Key="MainTabBtnActive" BasedOn="{StaticResource MainTabBtn}" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>

        <!-- Subtab button -->
        <Style x:Key="SubTabBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active subtab button -->
        <Style x:Key="SubTabBtnActive" BasedOn="{StaticResource SubTabBtn}" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>

        <!-- Nav arrow button -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Now button -->
        <Style x:Key="NowBtn" BasedOn="{StaticResource NavBtn}" TargetType="Button">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>

        <!-- Export action button -->
        <Style x:Key="ExportBtn" BasedOn="{StaticResource NowBtn}" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#0F766E"/>
            <Setter Property="BorderBrush" Value="#0F766E"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- main tabs -->
            <RowDefinition Height="Auto"/>
            <!-- subtabs + date nav -->
            <RowDefinition Height="Auto"/>
            <!-- export note -->
            <RowDefinition Height="*"/>
            <!-- pie + legend -->
        </Grid.RowDefinitions>

        <!-- ══ Row 0 — Main tabs ══ -->
        <Border motion:NavigationTransition.Motion="Header" motion:NavigationTransition.Order="0" Grid.Row="0"
                Background="{DynamicResource AppCardBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="24,0">
                <Button x:Name="BtnTabIncome"
                        Content="الدخل"
                        Style="{StaticResource MainTabBtnActive}"
                        Margin="0,0,20,0"
                        Click="BtnTabIncome_Click"/>
                <Button x:Name="BtnTabExpenses"
                        Content="المصاريف"
                        Style="{StaticResource MainTabBtn}"
                        Click="BtnTabExpenses_Click"/>
                <Button x:Name="BtnTabTreatments"
                        Content="المعالجات"
                        Style="{StaticResource MainTabBtn}"
                        Click="BtnTabTreatments_Click"/>
                <Button x:Name="BtnTabVisits"
                        Content="الزيارات"
                        Style="{StaticResource MainTabBtn}"
                        Click="BtnTabVisits_Click"/>
            </StackPanel>
        </Border>

        <!-- ══ Row 1 — Subtabs + date navigation ══ -->
        <Border motion:NavigationTransition.Motion="Toolbar" motion:NavigationTransition.Order="1" Grid.Row="1"
                Background="{DynamicResource AppCardBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- subtabs -->
                    <ColumnDefinition Width="*"/>
                    <!-- spacer -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- date nav -->
                </Grid.ColumnDefinitions>

                <!-- Subtabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnDaily"   Content="يومي"   Style="{StaticResource SubTabBtnActive}" Margin="0,0,12,0" Click="BtnDaily_Click"/>
                    <Button x:Name="BtnMonthly" Content="شهري"   Style="{StaticResource SubTabBtn}"       Margin="0,0,12,0" Click="BtnMonthly_Click"/>
                    <Button x:Name="BtnYearly"  Content="سنوي"   Style="{StaticResource SubTabBtn}"                         Click="BtnYearly_Click"/>
                </StackPanel>

                <!-- Date navigation -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnNow" Content="الآن" Style="{StaticResource NowBtn}" Margin="0,0,10,0" Click="BtnNow_Click"/>
                    <!-- Single combined PDF report (income + expenses, expenses, treatments) for the selected period -->
                    <Button x:Name="BtnExportPdf" Content="تصدير التقرير PDF" Style="{StaticResource ExportBtn}" Margin="0,0,10,0" Click="BtnExportPdf_Click"/>
                    <!-- forward (toward future) -->
                    <Button Content="&#8249;" Style="{StaticResource NavBtn}" Margin="0,0,6,0" Click="BtnNext_Click"/>
                    <TextBlock x:Name="TblDateLabel"
                               Text="..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimary}"
                               VerticalAlignment="Center"
                               MinWidth="160"
                               TextAlignment="Center"
                               Margin="4,0"/>
                    <!-- back (toward past) -->
                    <Button Content="&#8250;" Style="{StaticResource NavBtn}" Margin="6,0,0,0" Click="BtnPrev_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border motion:NavigationTransition.Motion="Toolbar" motion:NavigationTransition.Order="2" Grid.Row="2"
                Background="#142563EB"
                BorderBrush="#3B82F6"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,10"
                Margin="20,8">
            <TextBlock Text="ملف التقرير الذي يتم تصديره يختلف باختلاف السنة/الشهر/اليوم الذي تختاره (الظاهر حالياً في الشاشة)"
                       Foreground="{DynamicResource AppTextPrimary}"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ══ Row 3 — Pie chart + legend ══ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,4,12,24">
                <motion:StatisticsDashboard x:Name="AnalyticsDashboard"/>
                <motion:StatisticsBreakdown x:Name="CategoryBreakdown"/>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
