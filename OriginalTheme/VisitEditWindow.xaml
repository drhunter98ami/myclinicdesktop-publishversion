<Window x:Class="MyClinic.OriginalTheme.VisitEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل الزيارة"
        Width="820"
        Height="820"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppWindowBg}"
        Foreground="{DynamicResource AppTextPrimary}"
        FontFamily="Segoe UI"
        FontSize="14">
    <Window.Resources>
        <Style x:Key="EditField" TargetType="TextBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EditCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <TextBlock Text="⌄" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="28,6,10,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              TextElement.Foreground="{DynamicResource AppTextPrimary}"/>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="{DynamicResource AppCardBg}"
                                        BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4"
                                        Margin="0,3,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240">
                                    <ScrollViewer CanContentScroll="True">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="5"
                                    Background="{DynamicResource AppInputBg}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 3,10 L 8,15 L 17,5"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#0D9488"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#0D9488"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="تعديل بيانات الزيارة"
                       FontFamily="Traditional Arabic"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppTextPrimary}"/>
            <TextBlock Text="سيُحفظ كل تغيير مع وقته الدقيق وقيمته قبل التعديل وبعده. يمكنك تعديل الملاحظات والقياسات والوصفة الطبية وإضافة صور."
                       Foreground="{DynamicResource AppTextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="الحالة الصحية" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox x:Name="IsPregnantCheckBox" Content="حامل" Margin="0,0,20,0" Foreground="{DynamicResource AppTextPrimary}"/>
                            <CheckBox x:Name="IsNursingCheckBox" Content="مرضع" Foreground="{DynamicResource AppTextPrimary}"/>
                        </WrapPanel>
                        <Grid>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="شهر الحمل" Style="{StaticResource EditLabel}"/>
                                <TextBox x:Name="PregnancyMonthText" Style="{StaticResource EditField}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="العلامات الحيوية" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="ضغط الدم" Style="{StaticResource EditLabel}"/><TextBox x:Name="BloodPressureText" Style="{StaticResource EditField}"/></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="النبض" Style="{StaticResource EditLabel}"/><TextBox x:Name="HeartRateText" Style="{StaticResource EditField}"/></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4"><TextBlock Text="الحرارة" Style="{StaticResource EditLabel}"/><TextBox x:Name="TemperatureText" Style="{StaticResource EditField}"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0"><TextBlock Text="معدل التنفس" Style="{StaticResource EditLabel}"/><TextBox x:Name="RespiratoryRateText" Style="{StaticResource EditField}"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"><TextBlock Text="الوزن" Style="{StaticResource EditLabel}"/><TextBox x:Name="WeightText" Style="{StaticResource EditField}"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,12,0,0"><TextBlock Text="الطول" Style="{StaticResource EditLabel}"/><TextBox x:Name="HeightText" Style="{StaticResource EditField}"/></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0"><TextBlock Text="سكر الدم" Style="{StaticResource EditLabel}"/><TextBox x:Name="BloodSugarText" Style="{StaticResource EditField}"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="الشكوى والتشخيص والعلاج" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="شكوى المريض" Style="{StaticResource EditLabel}"/>
                        <TextBox x:Name="SymptomsText" Style="{StaticResource EditField}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                        <TextBlock Text="التشخيص" Style="{StaticResource EditLabel}" Margin="0,12,0,6"/>
                        <TextBox x:Name="DiagnosisText" Style="{StaticResource EditField}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                        <TextBlock Text="خطة العلاج والملاحظات" Style="{StaticResource EditLabel}" Margin="0,12,0,6"/>
                        <TextBox x:Name="TreatmentPlanText" Style="{StaticResource EditField}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                        <TextBlock Text="الإجراء النهائي" Style="{StaticResource EditLabel}" Margin="0,12,0,6"/>
                        <TextBox x:Name="FinalTreatmentText" Style="{StaticResource EditField}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="الوصفة الطبية" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="اسم الدواء" Style="{StaticResource EditLabel}"/>
                        <TextBox x:Name="TxtPrescriptionMedicine" Style="{StaticResource EditField}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="العيار" Style="{StaticResource EditLabel}"/>
                                <TextBox x:Name="TxtPrescriptionDosage" Style="{StaticResource EditField}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="التكرار (ساعات)" Style="{StaticResource EditLabel}"/>
                                <TextBox x:Name="TxtPrescriptionFrequency" Style="{StaticResource EditField}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="التوقيت" Style="{StaticResource EditLabel}"/>
                                <ComboBox x:Name="CmbPrescriptionTiming" Style="{StaticResource EditCombo}" SelectedIndex="0">
                                    <ComboBoxItem Content="بعد الطعام"/>
                                    <ComboBoxItem Content="قبل الطعام"/>
                                    <ComboBoxItem Content="عند اللزوم"/>
                                    <ComboBoxItem Content="قبل النوم"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="ملاحظات إضافية" Style="{StaticResource EditLabel}"/>
                        <TextBox x:Name="TxtPrescriptionNotes" Style="{StaticResource EditField}" MinHeight="55" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="إضافة للوصفة" Click="AddPrescription_Click" Padding="14,8" Background="#0D9488" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,4"/>
                            <Button x:Name="BtnUpdatePrescription" Content="تحديث المحدد" Click="UpdatePrescription_Click" Padding="14,8" Background="{DynamicResource AppInputBg}" Foreground="{DynamicResource AppTextPrimary}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Cursor="Hand" Margin="0,0,8,4" IsEnabled="False"/>
                            <Button Content="حذف المحدد" Click="RemovePrescription_Click" Padding="14,8" Background="{DynamicResource AppInputBg}" Foreground="{DynamicResource AppTextPrimary}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Cursor="Hand" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <TextBlock Text="عناصر الوصفة الحالية" Style="{StaticResource EditLabel}"/>
                        <ListBox x:Name="LstPrescriptionEntries" MinHeight="100" MaxHeight="180" Background="{DynamicResource AppInputBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Foreground="{DynamicResource AppTextPrimary}" Padding="6" SelectionChanged="LstPrescriptionEntries_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="صور ومرفقات الزيارة" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="ImageSelectionHint"
                                   Text="يمكن إضافة صور جديدة دون حذف الصور الموجودة."
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   Margin="0,4,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="إضافة صور"
                                    Click="SelectImages_Click"
                                    Padding="14,8"
                                    Background="#0D9488"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                            <Button Content="مسح الصور المحددة"
                                    Click="ClearSelectedImages_Click"
                                    Padding="14,8"
                                    Margin="8,0,0,0"
                                    Background="{DynamicResource AppInputBg}"
                                    Foreground="{DynamicResource AppTextPrimary}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    Cursor="Hand"/>
                        </StackPanel>
                        <ItemsControl x:Name="SelectedImagesList" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ التعديل" Width="130" Height="42" Margin="0,0,10,0" Background="#0D9488" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="Save_Click"/>
            <Button Content="إلغاء" Width="100" Height="42" Background="{DynamicResource AppInputBg}" Foreground="{DynamicResource AppTextPrimary}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Cursor="Hand" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
