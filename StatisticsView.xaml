<UserControl x:Class="MyClinic.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:MyClinic"
             FlowDirection="RightToLeft"
             Background="Transparent"
             Foreground="{DynamicResource AppTextPrimary}"
             FontFamily="Segoe UI"
             FontSize="14"
             PreviewMouseMove="Statistics_PreviewMouseMove"
             MouseLeave="Statistics_MouseLeave">

    <UserControl.Resources>
        <!-- ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Margin="2,0,0,0">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{DynamicResource AppBorder}" CornerRadius="4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Main tab button -->
        <Style x:Key="MainTabBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active main tab -->
        <Style x:Key="MainTabBtnActive" BasedOn="{StaticResource MainTabBtn}" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource DashActiveFilterBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsPrimaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtab button -->
        <Style x:Key="SubTabBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SubBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SubBd" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active subtab button -->
        <Style x:Key="SubTabBtnActive" BasedOn="{StaticResource SubTabBtn}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DashActiveFilterBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsPrimaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav arrow button -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsOutlineBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsOutlineBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Now button -->
        <Style x:Key="NowBtn" BasedOn="{StaticResource NavBtn}" TargetType="Button">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource DashCalendarTodayBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource DashCalendarTodayNumFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DashCalendarTodayBorder}"/>
        </Style>

        <!-- Export action button -->
        <Style x:Key="ExportBtn" BasedOn="{StaticResource NowBtn}" TargetType="Button">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="{DynamicResource SettingsOutlineBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsOutlineBtnBorder}"/>
        </Style>

        <!-- Primary PDF Export button -->
        <Style x:Key="PdfExportBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource SettingsGreenBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsGreenBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="StatisticsRootGrid" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Main & Sub Tabs Toolbar Card -->
            <RowDefinition Height="Auto"/>
            <!-- Export Note Banner -->
            <RowDefinition Height="*"/>
            <!-- Charts & Legend -->
        </Grid.RowDefinitions>

        <!-- طبقة الإضاءة الخلفية التفاعلية للوضع الداكن -->
        <Canvas x:Name="StatisticsSpotlightCanvas"
                Grid.RowSpan="4"
                Panel.ZIndex="0"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Ellipse x:Name="StatisticsSpotlightEllipse" CacheMode="BitmapCache"
                     Width="620"
                     Height="620"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#4514B8A6" Offset="0.0"/>
                        <GradientStop Color="#220EA5E9" Offset="0.42"/>
                        <GradientStop Color="#0C2DD4BF" Offset="0.72"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="StatisticsSpotlightTransform" X="-1200" Y="-1200"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- ══ Row 0 — Hero Header Banner ══ -->
        <Border motion:NavigationTransition.Motion="Header" motion:NavigationTransition.Order="0" Grid.Row="0"
                Panel.ZIndex="2"
                Background="{DynamicResource SettingsBannerBg}"
                BorderBrush="{DynamicResource SettingsBannerBorder}"
                BorderThickness="1.2"
                CornerRadius="18"
                Padding="28,18"
                Margin="4,2,4,14"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#2DD4BF"
                                  BlurRadius="20"
                                  ShadowDepth="0"
                                  Opacity="{DynamicResource SettingsBannerGlowOpacity}"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="الإحصائيات"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SettingsBannerTitleFg}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="تحليل الدخل والمصاريف والزيارات والمعالجات مع إمكانية تصدير التقارير الدورية"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SettingsBannerSubFg}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource SettingsBannerPillBg}"
                        BorderBrush="{DynamicResource SettingsBannerPillBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,9"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9D2;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Foreground="{DynamicResource SettingsBannerPillFg}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="التقارير والتحليلات"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SettingsBannerPillFg}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Row 1 — Unified Tabs + Date Navigation Card ══ -->
        <Border motion:NavigationTransition.Motion="Toolbar" motion:NavigationTransition.Order="1" Grid.Row="1"
                Panel.ZIndex="2"
                Background="{DynamicResource SettingsCardBg}"
                BorderBrush="{DynamicResource SettingsCardBorder}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18,14"
                Margin="4,0,4,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Main Tabs (Right) + PDF Export Button (Left) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource DashFilterGroupBg}"
                            BorderBrush="{DynamicResource DashFilterGroupBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnTabIncome"
                                    Content="الدخل"
                                    Style="{StaticResource MainTabBtnActive}"
                                    Margin="0,0,4,0"
                                    Click="BtnTabIncome_Click"/>
                            <Button x:Name="BtnTabExpenses"
                                    Content="المصاريف"
                                    Style="{StaticResource MainTabBtn}"
                                    Margin="0,0,4,0"
                                    Click="BtnTabExpenses_Click"/>
                            <Button x:Name="BtnTabTreatments"
                                    Content="المعالجات"
                                    Style="{StaticResource MainTabBtn}"
                                    Margin="0,0,4,0"
                                    Click="BtnTabTreatments_Click"/>
                            <Button x:Name="BtnTabVisits"
                                    Content="الزيارات"
                                    Style="{StaticResource MainTabBtn}"
                                    Click="BtnTabVisits_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Single combined PDF report (income + expenses, expenses, treatments) for the selected period -->
                    <Button Grid.Column="2"
                            x:Name="BtnExportPdf"
                            Content="تصدير التقرير PDF"
                            Style="{StaticResource PdfExportBtn}"
                            Click="BtnExportPdf_Click"/>
                </Grid>

                <!-- Row 2: Subtabs (Right) + Chart Type & Date Nav (Left) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Subtabs -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource DashFilterGroupBg}"
                            BorderBrush="{DynamicResource DashFilterGroupBorder}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnDaily"   Content="يومي"   Style="{StaticResource SubTabBtnActive}" Margin="0,0,4,0" Click="BtnDaily_Click"/>
                            <Button x:Name="BtnMonthly" Content="شهري"   Style="{StaticResource SubTabBtn}"       Margin="0,0,4,0" Click="BtnMonthly_Click"/>
                            <Button x:Name="BtnYearly"  Content="سنوي"   Style="{StaticResource SubTabBtn}"                        Click="BtnYearly_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Date navigation -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnNow" Content="الآن" Style="{StaticResource NowBtn}" Margin="0,0,8,0" Click="BtnNow_Click"/>
                        <!-- forward (toward future) -->
                        <Button Content="&#8249;" Style="{StaticResource NavBtn}" Margin="0,0,6,0" Click="BtnNext_Click"/>
                        <Border Background="{DynamicResource DashFilterGroupBg}"
                                BorderBrush="{DynamicResource DashFilterGroupBorder}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14,0"
                                Height="36">
                            <TextBlock x:Name="TblDateLabel"
                                       Text="..."
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimary}"
                                       VerticalAlignment="Center"
                                       MinWidth="136"
                                       TextAlignment="Center"/>
                        </Border>
                        <!-- back (toward past) -->
                        <Button Content="&#8250;" Style="{StaticResource NavBtn}" Margin="6,0,0,0" Click="BtnPrev_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ══ Row 2 — Export Info Banner ══ -->
        <Border motion:NavigationTransition.Motion="Toolbar" motion:NavigationTransition.Order="2" Grid.Row="2"
                Panel.ZIndex="2"
                Background="{DynamicResource SettingsCalloutBg}"
                BorderBrush="{DynamicResource SettingsCalloutBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,9"
                Margin="4,0,4,12">
            <TextBlock Text="ملف التقرير الذي يتم تصديره يختلف باختلاف السنة/الشهر/اليوم الذي تختاره (الظاهر حالياً في الشاشة)"
                       Foreground="{DynamicResource SettingsCalloutFg}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ══ Row 3 — Pie chart + legend + period chart ══ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,4,12,24">
                <motion:StatisticsDashboard x:Name="AnalyticsDashboard"/>
                <motion:StatisticsBreakdown x:Name="CategoryBreakdown"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
