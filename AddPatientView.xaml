<!-- AddPatientView.xaml -->
<UserControl x:Class="MyClinic.AddPatientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:MyClinic"
             xmlns:local="clr-namespace:MyClinic"
             FlowDirection="RightToLeft"
             Background="Transparent"
             FontFamily="Segoe UI"
             FontSize="14"
             x:Name="Root"
             PreviewMouseMove="AddPatient_PreviewMouseMove"
             MouseLeave="AddPatient_MouseLeave">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- شريط التمرير (ScrollBar) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Margin="2,0,2,0">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{DynamicResource AppBorder}" CornerRadius="4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- البطاقة الرئيسية للأقسام -->
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource VisitCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- عناوين الحقول -->
        <Style TargetType="TextBlock" x:Key="FormLabel">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- حقول الإدخال النصية الحديثة -->
        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource VisitSubCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitSubCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           Margin="12,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="6,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource DashCalendarTodayBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- القوائم المنسدلة الحديثة -->
        <Style TargetType="ComboBox" x:Key="ModernComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="{DynamicResource VisitSubCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitSubCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Background="{TemplateBinding Background}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <Path x:Name="Arrow"
                                                  Fill="{DynamicResource AppTextSecondary}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0"
                                                  Data="M0,0 L4,4 L8,0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource VisitCardBg}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource VisitCardBorder}"
                                            CornerRadius="10"
                                            Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.22"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DashCalendarTodayBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DashCalendarTodayNumFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- الأزرار الأساسية والثانوية المتوافقة مع الثيم -->
        <Style TargetType="Button" x:Key="PrimaryActionButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource VisitPrimaryBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitPrimaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryActionButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="{DynamicResource VisitSecondaryBtnFg}"/>
            <Setter Property="Background" Value="{DynamicResource VisitSecondaryBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitSecondaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="SoftSectionCard">
            <Setter Property="Background" Value="{DynamicResource VisitSubCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitSubCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style TargetType="Button" x:Key="FlatCardButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VisitEntryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.94"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModalHeaderChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource VisitModalChipBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitModalChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DetailSectionStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource VisitCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitCardBorder}"/>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Width" Value="146"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource VisitSubCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitSubCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="AddPatientRootGrid" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- طبقة الإضاءة الخلفية التفاعلية للوضع الداكن (Behind Cards Spotlight) -->
        <Canvas x:Name="AddPatientBackSpotlightCanvas"
                Grid.RowSpan="3"
                Panel.ZIndex="0"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Ellipse x:Name="AddPatientBackSpotlight" CacheMode="BitmapCache"
                     Width="620"
                     Height="620"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#4514B8A6" Offset="0.0"/>
                        <GradientStop Color="#220EA5E9" Offset="0.42"/>
                        <GradientStop Color="#0C2DD4BF" Offset="0.72"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="AddPatientBackSpotlightTransform" X="-1000" Y="-1000"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- الترويسة العلوية المنسقة بنفس ثيم بطاقة الترحيب في الصور -->
        <Border motion:NavigationTransition.Motion="Header" motion:NavigationTransition.Order="0" Grid.Row="0"
                Panel.ZIndex="2"
                Margin="0,0,0,14"
                Padding="26,18"
                CornerRadius="20"
                Background="{DynamicResource VisitBannerBg}"
                BorderBrush="{DynamicResource VisitBannerBorder}"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <!-- رسمة السن المائية في الخلفية -->
                <Viewbox Width="110"
                         Height="110"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Margin="0,-10,220,-10"
                         IsHitTestVisible="False">
                    <Canvas Width="120" Height="120">
                        <Path Stroke="{DynamicResource VisitBannerToothBrush}"
                              StrokeThickness="5.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M60,24 C47,12 24,16 22,38 C20,56 30,68 33,88 C35,103 42,108 47,96 C51,85 55,78 60,78 C65,78 69,85 73,96 C78,108 85,103 87,88 C90,68 100,56 98,38 C96,16 73,12 60,24 Z"/>
                        <Path Stroke="{DynamicResource VisitBannerToothBrush}"
                              StrokeThickness="3.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M43,36 C52,43 68,43 77,36"/>
                    </Canvas>
                </Viewbox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="تسجيل زيارة جديدة"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource VisitBannerTitleFg}"
                                       VerticalAlignment="Center"/>
                            <!-- أيقونة النجوم في الوضع الداكن -->
                            <Viewbox x:Name="IconBannerSparkles"
                                     Width="24"
                                     Height="24"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed">
                                <Canvas Width="32" Height="32">
                                    <Path Stroke="#38BDF8" StrokeThickness="1.8" Fill="#2238BDF8" StrokeLineJoin="Round"
                                          Data="M18,3 L20.5,11.5 L29,14 L20.5,16.5 L18,25 L15.5,16.5 L7,14 L15.5,11.5 Z"/>
                                    <Path Stroke="#5EEAD4" StrokeThickness="1.5" StrokeLineJoin="Round"
                                          Data="M7,4 L8,7.5 L11.5,8.5 L8,9.5 L7,13 L6,9.5 L2.5,8.5 L6,7.5 Z"/>
                                </Canvas>
                            </Viewbox>
                        </StackPanel>
                        <TextBlock Text="أدخل البيانات الشخصية والسريرية والمالية، أو اختر مريضاً مسجلاً لاستعراض بطاقات زياراته السابقة."
                                   Foreground="{DynamicResource VisitBannerSubFg}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnSaveVisitTop" Content="حفظ وإنهاء الزيارة"
                                Style="{StaticResource PrimaryActionButton}"
                                Height="42"
                                Margin="0,0,10,0"
                                Click="BtnSaveVisit_Click"/>
                        <Button Content="إلغاء"
                                Style="{StaticResource SecondaryActionButton}"
                                Height="42"
                                Width="95"
                                Click="BtnCancel_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Panel.ZIndex="2" VerticalScrollBarVisibility="Auto" Padding="4,2,4,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- ROW 0: Top Section (Side-by-Side Layout) -->

                <!-- Left Column (Clinical Data Top) -->
                <StackPanel motion:NavigationTransition.Motion="Cards" motion:NavigationTransition.Order="1" Grid.Row="0" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Top">

                    <!-- اختيار العلاجات -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="اختيار العلاجات" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl motion:NavigationTransition.Motion="Items" motion:NavigationTransition.Order="4" x:Name="TreatmentItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource VisitSubCardBg}"
                                                    BorderBrush="{DynamicResource VisitSubCardBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="14,10"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Row="0" Grid.Column="0"
                                                              x:Name="ChkTreatment"
                                                              IsChecked="{Binding IsSelected}"
                                                              Checked="TreatmentCheckBox_Changed"
                                                              Unchecked="TreatmentCheckBox_Changed"
                                                              Margin="0,0,12,0"
                                                              VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding TreatmentName}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AppTextPrimary}"/>

                                                    <StackPanel Grid.Row="0" Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                FlowDirection="LeftToRight"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Cost, StringFormat={}{0:N0}}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource DashCalendarTodayNumFg}"/>
                                                        <TextBlock Text="{Binding CurrencySymbol}"
                                                                   Margin="4,0,0,0"
                                                                   Foreground="{DynamicResource AppTextSecondary}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="0" Grid.Column="3"
                                                               Text="×"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource AppTextSecondary}"
                                                               FontWeight="Bold"
                                                               Margin="5,0"/>

                                                    <TextBox Grid.Row="0" Grid.Column="5"
                                                             x:Name="TxtQuantity"
                                                             Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                             TextAlignment="Center"
                                                             Style="{StaticResource ModernTextBox}"
                                                             Height="34"
                                                             TextChanged="TreatmentQuantity_TextChanged"
                                                             IsEnabled="{Binding IsSelected}"
                                                             VerticalAlignment="Center"
                                                             GotKeyboardFocus="TextBox_GotKeyboardFocus"
                                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>

                                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Margin="0,10,0,0">
                                                        <TextBlock Text="تفاصيل العلاج لكل سن" Foreground="{DynamicResource DashCalendarTodayNumFg}" FontWeight="Bold" Margin="0,0,0,6"/>
                                                        <ItemsControl ItemsSource="{Binding ToothDetails}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource VisitAccentCardBg}"
                                                                            BorderBrush="{DynamicResource VisitAccentCardBorder}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="10"
                                                                            Padding="10"
                                                                            Margin="0,0,0,6">
                                                                        <StackPanel>
                                                                            <Grid HorizontalAlignment="Right">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="140"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <ComboBox Tag="{Binding}"
                                                                                          ItemsSource="{Binding ToothOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                                          SelectedItem="{Binding ToothId, UpdateSourceTrigger=PropertyChanged}"
                                                                                          Style="{StaticResource ModernComboBox}"
                                                                                          Height="34"
                                                                                          Width="140"
                                                                                          SelectionChanged="TreatmentTooth_SelectionChanged"
                                                                                          DropDownClosed="TreatmentTooth_DropDownClosed"
                                                                                          IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.IsSelected}"
                                                                                          ToolTip="رقم السن">
                                                                                    <ComboBox.ItemContainerStyle>
                                                                                        <Style TargetType="ComboBoxItem">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="— اختر السن —">
                                                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                                                    <Setter Property="Opacity" Value="0.55"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </ComboBox.ItemContainerStyle>
                                                                                </ComboBox>
                                                                                <TextBlock Grid.Column="1" Text="رقم السن" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                            </Grid>
                                                                            <Grid Margin="0,8,0,4" HorizontalAlignment="Right" Visibility="{Binding IsRootCanal, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="74"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="عدد الأقنية" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                                <TextBox Grid.Column="1"
                                                                                         Text="{Binding CanalCount, UpdateSourceTrigger=PropertyChanged}"
                                                                                         Style="{StaticResource ModernTextBox}"
                                                                                         Height="32"
                                                                                         Width="74"
                                                                                         TextAlignment="Center"
                                                                                         FontWeight="Bold"
                                                                                         Foreground="{DynamicResource VisitGlowBoxFg}"
                                                                                         Background="{DynamicResource VisitGlowBoxBg}"
                                                                                         BorderBrush="{DynamicResource VisitGlowBoxBorder}"
                                                                                         TextChanged="CanalCount_TextChanged"
                                                                                         ToolTip="عدد الأقنية"/>
                                                                            </Grid>
                                                                            <Grid Width="236"
                                                                                  HorizontalAlignment="Right"
                                                                                  Visibility="{Binding IsRootCanal, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>
                                                                                <TextBlock Text="أطوال الأقنية"
                                                                                           Foreground="{DynamicResource AppTextSecondary}"
                                                                                           FontWeight="SemiBold"
                                                                                           HorizontalAlignment="Right"
                                                                                           TextAlignment="Right"
                                                                                           Margin="0,6,0,4"/>
                                                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Canals}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Grid Margin="0,2">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="120"/>
                                                                                                    <ColumnDefinition Width="110"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                                                         Style="{StaticResource ModernTextBox}"
                                                                                                         Height="32"
                                                                                                         Margin="0,0,6,0"
                                                                                                         Tag="اسم القناة"
                                                                                                         ToolTip="اسم القناة"/>
                                                                                                <TextBox Grid.Column="1"
                                                                                                         Text="{Binding WorkingLength, UpdateSourceTrigger=PropertyChanged}"
                                                                                                         Style="{StaticResource ModernTextBox}"
                                                                                                         Height="32"
                                                                                                         TextAlignment="Center"
                                                                                                         ToolTip="طول العمل بالميليمتر"/>
                                                                                            </Grid>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- البيانات المالية -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="البيانات المالية" Foreground="{DynamicResource AppTextPrimary}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="تفاصيل الدفع والتكلفة" Foreground="{DynamicResource AppTextSecondary}" FontSize="13.5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <TextBlock Text="التكلفة الحالية" Style="{StaticResource FormLabel}" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="TxtCurrentCost"
                                             Text="0"
                                             TextAlignment="Center"
                                             FontWeight="Bold"
                                             Style="{StaticResource ModernTextBox}"
                                             TextChanged="FinancialInput_TextChanged"
                                             GotKeyboardFocus="TextBox_GotKeyboardFocus"
                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                                </StackPanel>

                                <StackPanel Grid.Column="0" Margin="10,0">
                                    <TextBlock Text="دفعة اليوم" Style="{StaticResource FormLabel}" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="TxtTodayPaid"
                                             Text="0"
                                             TextAlignment="Center"
                                             FontWeight="Bold"
                                             Style="{StaticResource ModernTextBox}"
                                             TextChanged="FinancialInput_TextChanged"
                                             GotKeyboardFocus="TextBox_GotKeyboardFocus"
                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <TextBlock Text="متبقي الزيارة" Style="{StaticResource FormLabel}" HorizontalAlignment="Center"/>
                                    <Border Background="{DynamicResource VisitGlowBoxBg}"
                                            BorderBrush="{DynamicResource VisitGlowBoxBorder}"
                                            BorderThickness="1.5"
                                            CornerRadius="10">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#2DD4BF"
                                                              BlurRadius="14"
                                                              ShadowDepth="0"
                                                              Opacity="{DynamicResource VisitGlowOpacity}"/>
                                        </Border.Effect>
                                        <TextBox x:Name="TxtRemainingAmount"
                                                 Text="0"
                                                 Height="42"
                                                 TextAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 IsReadOnly="True"
                                                 Foreground="{DynamicResource VisitGlowBoxFg}"
                                                 FontSize="16"
                                                 FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="PatientFinancialHistoryPanel"
                                    Visibility="Collapsed"
                                    Margin="0,16,0,0"
                                    Padding="16,12"
                                    Background="{DynamicResource VisitAccentCardBg}"
                                    BorderBrush="{DynamicResource VisitAccentCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="السجل المالي التراكمي للمريض:" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,15,0" VerticalAlignment="Center"/>

                                        <TextBlock Text="إجمالي التكلفة:" Foreground="{DynamicResource AppTextSecondary}" Margin="20,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTotalPatientCost" Text="0" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" FontSize="15"/>

                                        <TextBlock Text="إجمالي الدفعات:" Foreground="{DynamicResource AppTextSecondary}" Margin="20,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTotalPatientPaid" Text="0" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" FontSize="15"/>

                                        <TextBlock Text="إجمالي المتبقي:" Foreground="{DynamicResource AppTextSecondary}" Margin="20,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTotalPatientRemaining" Text="0" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" FontSize="15"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- عادات التدخين -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="عادات التدخين" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Left"/>
                            <CheckBox x:Name="ChkSmoker" Content="المريض مدخن" Margin="0,10,0,0" FlowDirection="RightToLeft" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" Checked="ChkSmoker_CheckedChanged" Unchecked="ChkSmoker_CheckedChanged"/>

                            <StackPanel x:Name="PanelSmokerDetails" Visibility="Collapsed" Margin="0,15,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="نوع التدخين" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtSmokingType" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="التكرار" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtSmokingFrequency" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- الصحة الإنجابية -->
                    <Border x:Name="CardFemaleDetails" Visibility="Collapsed" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="الصحة الإنجابية" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox x:Name="ChkPregnant" Content="حامل" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,0" Checked="ChkPregnant_CheckedChanged" Unchecked="ChkPregnant_CheckedChanged"/>
                                <CheckBox x:Name="ChkNursing" Content="مرضع" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" Margin="20,0,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelPregnancyMonth" Visibility="Collapsed" Margin="0,15,0,0">
                                <TextBlock Text="شهر الحمل" Style="{StaticResource FormLabel}"/>
                                <ComboBox x:Name="CmbPregnancyMonth" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                    <ComboBoxItem Content="الشهر الأول"/>
                                    <ComboBoxItem Content="الشهر الثاني"/>
                                    <ComboBoxItem Content="الشهر الثالث"/>
                                    <ComboBoxItem Content="الشهر الرابع"/>
                                    <ComboBoxItem Content="الشهر الخامس"/>
                                    <ComboBoxItem Content="الشهر السادس"/>
                                    <ComboBoxItem Content="الشهر السابع"/>
                                    <ComboBoxItem Content="الشهر الثامن"/>
                                    <ComboBoxItem Content="الشهر التاسع"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- الحساسية والأمراض المزمنة -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" BorderBrush="{DynamicResource VisitWarningCardBorder}" Margin="0,0,8,16">
                            <StackPanel>
                                <TextBlock Text="الحساسية والتحذيرات" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource VisitWarningFg}" HorizontalAlignment="Left"/>
                                <TextBox x:Name="TxtAllergies" Height="NaN" MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,10,0,0" Style="{StaticResource ModernTextBox}" Padding="10"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
                            <StackPanel>
                                <TextBlock Text="الأمراض المزمنة" FontSize="17" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Left"/>
                                <TextBox x:Name="TxtChronicDiseases" Height="NaN" MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,10,0,0" Style="{StaticResource ModernTextBox}" Padding="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- العلامات الحيوية -->
                    <motion:AnimatedSection Header="العلامات الحيوية (Vital Signs)" Style="{StaticResource AnimatedSectionStyle}" >
<Border Style="{StaticResource Card}">
                        <StackPanel>


                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="8,0">
                                    <TextBlock Text="ضغط الدم (BP)" Style="{StaticResource FormLabel}" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="TxtBloodPressure" Tag="120/80" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="النبض (HR)" Style="{StaticResource FormLabel}" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="TxtHeartRate" Tag="72" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="8,0">
                                    <TextBlock Text="الحرارة (Temp)" Style="{StaticResource FormLabel}" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="TxtTemperature" Tag="37.0" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="8,0">
                                    <TextBlock Text="التنفس (RR)" Style="{StaticResource FormLabel}" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="TxtRespiratoryRate" Tag="16" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="8,0">
                                    <TextBlock Text="الوزن (Weight)" Style="{StaticResource FormLabel}" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="TxtWeight" Tag="70" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="الطول (Height)" Style="{StaticResource FormLabel}" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="TxtHeight" Tag="170" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="8,0">
                                    <TextBlock Text="سكر الدم (Blood Sugar)" Style="{StaticResource FormLabel}" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="TxtBloodSugar" Tag="95" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
</motion:AnimatedSection>

                    <!-- شكوى المريض والتشخيص -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="شكوى المريض" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Left"/>
                                <TextBox x:Name="TxtSymptoms" Height="NaN" MinHeight="82" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,10,0,0" Style="{StaticResource ModernTextBox}" VerticalContentAlignment="Top" Padding="10"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="التشخيص (Diagnosis)" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Left"/>
                                <TextBox x:Name="TxtDiagnosis" Height="NaN" MinHeight="82" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,10,0,0" Style="{StaticResource ModernTextBox}" VerticalContentAlignment="Top" Padding="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Right Column (Personal Data Sidebar Top + Previous Visit Cards) -->
                <StackPanel motion:NavigationTransition.Motion="Cards" motion:NavigationTransition.Order="2" Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="البيانات الشخصية" Foreground="{DynamicResource AppTextPrimary}" FontSize="19" FontWeight="Bold" Margin="0,0,0,14" HorizontalAlignment="Center"/>
                            <Border Height="1" Background="{DynamicResource VisitCardBorder}" Margin="0,0,0,15"/>

                            <TextBlock Text="رقم الهاتف *" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtPhoneNumber"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,15"
                                     TextChanged="PatientLookup_TextChanged"/>

                            <TextBlock Text="الاسم الثلاثي" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtFullName"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,15"
                                     TextChanged="PatientLookup_TextChanged"/>

                            <!-- مطابقات سابقة -->
                            <Border x:Name="PatientSuggestionsPanel"
                                    Background="{DynamicResource VisitAccentCardBg}"
                                    BorderBrush="{DynamicResource VisitAccentCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,0,0,15"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="مطابقات سابقة" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBlock x:Name="TxtPatientSuggestionsHint" Text="اختر المريض المناسب لتعبئة البيانات تلقائياً." Margin="0,4,0,10" Foreground="{DynamicResource AppTextSecondary}"/>

                                    <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ItemsPatientSuggestions">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource FlatCardButton}" Tag="{Binding}" Click="BtnApplyPatientSuggestion_Click" Margin="0,0,0,8">
                                                        <Border Background="{DynamicResource VisitCardBg}"
                                                                BorderBrush="{DynamicResource VisitCardBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="12"
                                                                Padding="12">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                                                    <TextBlock Text="{Binding SecondaryLine}" Margin="0,4,0,0" Foreground="{DynamicResource AppTextSecondary}"/>
                                                                    <TextBlock Text="{Binding MetaLine}" Margin="0,4,0,0" Foreground="{DynamicResource AppTextSecondary}" FontSize="12"/>
                                                                </StackPanel>

                                                                <Border Grid.Column="1"
                                                                        Background="{DynamicResource VisitPrimaryBtnBg}"
                                                                        BorderBrush="{DynamicResource VisitPrimaryBtnBorder}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="999"
                                                                        Padding="12,5"
                                                                        Margin="12,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding MatchReason}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="العمر" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="TxtAge"
                                             Text="0"
                                             Style="{StaticResource ModernTextBox}"
                                             GotKeyboardFocus="TextBox_GotKeyboardFocus"
                                             PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="الجنس" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="CmbGender" Style="{StaticResource ModernComboBox}" SelectedIndex="0" SelectionChanged="CmbGender_SelectionChanged">
                                        <ComboBoxItem Content="ذكر"/>
                                        <ComboBoxItem Content="أنثى"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="زمرة الدم" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="CmbBloodType" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="غير محدد" IsSelected="True"/>
                                <ComboBoxItem Content="A+"/>
                                <ComboBoxItem Content="A-"/>
                                <ComboBoxItem Content="B+"/>
                                <ComboBoxItem Content="B-"/>
                                <ComboBoxItem Content="O+"/>
                                <ComboBoxItem Content="O-"/>
                                <ComboBoxItem Content="AB+"/>
                                <ComboBoxItem Content="AB-"/>
                            </ComboBox>

                            <!-- بطاقات الزيارات المسجلة (Previous Visits Panel & Visit Cards) -->
                            <Border x:Name="PreviousVisitsPanel"
                                    Margin="0,18,0,0"
                                    Padding="0"
                                    Background="{DynamicResource VisitSubCardBg}"
                                    BorderBrush="{DynamicResource VisitAccentCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    ClipToBounds="True"
                                    Visibility="Collapsed">

                                <StackPanel>
                                    <!-- رأس قائمة الزيارات بنفس ثيم بطاقة العداد والترحيب -->
                                    <Border CornerRadius="17,17,0,0"
                                            Padding="16,13"
                                            Background="{DynamicResource VisitHistoryHeaderBg}"
                                            BorderBrush="{DynamicResource VisitAccentCardBorder}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    MinWidth="32"
                                                    Height="30"
                                                    Padding="9,0"
                                                    CornerRadius="9"
                                                    Background="{DynamicResource VisitGlowBoxBg}"
                                                    BorderBrush="{DynamicResource VisitGlowBoxBorder}"
                                                    BorderThickness="1.5">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#2DD4BF"
                                                                      BlurRadius="12"
                                                                      ShadowDepth="0"
                                                                      Opacity="{DynamicResource VisitGlowOpacity}"/>
                                                </Border.Effect>
                                                <TextBlock x:Name="TxtPreviousVisitsCount"
                                                           Text="0"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource VisitGlowBoxFg}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       x:Name="TxtPreviousVisitsHint"
                                                       Text="الزيارات المسجلة"
                                                       FontSize="13.5"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource VisitHistoryHeaderFg}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,10,0"/>
                                        </Grid>
                                    </Border>

                                    <ListBox x:Name="ItemsPreviousVisits"
                                             MaxHeight="340"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10,10"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource VisitEntryButtonStyle}"
                                                        Tag="{Binding}"
                                                        Click="BtnOpenPreviousVisit_Click">
                                                    <Border x:Name="VisitHistoryCardBorder"
                                                            Margin="0,0,0,12"
                                                            Padding="14,13"
                                                            CornerRadius="14"
                                                            Background="{DynamicResource VisitEntryCardBg}"
                                                            BorderBrush="{DynamicResource VisitEntryCardBorder}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="6"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- مؤشر جانبي أنيق مثل بطاقات المواعيد في الصور -->
                                                            <Border Grid.Column="0"
                                                                    Width="5"
                                                                    CornerRadius="2.5"
                                                                    Background="{DynamicResource VisitEntryPillIndicator}"
                                                                    Margin="0,2,0,2"/>

                                                            <Grid Grid.Column="1" Margin="10,0,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <Grid Grid.Row="0" FlowDirection="LeftToRight">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Grid.Column="0"
                                                                            Background="{DynamicResource VisitCostPillBg}"
                                                                            BorderBrush="{DynamicResource VisitCostPillBorder}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="7"
                                                                            Padding="8,2">
                                                                        <TextBlock Text="{Binding VisitDateText}"
                                                                                   FontSize="12.5"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{DynamicResource VisitCostPillFg}"/>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="1"
                                                                                Orientation="Horizontal"
                                                                                HorizontalAlignment="Right"
                                                                                FlowDirection="RightToLeft">
                                                                        <TextBlock Text="&#xE8A5;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="14"
                                                                                   Foreground="{DynamicResource DashCalendarTodayNumFg}"
                                                                                   Margin="0,0,6,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding AttachmentLabel}"
                                                                                   FontSize="12.5"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource AppTextSecondary}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding Title}"
                                                                           FontFamily="Traditional Arabic"
                                                                           FontSize="22"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource AppTextPrimary}"
                                                                           TextWrapping="Wrap"
                                                                           TextAlignment="Right"
                                                                           Margin="0,8,0,4"/>

                                                                <Grid Grid.Row="2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0"
                                                                               Text="&#xE76C;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource DashCalendarTodayNumFg}"
                                                                               VerticalAlignment="Center"/>

                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Details}"
                                                                               FontSize="12.5"
                                                                               Foreground="{DynamicResource AppTextSecondary}"
                                                                               TextWrapping="Wrap"
                                                                               TextAlignment="Right"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock x:Name="EmptyPreviousVisitsText"
                                               Text="لا توجد زيارات محفوظة لهذا المريض حتى الآن."
                                               FontSize="14"
                                               Foreground="{DynamicResource AppTextSecondary}"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,14"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ROW 1: Bottom Section (Dental Chart + Prescriptions + Attachments & Notes) -->
                <StackPanel motion:NavigationTransition.Motion="Content" motion:NavigationTransition.Order="4" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,16">
                        <!-- مبدل مخطط الأسنان (بالغين / أطفال) -->
                        <Border Background="{DynamicResource VisitSubCardBg}"
                                BorderBrush="{DynamicResource VisitSubCardBorder}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="4"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnAdult"
                                        Content="بالغين"
                                        Width="105"
                                        Height="38"
                                        BorderThickness="0"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="BtnAdult_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="BtnChild"
                                        Content="أطفال"
                                        Width="105"
                                        Height="38"
                                        BorderThickness="0"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="BtnChild_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0" MinHeight="430" HorizontalAlignment="Stretch">
                            <Grid>
                                <local:AdultDentalChart x:Name="AdultChartControl" Visibility="Visible"/>
                                <local:ChildrenDentalChart x:Name="ChildChartControl" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- الوصفة الطبية -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <motion:AnimatedSection Header="الوصفة الطبية" Style="{StaticResource AnimatedSectionStyle}" Margin="0">
<Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,15">
                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="12"
                                                Background="{DynamicResource VisitGlowBoxBg}"
                                                BorderBrush="{DynamicResource VisitGlowBoxBorder}"
                                                BorderThickness="1"
                                                DockPanel.Dock="Right">
                                            <TextBlock Text="🧾" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="0,0,12,0">

                                            <TextBlock Text="أضف الأدوية والتعليمات الخاصة بالزيارة الحالية" Foreground="{DynamicResource AppTextSecondary}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Text="اسم الدواء" Style="{StaticResource FormLabel}"/>
                                    <Grid Margin="0,0,0,12">
                                        <TextBox x:Name="TxtPrescriptionMedicine" Tag="ابحث عن دواء أو اكتب دواء جديد..." Style="{StaticResource ModernTextBox}" TextChanged="TxtPrescriptionMedicine_TextChanged"/>
                                        <Popup x:Name="PopupMedicineSuggestions" PlacementTarget="{Binding ElementName=TxtPrescriptionMedicine}" Placement="Bottom" AllowsTransparency="True" IsOpen="False" StaysOpen="False" MaxHeight="200">
                                            <Border Background="{DynamicResource VisitCardBg}" BorderThickness="1" BorderBrush="{DynamicResource VisitCardBorder}" CornerRadius="10" Margin="0,4,0,0" Width="{Binding ElementName=TxtPrescriptionMedicine, Path=ActualWidth}">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.22"/>
                                                </Border.Effect>
                                                <ListBox x:Name="LstMedicineSuggestions" Background="Transparent" BorderThickness="0" SelectionChanged="LstMedicineSuggestions_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Padding="10,8" Foreground="{DynamicResource AppTextPrimary}" FontSize="14" Cursor="Hand"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border Background="{TemplateBinding Background}" Padding="0">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                </ListBox>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <TextBlock Text="آخر وصفات سريعة (سجل تلقائي)" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,0,8"/>
                                    <ItemsControl x:Name="ItemsRecentMedicines" Margin="0,0,0,12">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource FlatCardButton}" Click="BtnRecentMedicine_Click" Tag="{Binding}" Margin="0,0,8,8">
                                                    <Border Background="{DynamicResource VisitTreatmentPillBg}"
                                                            BorderBrush="{DynamicResource VisitTreatmentPillBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12,5">
                                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="{DynamicResource VisitTreatmentPillFg}"/>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="العيار" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtPrescriptionDosage" Tag="500mg" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock Text="التكرار (ساعات)" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtPrescriptionFrequency" Tag="8" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock Text="التوقيت" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CmbPrescriptionTiming" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                                <ComboBoxItem Content="بعد الطعام"/>
                                                <ComboBoxItem Content="قبل الطعام"/>
                                                <ComboBoxItem Content="عند اللزوم"/>
                                                <ComboBoxItem Content="قبل النوم"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="ملاحظات إضافية" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="TxtPrescriptionNotes" Height="78" Margin="0,0,0,15" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" Style="{StaticResource ModernTextBox}"/>

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="إضافة للوصفة" Style="{StaticResource PrimaryActionButton}" Width="150" Click="BtnAddPrescription_Click"/>
                                        <Button Grid.Column="1" Content="حذف المحدد" Style="{StaticResource SecondaryActionButton}" Width="120" Margin="10,0,0,0" Click="BtnRemovePrescription_Click"/>
                                    </Grid>

                                    <TextBlock Text="عناصر الوصفة" Style="{StaticResource FormLabel}"/>
                                    <ListBox x:Name="LstPrescriptionEntries"
                                             MinHeight="120"
                                             Background="{DynamicResource VisitSubCardBg}"
                                             BorderBrush="{DynamicResource VisitSubCardBorder}"
                                             BorderThickness="1"
                                             Foreground="{DynamicResource AppTextPrimary}"
                                             Padding="6"/>
                                </StackPanel>
                            </Border>
</motion:AnimatedSection>
                        </StackPanel>

                        <!-- المرفقات والملاحظات -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <motion:AnimatedSection Header="صور الزيارة" Style="{StaticResource AnimatedSectionStyle}" >
<Border Style="{StaticResource Card}">
                                <StackPanel>

                                    <TextBlock Text="يمكنك إرفاق حتى 5 صور للملفات أو الأشعة أو المرفقات السريرية" Foreground="{DynamicResource AppTextSecondary}" Margin="0,6,0,15"/>

                                    <Border Background="{DynamicResource VisitAccentCardBg}"
                                            BorderBrush="{DynamicResource VisitAccentCardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="18">
                                        <Grid>
                                            <Rectangle Stroke="{DynamicResource DashCalendarTodayBorder}"
                                                       StrokeThickness="1.5"
                                                       StrokeDashArray="5 4"
                                                       RadiusX="10"
                                                       RadiusY="10"/>
                                            <StackPanel Margin="12" HorizontalAlignment="Center">
                                                <TextBlock Text="اضغط لاختيار الصور من الجهاز" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Center" Margin="0,8,0,8"/>
                                                <TextBlock x:Name="TxtImageSelectionHint" Text="لا توجد صور محددة بعد" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="اختيار الصور" Style="{StaticResource PrimaryActionButton}" Width="130" Click="BtnSelectImages_Click"/>
                                                    <Button Content="مسح الكل" Style="{StaticResource SecondaryActionButton}" Width="100" Margin="10,0,0,0" Click="BtnClearImages_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="الصور المحددة" Style="{StaticResource FormLabel}" Margin="0,15,0,8"/>
                                    <ListBox x:Name="LstSelectedImages"
                                             MinHeight="120"
                                             Background="{DynamicResource VisitSubCardBg}"
                                             BorderBrush="{DynamicResource VisitSubCardBorder}"
                                             BorderThickness="1"
                                             Foreground="{DynamicResource AppTextPrimary}"
                                             Padding="6"/>
                                </StackPanel>
                            </Border>
</motion:AnimatedSection>

                            <Border Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="ملاحظات وخطة العلاج" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBlock Text="سجّل الخطة القادمة أو أي ملاحظات مهمة للطبيب" Foreground="{DynamicResource AppTextSecondary}" Margin="0,6,0,12"/>
                                    <TextBox x:Name="TxtTreatmentPlanNotes"
                                             Height="NaN"
                                             MinHeight="100"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             Padding="10"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- الشريط السفلي لحفظ الزيارة -->
        <Border motion:NavigationTransition.Motion="Toolbar" motion:NavigationTransition.Order="5" Grid.Row="2"
                Panel.ZIndex="2"
                Margin="0,10,0,0"
                CornerRadius="18"
                Background="{DynamicResource VisitCardBg}"
                BorderBrush="{DynamicResource VisitCardBorder}"
                BorderThickness="1"
                Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnSaveVisit"
                        Content="حفظ وإنهاء الزيارة"
                        Width="165"
                        Height="44"
                        Style="{StaticResource PrimaryActionButton}"
                        FontSize="15.5"
                        Margin="0,0,10,0"
                        Click="BtnSaveVisit_Click"/>

                <Button Content="إلغاء"
                        Width="105"
                        Height="44"
                        Style="{StaticResource SecondaryActionButton}"
                        FontSize="15.5"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>

        <!-- طبقة الإضاءة السطحية التفاعلية للوضع الداكن (Surface Cursor Spotlight) -->
        <Canvas x:Name="AddPatientSurfaceSpotlightCanvas"
                Grid.RowSpan="3"
                Panel.ZIndex="10"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Ellipse x:Name="AddPatientSurfaceSpotlight" CacheMode="BitmapCache"
                     Width="440"
                     Height="440"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#222DD4BF" Offset="0.0"/>
                        <GradientStop Color="#1238BDF8" Offset="0.45"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="AddPatientSurfaceSpotlightTransform" X="-1000" Y="-1000"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- بطاقة تفاصيل الزيارة الطبية (Visit Card Modal) المنسقة بالكامل مع الثيم الفاتح والداكن -->
        <Grid motion:OverlayMotion.Enabled="True" x:Name="VisitDetailsOverlay" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="25">
            <Border x:Name="VisitDetailsDimmer" Background="#B006121A" MouseLeftButtonDown="VisitDetailsDimmer_MouseLeftButtonDown"/>

            <Border x:Name="VisitDetailsModal"
                    Width="780"
                    MaxHeight="900"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource VisitModalOuterBg}"
                    CornerRadius="26"
                    BorderBrush="{DynamicResource VisitModalOuterBorder}"
                    BorderThickness="1.2"
                    ClipToBounds="True">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="VisitDetailsTranslate" Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.35"/>
                </Border.Effect>

                <Grid FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ترويسة بطاقة الزيارة بنفس ثيم بطاقة الترحيب -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource VisitBannerBg}"
                            BorderBrush="{DynamicResource VisitBannerBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="28,20,28,18">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    Background="{DynamicResource VisitModalChipBg}"
                                    BorderBrush="{DynamicResource VisitModalChipBorder}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    VerticalAlignment="Top"
                                    Click="CloseVisitDetails_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="12">
                                            <TextBlock Text="&#xE711;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="15"
                                                       Foreground="{DynamicResource VisitBannerTitleFg}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Width="52"
                                            Height="52"
                                            CornerRadius="16"
                                            Background="{DynamicResource VisitGlowBoxBg}"
                                            BorderBrush="{DynamicResource VisitGlowBoxBorder}"
                                            BorderThickness="1.5"
                                            Margin="0,0,14,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#2DD4BF"
                                                              BlurRadius="14"
                                                              ShadowDepth="0"
                                                              Opacity="{DynamicResource VisitGlowOpacity}"/>
                                        </Border.Effect>
                                        <TextBlock Text="&#xE8A5;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="22"
                                                   Foreground="{DynamicResource VisitGlowBoxFg}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="تفاصيل الزيارة الطبية"
                                                   FontFamily="Traditional Arabic"
                                                   FontSize="34"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource VisitBannerTitleFg}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding PatientName}"
                                                   FontSize="15.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource VisitBannerSubFg}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,-6,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid HorizontalAlignment="Right" Margin="0,16,0,0" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource ModalHeaderChipStyle}">
                                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource VisitGlowBoxFg}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding VisitDateTimeText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource VisitBannerTitleFg}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource ModalHeaderChipStyle}">
                                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource VisitGlowBoxFg}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DoctorName, FallbackValue='طبيب العيادة'}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource VisitBannerTitleFg}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- محتوى بطاقة الزيارة -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,8">
                        <StackPanel>

                            <!-- معلومات المريض عند وقت الزيارة -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="معلومات المريض عند وقت الزيارة" FontFamily="Traditional Arabic" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="زمرة الدم" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding BloodTypeText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{DynamicResource VisitWarningCardBg}" BorderBrush="{DynamicResource VisitWarningCardBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="الحساسية" FontSize="13.5" Foreground="{DynamicResource VisitWarningFg}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding AllergiesText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="4" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="الأمراض المزمنة" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding ChronicDiseasesText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="عادات التدخين" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding SmokingText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="الحمل والرضاعة" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding PregnancyText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- العلامات الحيوية -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="العلامات الحيوية" FontFamily="Traditional Arabic" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>

                                    <WrapPanel FlowDirection="RightToLeft">
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="ضغط الدم" Foreground="{DynamicResource AppTextSecondary}" FontSize="13"/>
                                                <TextBlock Text="{Binding BloodPressureText}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource AppTextPrimary}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="النبض" Foreground="{DynamicResource AppTextSecondary}" FontSize="13"/>
                                                <TextBlock Text="{Binding HeartRateText}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource AppTextPrimary}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="الحرارة" Foreground="{DynamicResource AppTextSecondary}" FontSize="13"/>
                                                <TextBlock Text="{Binding TemperatureText}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource AppTextPrimary}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="التنفس" Foreground="{DynamicResource AppTextSecondary}" FontSize="13"/>
                                                <TextBlock Text="{Binding RespiratoryRateText}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource AppTextPrimary}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="الوزن" Foreground="{DynamicResource AppTextSecondary}" FontSize="13"/>
                                                <TextBlock Text="{Binding WeightText}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource AppTextPrimary}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="الطول / BMI" Foreground="{DynamicResource AppTextSecondary}" FontSize="13"/>
                                                <TextBlock Text="{Binding HeightText}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource AppTextPrimary}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding BmiText}" Foreground="{DynamicResource DashCalendarTodayNumFg}" FontWeight="Bold" FontSize="13" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="سكر الدم" Foreground="{DynamicResource AppTextSecondary}" FontSize="13"/>
                                                <TextBlock Text="{Binding BloodSugarText}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource AppTextPrimary}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- شكوى المريض والتشخيص -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="شكوى المريض والتشخيص" FontFamily="Traditional Arabic" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="شكوى المريض" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}"/>
                                                <TextBlock Text="{Binding SymptomsText}" Margin="0,6,0,0" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="التشخيص" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}"/>
                                                <TextBlock Text="{Binding DiagnosisText}" Margin="0,6,0,0" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- خطة العلاج وملاحظات -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="خطة العلاج وملاحظات" FontFamily="Traditional Arabic" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="خطة العلاج" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}"/>
                                            <TextBlock Text="{Binding TreatmentPlanText}" Margin="0,6,0,0" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap"/>

                                            <StackPanel Margin="0,14,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasFinalTreatment}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="الإجراء النهائي" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding FinalTreatmentText}" Margin="0,6,0,0" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap" TextAlignment="Right"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- العلاجات المحددة (بنفس ألوان شارات التقويم في الصور) -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="العلاجات المحددة" FontFamily="Traditional Arabic" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding SelectedTreatments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10"
                                                        Padding="16,12"
                                                        CornerRadius="14"
                                                        Background="{DynamicResource VisitSubCardBg}"
                                                        BorderBrush="{DynamicResource VisitSubCardBorder}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding TreatmentName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" TextAlignment="Right"/>
                                                            <Border Background="{DynamicResource VisitTreatmentPillBg}"
                                                                    BorderBrush="{DynamicResource VisitTreatmentPillBorder}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="9"
                                                                    Padding="10,7"
                                                                    Margin="0,6,0,0">
                                                                <TextBlock Text="{Binding DetailsDisplay}"
                                                                           FontSize="13.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource VisitTreatmentPillFg}"
                                                                           TextWrapping="Wrap"
                                                                           TextAlignment="Right"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Border Grid.Column="1"
                                                                Padding="12,6"
                                                                CornerRadius="10"
                                                                Background="{DynamicResource VisitQtyPillBg}"
                                                                BorderBrush="{DynamicResource VisitQtyPillBorder}"
                                                                BorderThickness="1"
                                                                Margin="10,0,10,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource VisitQtyPillFg}">
                                                                <Run Text="×"/>
                                                                <Run Text="{Binding Quantity}"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Grid.Column="2"
                                                                Padding="12,6"
                                                                CornerRadius="10"
                                                                Background="{DynamicResource VisitCostPillBg}"
                                                                BorderBrush="{DynamicResource VisitCostPillBorder}"
                                                                BorderThickness="1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock FontSize="14" Foreground="{DynamicResource VisitCostPillFg}" FontWeight="Bold">
                                                                <Run Text="{Binding Cost, StringFormat={}{0:0.##}}"/>
                                                                <Run Text=" "/>
                                                                <Run Text="{Binding Currency}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedTreatments}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>

                                    <TextBlock Text="لا توجد علاجات محددة لهذه الزيارة." FontSize="16" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedTreatments}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- المخطط السني -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="&#xEFA9;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="المخطط السني" FontFamily="Traditional Arabic" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding DentalChartCategoryText}" Margin="0,0,0,14" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>

                                    <TextBlock Text="الأسنان المسجلة" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <ItemsControl ItemsSource="{Binding Teeth}" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource VisitToothBadgeBg}"
                                                        BorderBrush="{DynamicResource VisitToothBadgeBorder}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="12"
                                                        Padding="14,7"
                                                        Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding}" FontSize="15" Foreground="{DynamicResource VisitToothBadgeFg}" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTeeth}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>
                                    <TextBlock Text="لا توجد أسنان محددة في هذه الزيارة." Margin="0,6,0,0" Foreground="{DynamicResource AppTextSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTeeth}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- الوصفة الطبية -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="الوصفة الطبية" FontFamily="Traditional Arabic" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding PrescriptionItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding MedicineName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}"/>
                                                        <TextBlock Text="{Binding InstructionText}" Margin="0,6,0,0" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPrescriptions}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>
                                    <TextBlock Text="لا توجد أدوية مسجلة لهذه الزيارة." Margin="0,4,0,0" Foreground="{DynamicResource AppTextSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPrescriptions}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- المرفقات -->
                            <Border Style="{StaticResource DetailSectionStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="المرفقات" FontFamily="Traditional Arabic" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Text="{Binding AttachmentCountText}" Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding AttachmentItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource FlatCardButton}" Tag="{Binding}" Click="OpenVisitAttachment_Click" Margin="0,0,0,8">
                                                    <Border Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="12" Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" Margin="0,0,16,0">
                                                                <Image Source="{Binding Thumbnail}" Width="60" Height="60" Stretch="UniformToFill"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap"/>
                                                                <TextBlock Text="اضغط لفتح الملف" Margin="0,4,0,0" Foreground="{DynamicResource DashCalendarTodayNumFg}" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAttachments}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>
                                    <TextBlock Text="لا توجد صور أو مرفقات لهذه الزيارة." Margin="0,4,0,0" Foreground="{DynamicResource AppTextSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAttachments}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- تذييل بطاقة الزيارة -->
                    <Border Grid.Row="2"
                            CornerRadius="0,0,25,25"
                            Background="{DynamicResource VisitCardBg}"
                            BorderBrush="{DynamicResource VisitCardBorder}"
                            BorderThickness="0,1,0,0"
                            Padding="20,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="تعديل الزيارة"
                                    Tag="{Binding VisitId}"
                                    Click="EditVisit_Click"
                                    Style="{StaticResource PrimaryActionButton}"
                                    Margin="0,0,10,0"/>
                            <Button Content="سجل التعديل"
                                    Tag="{Binding VisitId}"
                                    Click="OpenVisitEditHistory_Click"
                                    Style="{StaticResource SecondaryActionButton}"
                                    Margin="0,0,10,0"
                                    Visibility="{Binding HasEditHistory, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="إغلاق"
                                    Width="96"
                                    Click="CloseVisitDetails_Click"
                                    Style="{StaticResource SecondaryActionButton}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
