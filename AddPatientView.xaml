                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="العلاجات المحددة" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding SelectedTreatments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10" Padding="16,12" CornerRadius="14" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding TreatmentName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" TextAlignment="Right" TextWrapping="Wrap" />
                                                            <Border Background="{DynamicResource VisitTreatmentPillBg}" BorderBrush="{DynamicResource VisitTreatmentPillBorder}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,6,0,0">
                                                                <TextBlock Text="{Binding DetailsDisplay}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource VisitTreatmentPillFg}" TextWrapping="Wrap" TextAlignment="Right" />
                                                            </Border>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Padding="12,6" CornerRadius="10" Background="{DynamicResource VisitQtyPillBg}" BorderBrush="{DynamicResource VisitQtyPillBorder}" BorderThickness="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource VisitQtyPillFg}">
                                                                <Run Text="×" />
                                                                <Run Text="{Binding Quantity}" />
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Grid.Column="2" Padding="12,6" CornerRadius="10" Background="{DynamicResource VisitCostPillBg}" BorderBrush="{DynamicResource VisitCostPillBorder}" BorderThickness="1" VerticalAlignment="Center">
                                                            <TextBlock FontSize="14" Foreground="{DynamicResource VisitCostPillFg}" FontWeight="Bold">
                                                                <Run Text="{Binding Cost, StringFormat={}{0:0.##}}" />
                                                                <Run Text=" " />
                                                                <Run Text="{Binding Currency}" />
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedTreatments}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>
                                    <TextBlock Text="لا توجد علاجات محددة لهذه الزيارة." FontSize="16" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedTreatments}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="المخطط السني" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DentalChartCategoryText}" Margin="0,0,0,14" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold" />
                                    <TextBlock Text="الأسنان المسجلة" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" />
                                    <ItemsControl ItemsSource="{Binding Teeth}" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource VisitToothBadgeBg}" BorderBrush="{DynamicResource VisitToothBadgeBorder}" BorderThickness="1.5" CornerRadius="12" Padding="14,7" Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding}" FontSize="15" Foreground="{DynamicResource VisitToothBadgeFg}" FontWeight="Bold" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTeeth}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>
                                    <TextBlock Text="لا توجد أسنان محددة في هذه الزيارة." Margin="0,6,0,0" Foreground="{DynamicResource AppTextSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTeeth}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="الوصفة الطبية" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding PrescriptionItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding MedicineName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}" />
                                                        <TextBlock Text="{Binding InstructionText}" Margin="0,6,0,0" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPrescriptions}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>
                                    <TextBlock Text="لا توجد أدوية مسجلة لهذه الزيارة." Margin="0,4,0,0" Foreground="{DynamicResource AppTextSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPrescriptions}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DetailSectionStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="المرفقات" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" />
                                        <TextBlock Text="{Binding AttachmentCountText}" Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding AttachmentItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource FlatCardButton}" Tag="{Binding}" Click="OpenVisitAttachment_Click" Margin="0,0,0,8">
                                                    <Border Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="12" Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" Margin="0,0,16,0">
                                                                <Image Source="{Binding Thumbnail}" Width="60" Height="60" Stretch="UniformToFill" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap" />
                                                                <TextBlock Text="اضغط لفتح الملف" Margin="0,4,0,0" Foreground="{DynamicResource DashCalendarTodayNumFg}" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAttachments}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>
                                    <TextBlock Text="لا توجد صور أو مرفقات لهذه الزيارة." Margin="0,4,0,0" Foreground="{DynamicResource AppTextSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAttachments}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" CornerRadius="0,0,25,25" Background="{DynamicResource VisitCardBg}" BorderBrush="{DynamicResource VisitCardBorder}" BorderThickness="0,1,0,0" Padding="20,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="تعديل الزيارة" Tag="{Binding VisitId}" Click="EditVisit_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,0" />
                            <Button Content="سجل التعديل" Tag="{Binding VisitId}" Click="OpenVisitEditHistory_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,10,0" Visibility="{Binding HasEditHistory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="إغلاق" Width="96" Click="CloseVisitDetails_Click" Style="{StaticResource SecondaryActionButton}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>