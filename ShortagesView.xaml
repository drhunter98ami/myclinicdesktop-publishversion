<UserControl x:Class="MyClinic.ShortagesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MyClinic" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" Background="Transparent">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspaceStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="ShortageRow">
   <Border Style="{StaticResource WorkspaceCard}" Padding="12" Margin="0,0,0,8">
    <StackPanel>
     <TextBlock Text="{Binding Item}" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding PriceText}" Style="{StaticResource WorkspaceHint}" FlowDirection="LeftToRight" TextAlignment="Right" Margin="0,4,0,10"/>
     <WrapPanel>
      <Button Content="تسجيل شراء" Style="{StaticResource WorkspacePrimary}" Click="Purchase_Click" Margin="0,0,0,4"/>
      <Button Content="تعديل" Style="{StaticResource WorkspaceButton}" Click="Edit_Click" Margin="6,0,0,4"/>
      <Button Content="حذف" Style="{StaticResource WorkspaceButton}" Click="Delete_Click" Margin="6,0,0,4" Foreground="{DynamicResource WorkspaceDanger}"/>
     </WrapPanel>
    </StackPanel>
   </Border>
  </DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="20">
   <Border Style="{StaticResource WorkspaceCard}" local:NavigationTransition.Motion="Header" Margin="0,0,0,14">
    <StackPanel><TextBlock Text="النواقص" Style="{StaticResource WorkspaceHeading}" FontSize="28"/>
     <TextBlock Text="خطّط للمشتريات وسجّل الكمية الفعلية والمصروف عند الشراء." Style="{StaticResource WorkspaceHint}" Margin="0,5,0,0"/>
     <TextBlock x:Name="Counts" Style="{StaticResource WorkspaceHint}" Margin="0,6,0,0"/>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource WorkspaceCard}" local:NavigationTransition.Motion="Toolbar" Margin="0,0,0,14">
    <StackPanel><TextBlock x:Name="FormTitle" Text="إضافة مادة" Style="{StaticResource WorkspaceHeading}" Margin="0,0,0,12"/>
     <WrapPanel>
      <StackPanel Width="210" Margin="0,0,0,10"><TextBlock Text="الصنف" Style="{StaticResource WorkspaceLabel}"/><TextBox x:Name="ItemName" Style="{StaticResource WorkspaceInput}" AutomationProperties.Name="اسم الصنف" TextChanged="Form_Changed"/></StackPanel>
      <StackPanel Width="112" Margin="10,0,0,10"><TextBlock Text="سعر الوحدة" Style="{StaticResource WorkspaceLabel}"/><TextBox x:Name="UnitPrice" Style="{StaticResource WorkspaceInput}" FlowDirection="LeftToRight" TextChanged="Form_Changed"/></StackPanel>
      <StackPanel Width="76" Margin="10,0,0,10"><TextBlock Text="الكمية" Style="{StaticResource WorkspaceLabel}"/><TextBox x:Name="Quantity" Text="1" Style="{StaticResource WorkspaceInput}" FlowDirection="LeftToRight" TextChanged="Form_Changed"/></StackPanel>
      <StackPanel Width="92" Margin="10,0,0,10"><TextBlock Text="العملة" Style="{StaticResource WorkspaceLabel}"/><ComboBox x:Name="Currency" Style="{StaticResource WorkspaceCombo}" SelectionChanged="Form_Changed"/></StackPanel>
      <StackPanel Width="140" Margin="10,0,0,10"><TextBlock Text="الأولوية" Style="{StaticResource WorkspaceLabel}"/><ComboBox x:Name="Priority" Style="{StaticResource WorkspaceCombo}"/></StackPanel>
     </WrapPanel>
     <WrapPanel VerticalAlignment="Center">
      <CheckBox x:Name="UnknownPrice" Content="السعر غير معروف" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" Checked="Form_Changed" Unchecked="Form_Changed" Margin="0,0,0,8"/>
      <TextBlock x:Name="PreviewTotal" Style="{StaticResource WorkspaceHint}" Margin="16,0,0,8" VerticalAlignment="Center"/>
      <Button x:Name="SaveItem" Content="إضافة مادة" Style="{StaticResource WorkspacePrimary}" Click="Save_Click" Margin="16,0,0,8"/>
      <Button x:Name="CancelEdit" Content="إلغاء التعديل" Style="{StaticResource WorkspaceButton}" Visibility="Collapsed" Click="CancelEdit_Click" Margin="8,0,0,8"/>
     </WrapPanel>
    </StackPanel>
   </Border>
   <WrapPanel Margin="0,0,0,12">
    <Button x:Name="PendingButton" Content="النواقص الحالية" Style="{StaticResource WorkspaceButton}" Click="Pending_Click" Margin="0,0,0,8"/>
    <Button x:Name="HistoryButton" Content="سجل المشتريات" Style="{StaticResource WorkspaceButton}" Click="History_Click" Margin="8,0,0,8"/>
    <StackPanel Width="220" Margin="14,0,0,8"><TextBlock Text="البحث بالصنف" Style="{StaticResource WorkspaceLabel}"/><TextBox x:Name="Search" Style="{StaticResource WorkspaceInput}" TextChanged="Filter_Changed"/></StackPanel>
    <StackPanel Width="160" Margin="10,0,0,8"><TextBlock Text="الترتيب" Style="{StaticResource WorkspaceLabel}"/><ComboBox x:Name="Sort" Style="{StaticResource WorkspaceCombo}" SelectionChanged="Filter_Changed"/></StackPanel>
   </WrapPanel>
   <Grid x:Name="Groups" SizeChanged="Groups_SizeChanged">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="UrgentCard" Style="{StaticResource WorkspaceCard}" local:NavigationTransition.Motion="Content">
     <StackPanel><TextBlock x:Name="UrgentTitle" Text="نواقص مستعجلة" Style="{StaticResource WorkspaceHeading}" Foreground="{DynamicResource WorkspaceWarning}"/>
      <TextBlock x:Name="UrgentEmpty" Text="لا توجد نواقص مستعجلة. أضف مادة من النموذج أعلاه." Style="{StaticResource WorkspaceHint}" Margin="0,14,0,14"/>
      <ListBox x:Name="UrgentList" ItemTemplate="{StaticResource ShortageRow}" Background="Transparent" BorderThickness="0" MaxHeight="440" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0"/>
      <TextBlock x:Name="UrgentTotal" FlowDirection="LeftToRight" TextAlignment="Right" Style="{StaticResource WorkspaceHint}" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
    <Border x:Name="NormalCard" Grid.Column="2" Style="{StaticResource WorkspaceCard}" local:NavigationTransition.Motion="Content">
     <StackPanel><TextBlock x:Name="NormalTitle" Text="نواقص غير مستعجلة" Style="{StaticResource WorkspaceHeading}"/>
      <TextBlock x:Name="NormalEmpty" Text="لا توجد نواقص غير مستعجلة. أضف مادة من النموذج أعلاه." Style="{StaticResource WorkspaceHint}" Margin="0,14,0,14"/>
      <ListBox x:Name="NormalList" ItemTemplate="{StaticResource ShortageRow}" Background="Transparent" BorderThickness="0" MaxHeight="440" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0"/>
      <TextBlock x:Name="NormalTotal" FlowDirection="LeftToRight" TextAlignment="Right" Style="{StaticResource WorkspaceHint}" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
   <Border x:Name="HistoryCard" Style="{StaticResource WorkspaceCard}" Visibility="Collapsed">
    <StackPanel><TextBlock Text="سجل المشتريات · القيم وسعر الصرف محفوظة وقت الشراء" Style="{StaticResource WorkspaceHint}" Margin="0,0,0,12"/>
     <TextBlock x:Name="HistoryEmpty" Text="لا توجد مشتريات تطابق البحث." Style="{StaticResource WorkspaceHint}"/>
     <DataGrid x:Name="HistoryGrid" Style="{StaticResource WorkspaceGrid}" MaxHeight="440">
      <DataGrid.Columns>
       <DataGridTextColumn Header="الصنف" Binding="{Binding Description}" Width="*" MinWidth="170"/>
       <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="70"/>
       <DataGridTextColumn Header="القيمة" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
       <DataGridTextColumn Header="العملة" Binding="{Binding Currency}" Width="70"/>
       <DataGridTextColumn Header="التاريخ" Binding="{Binding OccurredAt, StringFormat=dd/MM/yyyy}" Width="110"/>
       <DataGridTemplateColumn Header="المصروف" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="عرض المصروف" Style="{StaticResource WorkspaceButton}" Click="Expense_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </StackPanel>
   </Border>
   <WrapPanel Margin="0,14,0,0"><TextBlock x:Name="Status" Style="{StaticResource WorkspaceHint}" VerticalAlignment="Center"/>
    <Button x:Name="UndoButton" Content="تراجع عن الحذف" Visibility="Collapsed" Click="Undo_Click" Style="{StaticResource WorkspaceButton}" Margin="10,0,0,0"/>
    <Button Content="تحديث" Click="Refresh_Click" Style="{StaticResource WorkspaceButton}" Margin="10,0,0,0"/>
   </WrapPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>
