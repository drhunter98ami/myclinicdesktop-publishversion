<UserControl x:Class="MyClinic.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:MyClinic"
             FlowDirection="RightToLeft"
             Background="Transparent"
             FontFamily="Segoe UI"
             PreviewMouseMove="Dashboard_PreviewMouseMove"
             MouseLeave="Dashboard_MouseLeave">

    <UserControl.Resources>
        <!-- ============================================== -->
        <!-- أنماط شريط التمرير والحقول والقوائم المنسدلة والتقويم -->
        <!-- ============================================== -->

        <!-- شريط التمرير (ScrollBar) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Margin="2,0,2,0">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{DynamicResource AppBorder}" CornerRadius="4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Margin="0,2,0,0">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{DynamicResource AppBorder}" CornerRadius="4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- مؤشر الكتابة وحقول النص القابلة للتعديل -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- النمط الشامل لـ ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Background="{TemplateBinding Background}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="Transparent">
                                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Margin="8,0,28,0"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center"
                                     Focusable="True"
                                     Background="Transparent"
                                     Foreground="{DynamicResource AppTextPrimary}"
                                     CaretBrush="{DynamicResource AppTextPrimary}"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     BorderThickness="0"
                                     TextAlignment="Right"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource AppCardBg}" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}" CornerRadius="10" Margin="0,4,0,8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- عناصر القائمة المنسدلة (ComboBox Item) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="2">
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2214B8A6"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- نافذة التقويم العامة (Calendar) -->
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- صندوق نص التقويم (DatePicker TextBox) -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- أزرار أيام التقويم (Calendar Day Buttons) -->
        <Style TargetType="CalendarDayButton">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DashActiveFilterBg}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- أزرار أشهر/سنوات التقويم -->
        <Style TargetType="CalendarButton">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================== -->
        <!-- أنماط الأزرار والنصوص العامة -->
        <!-- ============================================== -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RangeButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="IconTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="DashboardRootGrid" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- طبقة الإضاءة الخلفية التفاعلية للوضع الداكن (Behind Cards Spotlight) -->
        <Canvas x:Name="DashboardBackSpotlightCanvas"
                Grid.RowSpan="2"
                Panel.ZIndex="0"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Ellipse x:Name="DashboardBackSpotlight" CacheMode="BitmapCache"
                     Width="620"
                     Height="620"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#4514B8A6" Offset="0.0"/>
                        <GradientStop Color="#220EA5E9" Offset="0.42"/>
                        <GradientStop Color="#0C2DD4BF" Offset="0.72"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="DashboardBackSpotlightTransform" X="-1000" Y="-1000"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- الصف العلوي: 3 بطاقات منفصلة (الترحيب | عداد الفايلات | أزرار الإضافة) -->
        <Grid motion:NavigationTransition.Motion="Cards" motion:NavigationTransition.Order="0" Grid.Row="0" Panel.ZIndex="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="222"/>
                <ColumnDefinition Width="1.02*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. بطاقة الترحيب (يمين) -->
            <Border x:Name="WelcomeCardBorder"
                    Grid.Column="0"
                    Background="{DynamicResource DashWelcomeCardBg}"
                    BorderBrush="{DynamicResource DashWelcomeCardBorder}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Margin="0,0,14,0"
                    MinHeight="132"
                    ClipToBounds="True">
                <Grid>
                    <!-- إضاءة قطرية ناعمة في الوضع الداكن -->
                    <Ellipse x:Name="WelcomeDarkGlow"
                             Width="320"
                             Height="220"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Margin="0,-80,0,0"
                             IsHitTestVisible="False"
                             Visibility="Collapsed">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#355EEAD4" Offset="0"/>
                                <GradientStop Color="#005EEAD4" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- رسمة السن المائية في الخلفية -->
                    <Viewbox Width="138"
                             Height="138"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,175,0"
                             IsHitTestVisible="False">
                        <Canvas Width="120" Height="120">
                            <Path Stroke="{DynamicResource DashWelcomeToothBrush}"
                                  StrokeThickness="5.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M60,24 C47,12 24,16 22,38 C20,56 30,68 33,88 C35,103 42,108 47,96 C51,85 55,78 60,78 C65,78 69,85 73,96 C78,108 85,103 87,88 C90,68 100,56 98,38 C96,16 73,12 60,24 Z"/>
                            <Path Stroke="{DynamicResource DashWelcomeToothBrush}"
                                  StrokeThickness="3.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M43,36 C52,43 68,43 77,36"/>
                        </Canvas>
                    </Viewbox>

                    <StackPanel VerticalAlignment="Center" Margin="28,20,28,20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtWelcome"
                                       Text="أهلاً د. احمد"
                                       Foreground="{DynamicResource DashWelcomeTitleFg}"
                                       FontSize="31"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <!-- أيقونة اليد للوضع الفاتح -->
                            <TextBlock x:Name="TxtWelcomeWave"
                                       Text="👋"
                                       FontSize="28"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                            <!-- أيقونة النجوم المضيئة للوضع الداكن -->
                            <Viewbox x:Name="IconWelcomeSparkles"
                                     Width="30"
                                     Height="30"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed">
                                <Canvas Width="32" Height="32">
                                    <Path Stroke="#38BDF8" StrokeThickness="1.8" Fill="#2238BDF8" StrokeLineJoin="Round"
                                          Data="M18,3 L20.5,11.5 L29,14 L20.5,16.5 L18,25 L15.5,16.5 L7,14 L15.5,11.5 Z"/>
                                    <Path Stroke="#5EEAD4" StrokeThickness="1.5" StrokeLineJoin="Round"
                                          Data="M7,4 L8,7.5 L11.5,8.5 L8,9.5 L7,13 L6,9.5 L2.5,8.5 L6,7.5 Z"/>
                                    <Path Stroke="#5EEAD4" StrokeThickness="1.5" StrokeLineJoin="Round"
                                          Data="M8,20 L8.8,22.7 L11.5,23.5 L8.8,24.3 L8,27 L7.2,24.3 L4.5,23.5 L7.2,22.7 Z"/>
                                </Canvas>
                            </Viewbox>
                        </StackPanel>
                        <TextBlock Text="رتب المواعيد القادمة بسرعة واحفظ بيانات المراجعين في مكان واحد."
                                   Foreground="{DynamicResource DashWelcomeSubFg}"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. بطاقة عداد كيت الفايلات (الوسط) -->
            <Border x:Name="CanalCardBorder"
                    Grid.Column="1"
                    Background="{DynamicResource DashCanalCardBg}"
                    BorderBrush="{DynamicResource DashCanalCardBorder}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Margin="0,0,14,0"
                    Padding="18,16"
                    MinHeight="132">
                <Grid VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="عدد القنوات التي تم إنجازها بنفس كيت الفايلات"
                               Foreground="{DynamicResource DashCanalTitleFg}"
                               FontSize="13"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               TextAlignment="Right"
                               LineHeight="19"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                FlowDirection="LeftToRight"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Border x:Name="CanalCountBoxBorder"
                                Background="{DynamicResource DashCanalBoxBg}"
                                BorderBrush="{DynamicResource DashCanalBoxBorder}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Height="40"
                                Width="82">
                            <Border.Effect>
                                <DropShadowEffect Color="#2DD4BF"
                                                  BlurRadius="16"
                                                  ShadowDepth="0"
                                                  Opacity="{DynamicResource DashCanalBoxGlowOpacity}"/>
                            </Border.Effect>
                            <TextBox x:Name="TxtFileKitCanalCount"
                                     Text="3"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource DashCanalBoxFg}"
                                     FontSize="19"
                                     FontWeight="Bold"
                                     MaxLength="4"
                                     TextChanged="TxtFileKitCanalCount_TextChanged"
                                     PreviewMouseLeftButtonDown="TxtFileKitCanalCount_PreviewMouseLeftButtonDown"/>
                        </Border>
                        <Button x:Name="BtnResetFileKitCanalCount"
                                Content="↻"
                                Width="40"
                                Height="40"
                                Margin="8,0,0,0"
                                Padding="0"
                                FontSize="17"
                                FontWeight="Bold"
                                ToolTip="تصفير العداد عند شراء كيت جديد"
                                Click="BtnResetFileKitCanalCount_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="{DynamicResource DashCanalResetBg}"
                                BorderBrush="{DynamicResource DashCanalResetBorder}"
                                BorderThickness="1"
                                Foreground="{DynamicResource DashCanalResetFg}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               x:Name="TxtFileKitWarning"
                               Text="انتهت صلاحية كيت الفايلات، يرجى تغييرها"
                               Foreground="#EF4444"
                               FontSize="11.5"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               TextAlignment="Right"
                               Margin="0,6,0,0"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 3. بطاقة الإجراءات السريعة (يسار) -->
            <Border x:Name="ActionsCardBorder"
                    Grid.Column="2"
                    Background="{DynamicResource DashActionsCardBg}"
                    BorderBrush="{DynamicResource DashActionsCardBorder}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="16,20"
                    MinHeight="132">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnAddPatient"
                            Grid.Column="0"
                            Height="44"
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="BtnAddPatient_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox x:Name="IconAddPatient" Width="16" Height="16" Margin="0,0,6,0" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M16,21 V19 A4,4 0 0 0 12,15 H5 A4,4 0 0 0 1,19 V21 M8.5,11 A4,4 0 1 0 8.5,3 A4,4 0 0 0 8.5,11 Z M20,8 V14 M23,11 H17"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtAddPatientBtn" Text="+ إضافة مريض" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnAddAppointment"
                            Grid.Column="2"
                            Height="44"
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="BtnAddAppointment_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox x:Name="IconAddAppointment" Width="16" Height="16" Margin="0,0,6,0" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M19,4 H5 A2,2 0 0 0 3,6 V20 A2,2 0 0 0 5,22 H19 A2,2 0 0 0 21,20 V6 A2,2 0 0 0 19,4 Z M16,2 V6 M8,2 V6 M3,10 H21 M12,14 V18 M10,16 H14"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtAddAppointmentBtn" Text="+ إضافة موعد جديد" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- المحتوى الرئيسي (المواعيد والتقويم) -->
        <Border Grid.Row="1"
                Panel.ZIndex="2"
                Background="{DynamicResource DashMainCardBg}"
                CornerRadius="20"
                Padding="24,18,24,16"
                BorderBrush="{DynamicResource DashMainCardBorder}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- شريط البحث والفلاتر -->
                <Grid motion:NavigationTransition.Motion="Toolbar" motion:NavigationTransition.Order="2" Grid.Row="0" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- الصف الأول: عنوان المواعيد (يمين) وحقل البحث (يسار) -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="المواعيد" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,3"/>
                            <TextBlock Text="بطاقات المواعيد تعرض الاسم، الهاتف، السبب، وتوقيت الحجز." FontSize="13" Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource DashFilterGroupBg}"
                                BorderBrush="{DynamicResource DashFilterGroupBorder}"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="5"
                                VerticalAlignment="Center"
                                Panel.ZIndex="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource AppCardBg}"
                                        BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="4,0">
                                    <Grid>
                                        <TextBox x:Name="TxtAppointmentsSearch"
                                                 Width="236"
                                                 Height="34"
                                                 Foreground="{DynamicResource AppTextPrimary}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 Padding="6,0"
                                                 TextChanged="AppointmentsSearch_TextChanged"/>
                                        <TextBlock Text="بحث عن موعد مريض"
                                                   Margin="12,0,12,0"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource AppTextSecondary}"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtAppointmentsSearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Border x:Name="AppointmentsSearchSuggestionsPanel"
                                        Grid.Row="1"
                                        Margin="0,5,0,0"
                                        MaxHeight="210"
                                        Background="{DynamicResource AppCardBg}"
                                        BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Visibility="Collapsed">
                                    <ScrollViewer motion:ScrollState.Enabled="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="AppointmentsSearchSuggestions">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding}"
                                                            Content="{Binding}"
                                                            Click="AppointmentSearchSuggestion_Click"
                                                            HorizontalContentAlignment="Right"
                                                            Padding="10,8"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource AppTextPrimary}"
                                                            BorderThickness="0"
                                                            Cursor="Hand"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- الصف الثاني: أزرار التصفية والتاريخ ونوع العرض -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                FlowDirection="RightToLeft"
                                HorizontalAlignment="Left"
                                Margin="215,0,0,0">
                        <!-- مجموعة القادمة / السابقة / الكل -->
                        <Border Background="{DynamicResource DashFilterGroupBg}"
                                BorderBrush="{DynamicResource DashFilterGroupBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="4"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnFilterUpcoming" Content="القادمة" Style="{StaticResource RangeButtonStyle}" Width="72" Click="BtnFilterUpcoming_Click"/>
                                <Button x:Name="BtnFilterPast" Content="السابقة" Style="{StaticResource RangeButtonStyle}" Width="72" Click="BtnFilterPast_Click"/>
                                <Button x:Name="BtnFilterAll" Content="الكل" Style="{StaticResource RangeButtonStyle}" Width="58" Click="BtnFilterAll_Click"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnCurrentDate"
                                Content="الشهر الحالي"
                                Height="42"
                                Padding="14,0"
                                Background="#2214B8A6"
                                Foreground="{DynamicResource AppTextPrimary}"
                                FontWeight="Bold"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                Click="BtnCurrentDate_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource DashFilterGroupBorder}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- منتقي التاريخ -->
                        <Border BorderBrush="{DynamicResource DashFilterGroupBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Background="{DynamicResource DashFilterGroupBg}"
                                Padding="8,4"
                                Margin="0,0,10,0">
                            <DatePicker x:Name="DpAppointmentsFilter"
                                        Width="136"
                                        Height="34"
                                        Foreground="{DynamicResource AppTextPrimary}"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        VerticalContentAlignment="Center"
                                        SelectedDateChanged="DpAppointmentsFilter_SelectedDateChanged"
                                        CalendarOpened="DpAppointmentsFilter_CalendarOpened"
                                        CalendarClosed="DpAppointmentsFilter_CalendarClosed"/>
                        </Border>

                        <!-- مجموعة شهري / يومي -->
                        <Border Background="{DynamicResource DashFilterGroupBg}"
                                BorderBrush="{DynamicResource DashFilterGroupBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnMonthlyView" Content="شهري" Style="{StaticResource RangeButtonStyle}" Width="66" Click="BtnMonthlyView_Click"/>
                                <Border Width="1" Height="18" Background="{DynamicResource AppBorder}" VerticalAlignment="Center" Margin="2,0"/>
                                <Button x:Name="BtnDailyView" Content="يومي" Style="{StaticResource RangeButtonStyle}" Width="66" Click="BtnDailyView_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- شبكة البطاقات والتقويم الشهري -->
                <Grid motion:NavigationTransition.Motion="Content" motion:NavigationTransition.Order="3" Grid.Row="1">
                    <!-- العرض اليومي -->
                    <ScrollViewer motion:ScrollState.Enabled="True" x:Name="DailyAppointmentsPanel" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl motion:NavigationTransition.Motion="Items" motion:NavigationTransition.Order="4" x:Name="AppointmentsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,12,12" Padding="16" CornerRadius="18" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Background="{DynamicResource AppCardBg}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Right">
                                                        <TextBlock motion:SearchAssist.Text="{Binding PatientName}" FontFamily="Traditional Arabic" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock motion:SearchAssist.Text="{Binding PhoneNumber}" motion:SearchAssist.Kind="Phone" Margin="0,-4,0,0" FontSize="12" Foreground="{DynamicResource AppTextSecondary}" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Padding="8,5" CornerRadius="9" Background="{Binding ReasonBackground}" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Reason}" Foreground="{Binding ReasonForeground}" FontWeight="Bold" FontSize="12"/>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Content="حذف"
                                                            Tag="{Binding AppointmentId}"
                                                            Click="BtnDeleteAppointment_Click"
                                                            Background="#FEF2F2"
                                                            Foreground="#DC2626"
                                                            BorderBrush="#FECACA"
                                                            BorderThickness="1"
                                                            Padding="9,5"
                                                            Margin="8,0,0,0"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Cursor="Hand"
                                                            ToolTip="حذف الموعد">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="8"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>

                                                <Border Grid.Row="1" Background="{DynamicResource AppInputBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#14B8A6" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding AppointmentDateText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" TextAlignment="Right"/>
                                                            <TextBlock Text="{Binding AppointmentTimeText}" FontSize="12" Foreground="{DynamicResource AppTextSecondary}" TextAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Border Grid.Row="2" Background="{DynamicResource AppInputBg}" CornerRadius="12" Padding="10" Margin="0,0,0,10">
                                                    <StackPanel HorizontalAlignment="Right">
                                                        <TextBlock Text="سبب الموعد" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextAlignment="Right"/>
                                                        <TextBlock Text="{Binding Reason}" Margin="0,4,0,0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" TextAlignment="Right"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Row="3" Padding="8,5" CornerRadius="8" HorizontalAlignment="Right">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowAttendanceStatus}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding AttendanceStatus}" Value="Attended">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding AttendanceStatus}" Value="Absent">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding AttendanceStatus}" Value="Waiting">
                                                                    <Setter Property="Background" Value="#FEF9C3"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding AttendanceStatusText}" FontSize="12" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AttendanceStatus}" Value="Absent">
                                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding AttendanceStatus}" Value="Waiting">
                                                                        <Setter Property="Foreground" Value="#A16207"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel x:Name="EmptyAppointmentsState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0">
                                <Border Width="74" Height="74" CornerRadius="37" Background="{DynamicResource AppInputBg}" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="لا توجد مواعيد مطابقة للبحث أو التاريخ المحدد" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                                <TextBlock Text="أضف موعداً جديداً أو قم بتغيير فلاتر البحث والوقت." FontSize="14" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- التقويم الشهري -->
                    <Grid x:Name="MonthlyCalendarPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- شريط التنقل بين الأشهر -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="&#x2039;"
                                    Width="38"
                                    Height="36"
                                    Style="{StaticResource RoundedButtonStyle}"
                                    Background="{DynamicResource DashFilterGroupBg}"
                                    Foreground="{DynamicResource AppTextPrimary}"
                                    BorderBrush="{DynamicResource DashFilterGroupBorder}"
                                    BorderThickness="1"
                                    FontSize="22"
                                    Click="BtnCalendarPreviousMonth_Click"
                                    ToolTip="الشهر السابق"/>
                            <TextBlock x:Name="CalendarMonthLabel"
                                       Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimary}"/>
                            <Button Grid.Column="2"
                                    Content="&#x203A;"
                                    Width="38"
                                    Height="36"
                                    Style="{StaticResource RoundedButtonStyle}"
                                    Background="{DynamicResource DashFilterGroupBg}"
                                    Foreground="{DynamicResource AppTextPrimary}"
                                    BorderBrush="{DynamicResource DashFilterGroupBorder}"
                                    BorderThickness="1"
                                    FontSize="22"
                                    Click="BtnCalendarNextMonth_Click"
                                    ToolTip="الشهر التالي"/>
                        </Grid>

                        <!-- ترويسة أيام الأسبوع (من اليسار إلى اليمين: الأحد .. السبت كما في الصور) -->
                        <Grid Grid.Row="1" x:Name="CalendarWeekHeader" FlowDirection="LeftToRight" Margin="10,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الأحد" HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Grid.Column="1" Text="الإثنين" HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Grid.Column="2" Text="الثلاثاء" HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Grid.Column="3" Text="الأربعاء" HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Grid.Column="4" Text="الخميس" HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Grid.Column="5" Text="الجمعة" HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Grid.Column="6" Text="السبت" HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>
                        </Grid>

                        <ScrollViewer motion:ScrollState.Enabled="True" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="CalendarDaysGrid" FlowDirection="LeftToRight" Margin="6,0,0,0"/>
                        </ScrollViewer>
                    </Grid>

                    <Border x:Name="LoadingOverlay" Background="#A00F172A" Visibility="Collapsed">
                        <Border Width="260" Height="120" Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="جارٍ تحميل المواعيد" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Center"/>
                                <ProgressBar Width="180" Height="8" Margin="0,18,0,0" IsIndeterminate="True" Foreground="#14B8A6" Background="{DynamicResource AppInputBg}"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- طبقة الإضاءة السطحية التفاعلية للوضع الداكن (Surface Cursor Spotlight) -->
        <Canvas x:Name="DashboardSurfaceSpotlightCanvas"
                Grid.RowSpan="2"
                Panel.ZIndex="10"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Ellipse x:Name="DashboardSurfaceSpotlight" CacheMode="BitmapCache"
                     Width="440"
                     Height="440"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#222DD4BF" Offset="0.0"/>
                        <GradientStop Color="#1238BDF8" Offset="0.45"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="DashboardSurfaceSpotlightTransform" X="-1000" Y="-1000"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- تفاصيل اليوم المحدد -->
        <Grid x:Name="DayDetailsOverlay" Grid.RowSpan="2" Panel.ZIndex="25" Visibility="Collapsed">
            <Border Background="#A00F172A" MouseLeftButtonDown="DayDetailsBackdrop_MouseLeftButtonDown"/>
            <Border Width="720" MaxHeight="640" Padding="28" Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Width="38" Height="38" Background="{DynamicResource AppInputBg}" BorderThickness="0" Click="BtnCloseDayDetails_Click" Cursor="Hand">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="مواعيد اليوم" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtDayDetailsDate" FontSize="14" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="10" MinHeight="180">
                        <Grid>
                            <ScrollViewer motion:ScrollState.Enabled="True" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DayDetailsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="16,14" Margin="0,0,0,8" Background="{DynamicResource AppInputBg}" CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayTime}" FontSize="16" FontWeight="Bold" Foreground="#14B8A6" Margin="0,0,18,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Reason}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding PatientName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding PhoneNumber}" FontSize="14" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                        <Border Padding="7,4" CornerRadius="7" HorizontalAlignment="Right" Margin="0,5,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowAttendanceStatus}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding AttendanceStatus}" Value="Attended">
                                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding AttendanceStatus}" Value="Absent">
                                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding AttendanceStatus}" Value="Waiting">
                                                                            <Setter Property="Background" Value="#FEF9C3"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding AttendanceStatusText}" FontSize="12" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding AttendanceStatus}" Value="Absent">
                                                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding AttendanceStatus}" Value="Waiting">
                                                                                <Setter Property="Foreground" Value="#A16207"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="حذف الموعد" Tag="{Binding Id}" Width="104" Height="36" Margin="16,0,0,0" Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnDeleteAppointmentFromDay_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVisitRecord}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="TxtDayDetailsEmpty" Text="لا توجد مواعيد في هذا اليوم." FontSize="16" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,18,0,0">
                        <Button Content="إضافة موعد لهذا اليوم" Width="190" Height="44" Background="{DynamicResource DashActiveFilterBg}" Foreground="White" BorderThickness="0" Style="{StaticResource RoundedButtonStyle}" Click="BtnAddAppointmentForDay_Click"/>
                        <Button Content="إغلاق" Width="100" Height="44" Margin="12,0,0,0" Background="{DynamicResource AppInputBg}" Foreground="{DynamicResource AppTextPrimary}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Style="{StaticResource RoundedButtonStyle}" Click="BtnCloseDayDetails_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- نافذة إضافة موعد جديد -->
        <Grid x:Name="AppointmentDialogOverlay" Grid.RowSpan="2" Panel.ZIndex="20" Visibility="Collapsed">
            <Border Background="#A00F172A" MouseLeftButtonDown="AppointmentDialogBackdrop_MouseLeftButtonDown"/>

            <Border Width="560" Padding="32" Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="40" ShadowDepth="10" Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- رأس النافذة -->
                    <Grid Grid.Row="0" Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- زر الإغلاق -->
                        <Button Grid.Column="0" Width="36" Height="36" Background="{DynamicResource AppInputBg}" BorderThickness="0" Click="BtnCloseAppointmentDialog_Click" Cursor="Hand">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="إضافة موعد جديد" FontFamily="Traditional Arabic" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,10,0"/>
                                <Border Width="38" Height="38" Background="#2214B8A6" CornerRadius="12">
                                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#14B8A6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="أدخل بيانات المريض والوقت لتسجيل الموعد في الجدول." Margin="0,-2,0,0" FontSize="14" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- الصف الأول -->
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="اسم المريض" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Background="{DynamicResource AppInputBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="4,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconTextStyle}" Text="&#xE77B;"/>
                                    <ComboBox x:Name="CmbAppointmentPatientName"
                                              Height="44" Padding="8,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppTextPrimary}"
                                              VerticalContentAlignment="Center" IsEditable="True" IsTextSearchEnabled="False"
                                              TextBoxBase.TextChanged="CmbAppointmentPatientName_TextChanged"
                                              SelectionChanged="CmbAppointmentPatientName_SelectionChanged"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="رقم الهاتف" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Background="{DynamicResource AppInputBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="4,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconTextStyle}" Text="&#xE717;" FontSize="15"/>
                                    <ComboBox x:Name="CmbAppointmentPhoneNumber"
                                              Height="44" Padding="8,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppTextPrimary}"
                                              VerticalContentAlignment="Center" IsEditable="True" IsTextSearchEnabled="False"
                                              TextBoxBase.TextChanged="CmbAppointmentPhoneNumber_TextChanged"
                                              SelectionChanged="CmbAppointmentPhoneNumber_SelectionChanged"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- الصف الثاني -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,20">
                        <TextBlock Text="سبب الزيارة" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Background="{DynamicResource AppInputBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="4,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconTextStyle}" Text="&#xE946;"/>
                                <ComboBox x:Name="CmbAppointmentReason" Height="44" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppTextPrimary}" Padding="8,0" SelectedIndex="0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="معاينة جديدة"/>
                                    <ComboBoxItem Content="مراجعة"/>
                                </ComboBox>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- الصف الثالث -->
                    <Grid Grid.Row="3" Margin="0,0,0,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="تاريخ الموعد" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Background="{DynamicResource AppInputBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="4,0">
                                <DatePicker x:Name="DpAppointmentDate" Height="44" Background="Transparent" Foreground="{DynamicResource AppTextPrimary}" BorderThickness="0" VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="وقت الموعد" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Background="{DynamicResource AppInputBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="4,0" Height="44">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconTextStyle}" Text="&#xE823;"/>
                                    <Grid FlowDirection="LeftToRight" Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CmbHour" Grid.Column="0" Background="Transparent" Foreground="{DynamicResource AppTextPrimary}" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="2"/>
                                        <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="2,0"/>
                                        <ComboBox x:Name="CmbMinute" Grid.Column="2" Background="Transparent" Foreground="{DynamicResource AppTextPrimary}" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="2"/>
                                        <ComboBox x:Name="CmbAmPm" Grid.Column="4" Background="Transparent" Foreground="{DynamicResource AppTextPrimary}" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="2" Margin="4,0,0,0"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- الصف الرابع -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                        <Button Content="حفظ الموعد" Width="140" Height="48" Background="{DynamicResource DashActiveFilterBg}" Foreground="White" BorderThickness="0" Margin="0,0,12,0" Style="{StaticResource RoundedButtonStyle}" Click="BtnSaveAppointment_Click"/>
                        <Button Content="إلغاء الأمر" Width="110" Height="48" Background="{DynamicResource AppInputBg}" Foreground="{DynamicResource AppTextPrimary}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Style="{StaticResource RoundedButtonStyle}" Click="BtnCloseAppointmentDialog_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
