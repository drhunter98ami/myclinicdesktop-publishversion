<Window x:Class="MyClinic.PatientImageViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:motion="clr-namespace:MyClinic"
        Title="صور الزيارة" Width="1080" Height="780" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" FlowDirection="LeftToRight"
        Background="{DynamicResource AppWindowBg}" Foreground="{DynamicResource AppTextPrimary}"
        FontFamily="Segoe UI" FontSize="14" PreviewKeyDown="Viewer_KeyDown"
        motion:InteractionMotion.Enabled="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,6,5"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource AppWindowBg}">
    <Grid Margin="18" FlowDirection="RightToLeft">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="ViewerTitle" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="اختر الصور من الشريط السفلي لتصدير عدة ملفات. التصدير يحفظ الملفات الأصلية دون تغيير." Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="ExportCurrentButton" Content="تصدير الصورة الحالية" Click="ExportCurrent_Click"/>
            <Button x:Name="ExportSelectedButton" Content="تصدير المحدد (0)" Click="ExportSelected_Click" IsEnabled="False"/>
            <Button x:Name="SelectAllButton" Content="تحديد الكل" Click="SelectAll_Click"/>
            <Button Content="إلغاء التحديد" Click="ClearSelection_Click"/>
            <Button x:Name="ExternalButton" Content="فتح خارج التطبيق" Click="External_Click"/>
        </WrapPanel>
        <Border Grid.Row="2" CornerRadius="12" Background="#101820" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <ScrollViewer x:Name="ImageScroll" FlowDirection="LeftToRight" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Viewport_SizeChanged" PreviewMouseWheel="Image_MouseWheel">
                    <Image x:Name="FullImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                </ScrollViewer>
                <Border x:Name="ImageState" Background="#E6101820" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                    <StackPanel><TextBlock x:Name="ImageStateText" Foreground="White" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="RetryImageButton" Content="إعادة المحاولة" Click="Retry_Click" Visibility="Collapsed" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <WrapPanel Grid.Row="3" Margin="0,10,0,4" VerticalAlignment="Center">
            <Button x:Name="PreviousButton" Content="السابق" Click="Previous_Click"/>
            <TextBlock x:Name="ImagePosition" MinWidth="75" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,5"/>
            <Button x:Name="NextButton" Content="التالي" Click="Next_Click"/>
            <Button Content="−" Click="ZoomOut_Click" ToolTip="تصغير" AutomationProperties.Name="تصغير الصورة"/>
            <TextBlock x:Name="ZoomLabel" MinWidth="50" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,5"/>
            <Button Content="+" Click="ZoomIn_Click" ToolTip="تكبير" AutomationProperties.Name="تكبير الصورة"/>
            <Button Content="ملاءمة النافذة" Click="Fit_Click"/>
            <Button Content="تدوير 90°" Click="Rotate_Click"/>
        </WrapPanel>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ListBox x:Name="ImageStrip" Background="Transparent" BorderThickness="0" MaxHeight="130" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionMode="Single" SelectionChanged="ImageStrip_SelectionChanged">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="3"/><Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <StackPanel Width="116">
                        <Border Background="{DynamicResource AppInputBg}" CornerRadius="6" Height="60"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border>
                        <CheckBox Content="تحديد للتصدير" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="ExportSelection_Changed" Unchecked="ExportSelection_Changed" Foreground="{DynamicResource AppTextPrimary}" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding FileName}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                    </StackPanel>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="ViewerStatus" Grid.Row="1" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource AppTextSecondary}" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Grid>
    </Grid>
</Window>
