<UserControl x:Class="MyClinic.PatientRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:MyClinic"
             FlowDirection="RightToLeft"
             Background="Transparent"
             FontFamily="Segoe UI"
             FontSize="14"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.ClearTypeHint="Enabled"
             PreviewMouseMove="PatientRecords_PreviewMouseMove"
             MouseLeave="PatientRecords_MouseLeave"
             PreviewKeyDown="Records_KeyDown" SizeChanged="Records_SizeChanged">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- شريط التمرير (ScrollBar) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Margin="2,0,2,0">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{DynamicResource AppBorder}" CornerRadius="4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterShellStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBg}"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBannerPillBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="VisitEntryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModalHeaderChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource VisitModalChipBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitModalChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DetailSectionStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource VisitCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitCardBorder}"/>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Width" Value="146"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource VisitSubCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitSubCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,4"/>
        </Style>
        <Style x:Key="RecordInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style x:Key="RecordCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,8,4"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                        <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template"><Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="OptionSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="OptionSurface" Property="BorderBrush" Value="{DynamicResource DashCalendarTodayNumFg}"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="OptionSurface" Property="Background" Value="{DynamicResource AppCardBg}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value></Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="FilterToggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="FilterComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="10,6" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" Margin="0,0,10,0"/>
                            <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="8" Height="4" VerticalAlignment="Center"/>
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border x:Name="FilterPopupSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FilterToggle" Property="BorderBrush" Value="{DynamicResource DashCalendarTodayNumFg}"/></Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="FilterToggle" Property="BorderBrush" Value="{DynamicResource DashCalendarTodayNumFg}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="RecordList" TargetType="ListBox">
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <!-- Keep the themed surface when an overlay disables background input. -->
                    <Border x:Name="RecordListSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabShell" CornerRadius="9" Background="Transparent" Margin="2" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="TabShell" Property="Background" Value="{DynamicResource AppInputBg}"/>
                </Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabShell" Property="BorderBrush" Value="{DynamicResource DashCalendarTodayNumFg}"/><Setter TargetName="TabShell" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PatientRecordsRootGrid" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- إضاءة مؤشر الفأرة في الوضع الداكن -->
        <Canvas x:Name="PatientRecordsSpotlightCanvas"
                Grid.RowSpan="2"
                IsHitTestVisible="False"
                Panel.ZIndex="0"
                Visibility="Collapsed">
            <Ellipse x:Name="PatientRecordsSpotlightEllipse" CacheMode="BitmapCache"
                     Width="620"
                     Height="620"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#4214B8A6" Offset="0.0"/>
                        <GradientStop Color="#200EA5E9" Offset="0.45"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="PatientRecordsSpotlightTransform" X="-1200" Y="-1200"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <Border x:Name="RecordsHeader" Grid.Row="0" Margin="0,0,0,12" Padding="20,16" CornerRadius="18" Background="{DynamicResource SettingsBannerBg}" BorderBrush="{DynamicResource SettingsBannerBorder}" BorderThickness="1" Panel.ZIndex="2" motion:NavigationTransition.Motion="Header">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel LastChildFill="True" Margin="0,0,0,14">
                    <Button DockPanel.Dock="Left" Content="＋ إضافة مريض" Style="{StaticResource RecordButton}" Click="AddPatient_Click" Background="{DynamicResource SettingsPrimaryBtnBg}" Foreground="{DynamicResource SettingsPrimaryBtnFg}"/>
                    <StackPanel><TextBlock Text="سجل المرضى" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource SettingsBannerTitleFg}"/>
                        <TextBlock Text="ابحث عن المريض، ثم تابع زياراته وعلاجاته" Foreground="{DynamicResource SettingsBannerSubFg}" FontSize="14" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FilterShellStyle}" Height="46">
                        <Grid>
                            <TextBox x:Name="TxtNameSearch" Style="{StaticResource FilterTextBoxStyle}" Padding="40,0,42,0" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="البحث باسم المريض أو رقم الهاتف أو رقم الملف"/>
                            <TextBlock Text="ابحث بالاسم أو رقم الهاتف أو رقم الملف…" Foreground="{DynamicResource AppTextSecondary}" Margin="40,0,42,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TxtNameSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DashCalendarTodayNumFg}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <Button Content="×" HorizontalAlignment="Left" Width="34" Height="34" Margin="5,0,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppTextSecondary}" Click="ClearSearch_Click" ToolTip="مسح البحث" AutomationProperties.Name="مسح البحث"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Content="مسح التصفية" Style="{StaticResource RecordButton}" Margin="10,0,0,0" Click="ClearFilters_Click"/>
                </Grid>
                <Expander Grid.Row="2" Header="تصفية وترتيب العرض" Foreground="{DynamicResource AppTextPrimary}" IsExpanded="False"><WrapPanel VerticalAlignment="Center" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,0,4"><TextBlock Text="ترتيب حسب" Foreground="{DynamicResource AppTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="SortBox" Style="{StaticResource RecordCombo}" SelectedIndex="0" SelectionChanged="PatientFilters_Changed" AutomationProperties.Name="ترتيب المرضى"><ComboBoxItem Content="آخر زيارة"/><ComboBoxItem Content="الاسم"/><ComboBoxItem Content="الأحدث إضافةً"/></ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,4"><TextBlock Text="الزيارات" Foreground="{DynamicResource AppTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="VisitFilterBox" Style="{StaticResource RecordCombo}" SelectedIndex="0" SelectionChanged="PatientFilters_Changed" AutomationProperties.Name="تصفية حسب الزيارات"><ComboBoxItem Content="كل المرضى"/><ComboBoxItem Content="لديه زيارات"/><ComboBoxItem Content="بدون زيارات"/></ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,4"><TextBlock Text="فترة آخر زيارة" Foreground="{DynamicResource AppTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="RecentFilterBox" Style="{StaticResource RecordCombo}" SelectedIndex="0" SelectionChanged="PatientFilters_Changed" AutomationProperties.Name="فترة آخر زيارة"><ComboBoxItem Content="كل الفترات"/><ComboBoxItem Content="آخر 30 يوماً"/><ComboBoxItem Content="آخر 90 يوماً"/><ComboBoxItem Content="آخر سنة"/></ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="CompactToggle" Content="عرض مدمج" Foreground="{DynamicResource AppTextPrimary}" Margin="12,20,12,6" Checked="Density_Changed" Unchecked="Density_Changed"/>
                    <CheckBox x:Name="SpotlightToggle" Content="إضاءة المؤشر" Foreground="{DynamicResource AppTextSecondary}" Margin="0,20,0,6" Checked="Spotlight_Changed" Unchecked="Spotlight_Changed"/>
                </WrapPanel></Expander>
            </Grid>
        </Border>

        <Grid motion:NavigationTransition.Motion="Content" motion:NavigationTransition.Order="2" Grid.Row="1" Panel.ZIndex="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel x:Name="ResultSummary" Margin="3,0,0,9"/>
            <TextBlock x:Name="RecordsStatus" Grid.Row="1" Margin="3,0,3,9" TextAlignment="Right" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource DashCalendarTodayNumFg}" AutomationProperties.LiveSetting="Polite"/>

            <ListBox Style="{StaticResource RecordList}" motion:NavigationTransition.Motion="Items" motion:NavigationTransition.Order="4" Grid.Row="2" x:Name="PatientsListBox" motion:ScrollState.Enabled="True"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     Margin="0,2,0,0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RowShell" CornerRadius="14" BorderBrush="{DynamicResource PatientCardBorder}" BorderThickness="1" Background="{DynamicResource PatientCardBg}"><ContentPresenter/></Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowShell" Property="BorderBrush" Value="{DynamicResource DashCalendarTodayNumFg}"/><Setter TargetName="RowShell" Property="BorderThickness" Value="2"/></Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="RowShell" Property="BorderBrush" Value="{DynamicResource DashCalendarTodayNumFg}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid>
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="16,13"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=CompactToggle}" Value="True"><Setter Property="Margin" Value="12,6"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock motion:SearchAssist.Text="{Binding DisplayName}" motion:SearchAssist.Kind="Name" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=CompactToggle}" Value="True"><Setter Property="FontSize" Value="17"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock motion:SearchAssist.Text="{Binding PhoneNumber}" motion:SearchAssist.Kind="Phone" FlowDirection="LeftToRight" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,3"/>
                                <Button Content="نسخ" Tag="{Binding PhoneNumber}" Click="CopyPhone_Click" Padding="5,0" Background="Transparent" Foreground="{DynamicResource DashCalendarTodayNumFg}" BorderThickness="0" ToolTip="نسخ رقم الهاتف" AutomationProperties.Name="نسخ رقم الهاتف" Margin="0,0,12,3"/>
                                <TextBlock Text="{Binding DemographicsText}" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,14,3"/>
                                <TextBlock Text="{Binding FileNumberText}" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,14,3"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding LatestVisitLabel}" Foreground="{DynamicResource AppTextSecondary}" FontSize="12.5">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=CompactToggle}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="سجل الزيارات" Style="{StaticResource RecordButton}" Tag="{Binding}" Click="OpenMedicalRecord_Click" Background="{DynamicResource SettingsPrimaryBtnBg}" Foreground="{DynamicResource SettingsPrimaryBtnFg}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding VisitCountLabel}" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="EmptyStateCard" Grid.Row="2"
                    MaxWidth="420" Margin="12"
                    Padding="28"
                    CornerRadius="22"
                    Background="{DynamicResource SettingsCardBg}"
                    BorderBrush="{DynamicResource SettingsCardBorder}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8B7;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="44"
                               Foreground="{DynamicResource DashCalendarTodayNumFg}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyStateTitle"
                               Text="لا توجد نتائج مطابقة"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppTextPrimary}"
                               Margin="0,10,0,8"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyStateDescription" TextWrapping="Wrap" TextAlignment="Center"
                               Text="جرّب البحث باسم مختلف أو رقم هاتف آخر."
                               FontSize="15"
                               Foreground="{DynamicResource AppTextSecondary}"
                               HorizontalAlignment="Center"/>
                    <Button x:Name="EmptyAction" Content="مسح البحث" Style="{StaticResource RecordButton}" Click="EmptyAction_Click" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="LoadingOverlay" Grid.RowSpan="3"
                    Panel.ZIndex="10"
                    Visibility="Collapsed"
                    Background="#99000000"
                    CornerRadius="24">
                <Border Width="260"
                        Padding="24"
                        CornerRadius="20"
                        Background="{DynamicResource SettingsCardBg}"
                        BorderBrush="{DynamicResource SettingsCardBorder}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="جارٍ تحميل سجل المرضى"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   TextAlignment="Center"/>
                        <TextBlock Text="جارٍ تحميل ملفات المرضى والزيارات."
                                   Margin="0,8,0,18"
                                   FontSize="14"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   TextAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True"
                                     Height="8"
                                     Foreground="#14B8A6"
                                     Background="{DynamicResource AppInputBg}"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <Grid x:Name="MedicalRecordOverlay" Grid.RowSpan="2" Panel.ZIndex="20" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
            <Border x:Name="OverlayDimmer" Background="#80000000" Opacity="0" MouseLeftButtonDown="OverlayDimmer_MouseLeftButtonDown"/>
            <Border x:Name="MedicalRecordDrawer" Width="480" HorizontalAlignment="Left" Background="{DynamicResource VisitModalOuterBg}" BorderBrush="{DynamicResource VisitModalOuterBorder}" BorderThickness="0,0,1,0">
                <Border.RenderTransform><TranslateTransform x:Name="DrawerTranslate" X="-32"/></Border.RenderTransform>
                <Grid Margin="20" FlowDirection="RightToLeft">
