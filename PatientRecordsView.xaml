<UserControl x:Class="MyClinic.PatientRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="Transparent"
             FontFamily="Segoe UI"
             FontSize="14"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.ClearTypeHint="Enabled"
             PreviewMouseMove="PatientRecords_PreviewMouseMove"
             MouseLeave="PatientRecords_MouseLeave">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- شريط التمرير (ScrollBar) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Margin="2,0,2,0">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{DynamicResource AppBorder}" CornerRadius="4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterShellStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBg}"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBannerPillBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="VisitEntryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModalHeaderChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource VisitModalChipBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitModalChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DetailSectionStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource VisitCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitCardBorder}"/>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Width" Value="146"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource VisitSubCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitSubCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PatientRecordsRootGrid" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- إضاءة مؤشر الفأرة في الوضع الداكن -->
        <Canvas x:Name="PatientRecordsSpotlightCanvas"
                Grid.RowSpan="2"
                IsHitTestVisible="False"
                Panel.ZIndex="0"
                Visibility="Collapsed">
            <Ellipse x:Name="PatientRecordsSpotlightEllipse"
                     Width="620"
                     Height="620"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#4214B8A6" Offset="0.0"/>
                        <GradientStop Color="#200EA5E9" Offset="0.45"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="PatientRecordsSpotlightTransform" X="-1200" Y="-1200"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- ═══ Header Banner (متوافق مع الثيم العام للتطبيق) ═══ -->
        <Border Grid.Row="0"
                Panel.ZIndex="2"
                Margin="0,0,0,16"
                Padding="28,18"
                CornerRadius="18"
                Background="{DynamicResource SettingsBannerBg}"
                BorderBrush="{DynamicResource SettingsBannerBorder}"
                BorderThickness="1.2"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#2DD4BF"
                                  BlurRadius="20"
                                  ShadowDepth="0"
                                  Opacity="{DynamicResource SettingsBannerGlowOpacity}"/>
            </Border.Effect>

            <Grid>
                <!-- رسمة السن المائية في الخلفية -->
                <Viewbox Width="118"
                         Height="118"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Margin="0,-12,240,-12"
                         IsHitTestVisible="False">
                    <Canvas Width="120" Height="120">
                        <Path Stroke="{DynamicResource VisitBannerToothBrush}"
                              StrokeThickness="5.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M60,24 C47,12 24,16 22,38 C20,56 30,68 33,88 C35,103 42,108 47,96 C51,85 55,78 60,78 C65,78 69,85 73,96 C78,108 85,103 87,88 C90,68 100,56 98,38 C96,16 73,12 60,24 Z"/>
                        <Path Stroke="{DynamicResource VisitBannerToothBrush}"
                              StrokeThickness="3.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M43,36 C52,43 68,43 77,36"/>
                    </Canvas>
                </Viewbox>

                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="0,0,20,0">
                        <Border Style="{StaticResource FilterShellStyle}"
                                Width="280"
                                Margin="0,0,12,0">
                            <Grid>
                                <TextBox x:Name="TxtPhoneSearch"
                                         Style="{StaticResource FilterTextBoxStyle}"
                                         Padding="14,0,46,0"
                                         TextChanged="SearchBox_TextChanged"/>
                                <TextBlock Text="بحث عن طريق الرقم..."
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           FontSize="14"
                                           Margin="0,0,46,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtPhoneSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="&#xE717;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{DynamicResource DashCalendarTodayNumFg}"
                                           Margin="0,0,15,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource FilterShellStyle}"
                                Width="280">
                            <Grid>
                                <TextBox x:Name="TxtNameSearch"
                                         Style="{StaticResource FilterTextBoxStyle}"
                                         Padding="14,0,46,0"
                                         TextChanged="SearchBox_TextChanged"/>
                                <TextBlock Text="بحث بالاسم..."
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           FontSize="14"
                                           Margin="0,0,46,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtNameSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{DynamicResource DashCalendarTodayNumFg}"
                                           Margin="0,0,15,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                FlowDirection="RightToLeft"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="سجل المرضى"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SettingsBannerTitleFg}"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="إدارة ملفات المرضى ومتابعة سجلاتهم الطبية"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SettingsBannerSubFg}"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ Patient list ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Panel.ZIndex="2">
            <ListBox x:Name="PatientsListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     Margin="0,2,0,0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="2,0,2,12"
                                Padding="20,14"
                                VerticalAlignment="Top"
                                CornerRadius="18"
                                Background="{DynamicResource PatientCardBg}"
                                BorderBrush="{DynamicResource PatientCardBorder}"
                                BorderThickness="1">
                            <Grid FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="52"
                                        Height="52"
                                        CornerRadius="15"
                                        Background="{DynamicResource PatientAvatarBg}"
                                        BorderBrush="{DynamicResource PatientAvatarBorder}"
                                        BorderThickness="1.2">
                                    <TextBlock Text="&#xE77B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="23"
                                               Foreground="{DynamicResource PatientAvatarFg}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="14,0,14,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontFamily="Traditional Arabic"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AppTextPrimary}"
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                Margin="0,-2,0,0">
                                        <TextBlock Text="&#xE717;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource DashCalendarTodayNumFg}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding PhoneNumber}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,20,0">
                                    <Border Padding="14,7"
                                            CornerRadius="12"
                                            Background="{DynamicResource PatientChipBg}"
                                            BorderBrush="{DynamicResource PatientChipBorder}"
                                            BorderThickness="1"
                                            Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="الجنس:" FontSize="13" Foreground="{DynamicResource PatientChipLabelFg}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding GenderLabel}" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource PatientChipValueFg}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="14,7"
                                            CornerRadius="12"
                                            Background="{DynamicResource PatientChipBg}"
                                            BorderBrush="{DynamicResource PatientChipBorder}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="العمر:" FontSize="13" Foreground="{DynamicResource PatientChipLabelFg}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding AgeText}" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource PatientChipValueFg}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource CardActionButtonStyle}"
                                            Background="{DynamicResource SettingsPrimaryBtnBg}"
                                            BorderBrush="{DynamicResource SettingsPrimaryBtnBorder}"
                                            Foreground="{DynamicResource SettingsPrimaryBtnFg}"
                                            Padding="16,0"
                                            Tag="{Binding}"
                                            Click="OpenMedicalRecord_Click">
                                        <StackPanel Orientation="Horizontal"
                                                    FlowDirection="RightToLeft">
                                            <TextBlock Text="سجل الزيارات"
                                                       FontSize="14.5"
                                                       FontWeight="Bold"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Width="108"
                                            Margin="10,0,0,0"
                                            Style="{StaticResource CardActionButtonStyle}"
                                            Background="{DynamicResource PatientChipBg}"
                                            BorderBrush="{DynamicResource PatientAvatarBorder}"
                                            Foreground="{DynamicResource PatientAvatarFg}"
                                            Tag="{Binding}"
                                            Click="OpenMedicalRecord_Click">
                                        <StackPanel Orientation="Horizontal"
                                                    FlowDirection="RightToLeft"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding VisitCountLabel}"
                                                       FontSize="14.5"
                                                       FontWeight="Bold"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="&#xE787;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="15"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="EmptyStateCard"
                    Width="420"
                    Padding="28"
                    CornerRadius="22"
                    Background="{DynamicResource SettingsCardBg}"
                    BorderBrush="{DynamicResource SettingsCardBorder}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8B7;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="44"
                               Foreground="{DynamicResource DashCalendarTodayNumFg}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyStateTitle"
                               Text="لا توجد نتائج مطابقة"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppTextPrimary}"
                               Margin="0,10,0,8"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyStateDescription"
                               Text="جرّب البحث باسم مختلف أو رقم هاتف آخر."
                               FontSize="15"
                               Foreground="{DynamicResource AppTextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="LoadingOverlay"
                    Panel.ZIndex="10"
                    Visibility="Collapsed"
                    Background="#99000000"
                    CornerRadius="24">
                <Border Width="260"
                        Padding="24"
                        CornerRadius="20"
                        Background="{DynamicResource SettingsCardBg}"
                        BorderBrush="{DynamicResource SettingsCardBorder}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="جارٍ تحميل سجل المرضى"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   TextAlignment="Center"/>
                        <TextBlock Text="يتم تجهيز البيانات بشكل أخف وأسرع."
                                   Margin="0,8,0,18"
                                   FontSize="14"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   TextAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True"
                                     Height="8"
                                     Foreground="#14B8A6"
                                     Background="{DynamicResource AppInputBg}"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ═══ Medical record drawer ════════════════════════════════════════════ -->
        <Grid x:Name="MedicalRecordOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="20"
              Visibility="Collapsed">
            <Border x:Name="OverlayDimmer"
                    Background="#80000000"
                    Opacity="0"
                    MouseLeftButtonDown="OverlayDimmer_MouseLeftButtonDown"/>

            <Border x:Name="MedicalRecordDrawer"
                    Width="440"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource VisitModalOuterBg}"
                    BorderBrush="{DynamicResource VisitModalOuterBorder}"
                    BorderThickness="0,0,1,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DrawerTranslate" X="-48"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#28000000" BlurRadius="34" ShadowDepth="8" Opacity="0.26"/>
                </Border.Effect>

                <Grid FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ترويسة الملف الطبي بنفس ثيم البطاقات العلوية -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource VisitBannerBg}"
                            BorderBrush="{DynamicResource VisitBannerBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="24,18,24,16"
                            Margin="0,0,0,16">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Width="34"
                                    Height="34"
                                    Background="{DynamicResource VisitModalChipBg}"
                                    BorderBrush="{DynamicResource VisitModalChipBorder}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    VerticalAlignment="Top"
                                    Click="CloseMedicalRecord_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <TextBlock Text="&#xE711;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="15"
                                                       Foreground="{DynamicResource VisitBannerTitleFg}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <StackPanel Grid.Column="1"
                                        FlowDirection="RightToLeft"
                                        HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="الملف الطبي"
                                               FontFamily="Traditional Arabic"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource VisitBannerTitleFg}"
                                               Margin="0,0,12,0"/>
                                    <Border Width="6"
                                            Height="34"
                                            CornerRadius="3"
                                            Background="{DynamicResource DashCalendarTodayNumFg}"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="استعراض التاريخ المرضي والزيارات السابقة"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource VisitBannerSubFg}"
                                           HorizontalAlignment="Right"
                                           Margin="0,-4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="24,0,24,18"
                            Padding="18"
                            CornerRadius="18"
                            Background="{DynamicResource VisitCardBg}"
                            BorderBrush="{DynamicResource VisitCardBorder}"
                            BorderThickness="1">
                        <Grid x:Name="DrawerPatientInfoCard">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="54"
                                    Height="54"
                                    CornerRadius="16"
                                    Background="{DynamicResource VisitGlowBoxBg}"
                                    BorderBrush="{DynamicResource VisitGlowBoxBorder}"
                                    BorderThickness="1.5">
                                <TextBlock Text="&#xE77B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="24"
                                           Foreground="{DynamicResource VisitGlowBoxFg}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,14,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontFamily="Traditional Arabic"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimary}"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0">
                                    <Border Style="{StaticResource ChipStyle}">
                                        <TextBlock Text="{Binding GenderLabel}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextSecondary}"/>
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}" Margin="0">
                                        <TextBlock Text="{Binding AgeWithUnit}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,0,24,24">
                            <Border Margin="0,0,0,16"
                                    Padding="14"
                                    CornerRadius="14"
                                    Background="{DynamicResource VisitSubCardBg}"
                                    BorderBrush="{DynamicResource VisitSubCardBorder}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="تجد هنا جميع الزيارات والسجلات الطبية المحفوظة لهذا المريض."
                                               FontSize="13"
                                               Foreground="{DynamicResource AppTextSecondary}"
                                               TextWrapping="Wrap"
                                               Width="320"
                                               TextAlignment="Right"/>
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="{DynamicResource DashCalendarTodayNumFg}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Top"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        MinWidth="30"
                                        Height="28"
                                        Padding="8,0"
                                        CornerRadius="8"
                                        Background="{DynamicResource VisitGlowBoxBg}"
                                        BorderBrush="{DynamicResource VisitGlowBoxBorder}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="VisitCounterBadge"
                                               Text="0"
                                               FontSize="14.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource VisitGlowBoxFg}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           x:Name="VisitScopeText"
                                           Text="الزيارات المسجلة"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <ListBox x:Name="VisitsListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource VisitEntryButtonStyle}"
                                                Tag="{Binding}"
                                                Click="OpenVisitDetails_Click">
                                            <Border Margin="0,0,0,12"
                                                    Padding="16,14"
                                                    CornerRadius="14"
                                                    Background="{DynamicResource VisitEntryCardBg}"
                                                    BorderBrush="{DynamicResource VisitEntryCardBorder}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- شريط جانبي ملون مطابق لبطاقات المواعيد -->
                                                    <Border Grid.Column="0"
                                                            CornerRadius="2"
                                                            Background="{DynamicResource VisitEntryPillIndicator}"/>

                                                    <Grid Grid.Column="2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0"
                                                              FlowDirection="LeftToRight">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Background="{DynamicResource VisitSubCardBg}"
                                                                    BorderBrush="{DynamicResource VisitSubCardBorder}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="7"
                                                                    Padding="8,3">
                                                                <TextBlock Text="{Binding VisitDateText}"
                                                                           FontSize="12.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource DashCalendarTodayNumFg}"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Right"
                                                                        FlowDirection="RightToLeft">
                                                                <TextBlock Text="&#xE8A5;"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="14"
                                                                           Foreground="{DynamicResource DashCalendarTodayNumFg}"
                                                                           Margin="0,0,6,0"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding AttachmentLabel}"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AppTextSecondary}"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding Title}"
                                                                   FontFamily="Traditional Arabic"
                                                                   FontSize="21"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource AppTextPrimary}"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Right"
                                                                   Margin="0,8,0,4"/>

                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Details}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                                       TextWrapping="Wrap"
                                                                       TextAlignment="Right"/>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="&#xE76B;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource DashCalendarTodayNumFg}"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="EmptyVisitsText"
                                       Text="لا توجد زيارات محفوظة لهذا المريض حتى الآن."
                                       FontSize="15"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Visit details modal (بطاقة تفاصيل الزيارة الطبية المنسقة بالكامل) ═══ -->
        <Grid x:Name="VisitDetailsOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="30"
              Visibility="Collapsed">
            <Border x:Name="VisitDetailsDimmer"
                    Background="#80000000"
                    Opacity="0"
                    MouseLeftButtonDown="VisitDetailsDimmer_MouseLeftButtonDown"/>

            <Border x:Name="VisitDetailsModal"
                    Width="760"
                    MaxHeight="900"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource VisitModalOuterBg}"
                    BorderBrush="{DynamicResource VisitModalOuterBorder}"
                    BorderThickness="1.2"
                    CornerRadius="26"
                    ClipToBounds="True">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="VisitDetailsTranslate" Y="24"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.35"/>
                </Border.Effect>

                <Grid FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ترويسة بطاقة الزيارة بنفس ثيم بطاقة الترحيب في الصور -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource VisitBannerBg}"
                            BorderBrush="{DynamicResource VisitBannerBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="28,20,28,18"
                            ClipToBounds="True">
                        <Grid>
                            <!-- رسمة السن المائية في الخلفية -->
                            <Viewbox Width="105"
                                     Height="105"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="70,-12,0,-12"
                                     IsHitTestVisible="False">
                                <Canvas Width="120" Height="120">
                                    <Path Stroke="{DynamicResource VisitBannerToothBrush}"
                                          StrokeThickness="5.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M60,24 C47,12 24,16 22,38 C20,56 30,68 33,88 C35,103 42,108 47,96 C51,85 55,78 60,78 C65,78 69,85 73,96 C78,108 85,103 87,88 C90,68 100,56 98,38 C96,16 73,12 60,24 Z"/>
                                    <Path Stroke="{DynamicResource VisitBannerToothBrush}"
                                          StrokeThickness="3.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M43,36 C52,43 68,43 77,36"/>
                                </Canvas>
                            </Viewbox>

                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        Background="{DynamicResource VisitModalChipBg}"
                                        BorderBrush="{DynamicResource VisitModalChipBorder}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        VerticalAlignment="Top"
                                        Click="CloseVisitDetails_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="12">
                                                <TextBlock Text="&#xE711;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource VisitBannerTitleFg}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            FlowDirection="RightToLeft">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Border Width="52"
                                                Height="52"
                                                CornerRadius="16"
                                                Background="{DynamicResource VisitGlowBoxBg}"
                                                BorderBrush="{DynamicResource VisitGlowBoxBorder}"
                                                BorderThickness="1.5"
                                                Margin="0,0,14,0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#2DD4BF"
                                                                  BlurRadius="14"
                                                                  ShadowDepth="0"
                                                                  Opacity="{DynamicResource VisitGlowOpacity}"/>
                                            </Border.Effect>
                                            <TextBlock Text="&#xE8A5;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       Foreground="{DynamicResource VisitGlowBoxFg}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="تفاصيل الزيارة الطبية"
                                                       FontFamily="Traditional Arabic"
                                                       FontSize="34"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource VisitBannerTitleFg}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding PatientName}"
                                                       FontSize="15.5"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource VisitBannerSubFg}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,-6,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid HorizontalAlignment="Right"
                                          Margin="0,16,0,0"
                                          FlowDirection="LeftToRight">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Style="{StaticResource ModalHeaderChipStyle}">
                                            <StackPanel Orientation="Horizontal"
                                                        FlowDirection="RightToLeft">
                                                <TextBlock Text="&#xE823;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource VisitGlowBoxFg}"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding VisitDateTimeText}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource VisitBannerTitleFg}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Style="{StaticResource ModalHeaderChipStyle}">
                                            <StackPanel Orientation="Horizontal"
                                                        FlowDirection="RightToLeft">
                                                <TextBlock Text="&#xE77B;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource VisitGlowBoxFg}"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DoctorName}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource VisitBannerTitleFg}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="24,20,24,8">
                        <StackPanel>
                            <!-- Patient info section -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,0,16">
                                        <TextBlock Text="&#xE77B;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="19"
                                                   Foreground="{DynamicResource DashCalendarTodayNumFg}"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="معلومات المريض عند وقت الزيارة"
                                                   FontFamily="Traditional Arabic"
                                                   FontSize="25"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="زمرة الدم" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding BloodTypeText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{DynamicResource VisitWarningCardBg}" BorderBrush="{DynamicResource VisitWarningCardBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="الحساسية" FontSize="13.5" Foreground="{DynamicResource VisitWarningFg}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding AllergiesText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="4" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="الأمراض المزمنة" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding ChronicDiseasesText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="عادات التدخين" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding SmokingText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="الحمل والرضاعة" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding PregnancyText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Vital signs section -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,0,16">
                                        <TextBlock Text="&#xEC42;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="19"
                                                   Foreground="{DynamicResource DashCalendarTodayNumFg}"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="العلامات الحيوية"
                                                   FontFamily="Traditional Arabic"
                                                   FontSize="25"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>

                                    <WrapPanel HorizontalAlignment="Right">
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="ضغط الدم" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding BloodPressureText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="النبض" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding HeartRateText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="الحرارة" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding TemperatureText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="التنفس" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding RespiratoryRateText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="الوزن" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding WeightText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="الطول" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding HeightText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="سكر الدم" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding BloodSugarText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="BMI" FontSize="13.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding BmiText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Symptoms + Diagnosis -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource DetailSectionStyle}" Margin="0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="شكوى المريض" FontFamily="Traditional Arabic" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="14">
                                            <TextBlock Text="{Binding SymptomsText}" FontSize="16" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap" TextAlignment="Right"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource DetailSectionStyle}" Margin="0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="التشخيص" FontFamily="Traditional Arabic" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="14">
                                            <TextBlock Text="{Binding DiagnosisText}" FontSize="16" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap" TextAlignment="Right"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Dental chart -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="&#xE8D9;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="حالة الأسنان" FontFamily="Traditional Arabic" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="فئة المريض:" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Padding="12,6" CornerRadius="10" Background="{DynamicResource VisitGlowBoxBg}" BorderBrush="{DynamicResource VisitGlowBoxBorder}" BorderThickness="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding DentalChartCategoryText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource VisitGlowBoxFg}"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="الأسنان المعالجة:" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" Margin="0,0,0,10"/>

                                    <ItemsControl ItemsSource="{Binding Teeth}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="54" Height="54" Margin="0,0,10,10" CornerRadius="16" Background="{DynamicResource VisitToothBadgeBg}" BorderBrush="{DynamicResource VisitToothBadgeBorder}" BorderThickness="1.5">
                                                    <TextBlock Text="{Binding}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource VisitToothBadgeFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTeeth}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>

                                    <TextBlock Text="لا توجد أسنان مسجلة لهذه الزيارة." FontSize="15.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTeeth}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Treatment plan -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="الخطة العلاجية والملاحظات" FontFamily="Traditional Arabic" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right" Margin="0,0,0,10"/>
                                    <Border Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="14">
                                        <TextBlock Text="{Binding TreatmentPlanText}" FontSize="16" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap" TextAlignment="Right"/>
                                    </Border>

                                    <StackPanel Margin="0,16,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFinalTreatment}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="الإجراء النهائي" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                                        <Border Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" CornerRadius="14" Padding="14">
                                            <TextBlock Text="{Binding FinalTreatmentText}" FontSize="16" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap" TextAlignment="Right"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Selected Treatments section -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="العلاجات المحددة" FontFamily="Traditional Arabic" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding SelectedTreatments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10" Padding="16,12" CornerRadius="14" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding TreatmentName}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" TextAlignment="Right"/>
                                                            <Border Background="{DynamicResource VisitTreatmentPillBg}" BorderBrush="{DynamicResource VisitTreatmentPillBorder}" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,6,0,0">
                                                                <TextBlock Text="{Binding DetailsDisplay}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource VisitTreatmentPillFg}" TextWrapping="Wrap" TextAlignment="Right"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Padding="12,6" CornerRadius="10" Background="{DynamicResource VisitQtyPillBg}" BorderBrush="{DynamicResource VisitQtyPillBorder}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource VisitQtyPillFg}">
                                                                <Run Text="×"/>
                                                                <Run Text="{Binding Quantity}"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Grid.Column="2" Padding="12,6" CornerRadius="10" Background="{DynamicResource VisitCostPillBg}" BorderBrush="{DynamicResource VisitCostPillBorder}" BorderThickness="1" VerticalAlignment="Center">
                                                            <TextBlock FontSize="13.5" Foreground="{DynamicResource VisitCostPillFg}" FontWeight="Bold">
                                                                <Run Text="{Binding Cost, StringFormat={}{0:0.##}}"/>
                                                                <Run Text=" "/>
                                                                <Run Text="{Binding Currency}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedTreatments}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>

                                    <TextBlock Text="لا توجد علاجات محددة لهذه الزيارة." FontSize="15.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedTreatments}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Prescription -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource DashCalendarTodayNumFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="الوصفة الطبية" FontFamily="Traditional Arabic" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding PrescriptionItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10" Padding="16" CornerRadius="14" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1">
                                                    <StackPanel HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding MedicineName}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding InstructionText}" FontSize="15" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap" TextAlignment="Right" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPrescriptions}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>

                                    <TextBlock Text="لا توجد وصفة طبية مرفقة لهذه الزيارة." FontSize="15.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPrescriptions}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Attachments -->
                            <Border Style="{StaticResource DetailSectionStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="المرفقات والصور" FontFamily="Traditional Arabic" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Right"/>
                                        <Border Grid.Column="1" Padding="10,4" CornerRadius="10" Background="{DynamicResource VisitGlowBoxBg}" BorderBrush="{DynamicResource VisitGlowBoxBorder}" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AttachmentCountText}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource VisitGlowBoxFg}"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource DashCalendarTodayNumFg}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding AttachmentItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="208" Height="208" Margin="0,0,12,12" Padding="0"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        Tag="{Binding}" Click="OpenAttachment_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border CornerRadius="18" BorderBrush="{DynamicResource VisitSubCardBorder}" BorderThickness="1" Background="{DynamicResource VisitSubCardBg}" ClipToBounds="True">
                                                                <Grid>
                                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    <Border VerticalAlignment="Bottom" Background="#80000000" Padding="10,8">
                                                                        <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAttachments}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>

                                    <TextBlock Text="لا توجد صور أو مرفقات لهذه الزيارة." FontSize="15.5" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAttachments}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Padding="20,14"
                            Background="{DynamicResource VisitCardBg}"
                            BorderBrush="{DynamicResource VisitCardBorder}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="تعديل الزيارة"
                                    Tag="{Binding VisitId}"
                                    Click="EditVisit_Click"
                                    Height="42"
                                    Padding="18,0"
                                    Margin="0,0,10,0"
                                    Background="{DynamicResource VisitPrimaryBtnBg}"
                                    BorderBrush="{DynamicResource VisitPrimaryBtnBorder}"
                                    BorderThickness="1"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="11"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="سجل التعديل"
                                    Tag="{Binding VisitId}"
                                    Click="OpenVisitEditHistory_Click"
                                    Height="42"
                                    Padding="18,0"
                                    Margin="0,0,10,0"
                                    Background="{DynamicResource DashCanalBoxBg}"
                                    Foreground="{DynamicResource DashCanalBoxFg}"
                                    BorderBrush="{DynamicResource DashCanalBoxBorder}"
                                    BorderThickness="1"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Visibility="{Binding HasEditHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="11"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="إغلاق"
                                    Width="105"
                                    Height="42"
                                    Background="{DynamicResource VisitSecondaryBtnBg}"
                                    BorderBrush="{DynamicResource VisitSecondaryBtnBorder}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource VisitSecondaryBtnFg}"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="CloseVisitDetails_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="11">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
