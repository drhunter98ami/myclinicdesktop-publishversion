<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MyClinic">
    <local:ToothDescriptionConverter x:Key="ToothDescription"/>
    <Style x:Key="AnatomicalTooth" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="1,2"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource ToothDescription}}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource ToothDescription}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="1,4">
                        <Grid Width="44" Height="120">
                            <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                            <local:ToothGlyph x:Name="Glyph" Grid.Row="1" Width="40" Height="88" ToothId="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                              IsSelected="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                              IsHighlighted="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <TextBlock x:Name="Check" Text="✓" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource DashCalendarTodayNumFg}" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Lower">
                            <Setter TargetName="Label" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="Label" Property="VerticalAlignment" Value="Bottom"/>
                            <Setter TargetName="Glyph" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="Glyph" Property="Grid.RowSpan" Value="2"/>
                            <Setter TargetName="Glyph" Property="VerticalAlignment" Value="Top"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource DashCalendarTodayBorder}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource DashCalendarTodayNumFg}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppTextPrimary}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
