<Window x:Class="MyClinic.VisitEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل الزيارة"
        Width="820"
        Height="820"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppWindowBg}"
        Foreground="{DynamicResource AppTextPrimary}"
        FontFamily="Segoe UI"
        FontSize="14"
        PreviewMouseMove="Window_PreviewMouseMove"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Margin="2,0,2,0">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{DynamicResource AppBorder}" CornerRadius="4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditField" TargetType="TextBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource VisitSubCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitSubCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Margin="12,0"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Opacity="0.7">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="6,2"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DashCalendarTodayBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource VisitSubCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitSubCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,1">
                                        <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <TextBlock Text="⌄"
                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       Margin="12,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="32,6,12,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              TextElement.Foreground="{DynamicResource AppTextPrimary}"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource VisitCardBg}"
                                        BorderBrush="{DynamicResource VisitCardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="4"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="6"
                                    Background="{DynamicResource VisitSubCardBg}"
                                    BorderBrush="{DynamicResource VisitSubCardBorder}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 3,10 L 8,15 L 17,5"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource VisitPrimaryBtnBg}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource VisitPrimaryBtnBorder}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource VisitPrimaryBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitPrimaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource VisitSecondaryBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VisitSecondaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource VisitSecondaryBtnFg}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootEditGrid" ClipToBounds="True">
        <!-- إضاءة مؤشر الفأرة في الوضع الداكن -->
        <Canvas x:Name="EditSpotlightCanvas"
                IsHitTestVisible="False"
                Panel.ZIndex="0"
                Visibility="Collapsed">
            <Ellipse x:Name="EditSpotlightEllipse" CacheMode="BitmapCache"
                     Width="520"
                     Height="520"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#3814B8A6" Offset="0.0"/>
                        <GradientStop Color="#1C0EA5E9" Offset="0.45"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="EditSpotlightTransform" X="-1000" Y="-1000"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <Grid Margin="22" Panel.ZIndex="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ترويسة تعديل بطاقة الزيارة بنفس ثيم بطاقة الترحيب -->
            <Border Grid.Row="0"
                    Background="{DynamicResource VisitBannerBg}"
                    BorderBrush="{DynamicResource VisitBannerBorder}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="24,18"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="تعديل بيانات الزيارة"
                               FontFamily="Traditional Arabic"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{DynamicResource VisitBannerTitleFg}"/>
                    <TextBlock Text="يُحفظ كل تعديل مع وقته والقيم السابقة والجديدة. يمكنك تعديل الملاحظات والقياسات والوصفة الطبية وإضافة صور؛ تبقى الصور الموجودة وتاريخ الزيارة والبيانات المالية والعلاجات والأسنان محفوظة."
                               Foreground="{DynamicResource VisitBannerSubFg}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{DynamicResource VisitCardBg}" BorderBrush="{DynamicResource VisitCardBorder}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="الحالة الصحية" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,12"/>
                            <WrapPanel Margin="0,0,0,10">
                                <CheckBox x:Name="IsPregnantCheckBox" Content="حامل" Margin="0,0,20,0" Foreground="{DynamicResource AppTextPrimary}"/>
                                <CheckBox x:Name="IsNursingCheckBox" Content="مرضع" Foreground="{DynamicResource AppTextPrimary}"/>
                            </WrapPanel>
                            <Grid>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="شهر الحمل" Style="{StaticResource EditLabel}"/>
                                    <TextBox x:Name="PregnancyMonthText" Style="{StaticResource EditField}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource VisitCardBg}" BorderBrush="{DynamicResource VisitCardBorder}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="العلامات الحيوية" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="ضغط الدم" Style="{StaticResource EditLabel}"/><TextBox x:Name="BloodPressureText" Style="{StaticResource EditField}"/></StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="النبض" Style="{StaticResource EditLabel}"/><TextBox x:Name="HeartRateText" Style="{StaticResource EditField}"/></StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="4"><TextBlock Text="الحرارة" Style="{StaticResource EditLabel}"/><TextBox x:Name="TemperatureText" Style="{StaticResource EditField}"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0"><TextBlock Text="معدل التنفس" Style="{StaticResource EditLabel}"/><TextBox x:Name="RespiratoryRateText" Style="{StaticResource EditField}"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"><TextBlock Text="الوزن" Style="{StaticResource EditLabel}"/><TextBox x:Name="WeightText" Style="{StaticResource EditField}"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,12,0,0"><TextBlock Text="الطول" Style="{StaticResource EditLabel}"/><TextBox x:Name="HeightText" Style="{StaticResource EditField}"/></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0"><TextBlock Text="سكر الدم" Style="{StaticResource EditLabel}"/><TextBox x:Name="BloodSugarText" Style="{StaticResource EditField}"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource VisitCardBg}" BorderBrush="{DynamicResource VisitCardBorder}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="الشكوى والتشخيص والعلاج" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,12"/>
                            <TextBlock Text="شكوى المريض" Style="{StaticResource EditLabel}"/>
                            <TextBox x:Name="SymptomsText" Style="{StaticResource EditField}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                            <TextBlock Text="التشخيص" Style="{StaticResource EditLabel}" Margin="0,12,0,6"/>
                            <TextBox x:Name="DiagnosisText" Style="{StaticResource EditField}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                            <TextBlock Text="خطة العلاج والملاحظات" Style="{StaticResource EditLabel}" Margin="0,12,0,6"/>
                            <TextBox x:Name="TreatmentPlanText" Style="{StaticResource EditField}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                            <TextBlock Text="الإجراء النهائي" Style="{StaticResource EditLabel}" Margin="0,12,0,6"/>
                            <TextBox x:Name="FinalTreatmentText" Style="{StaticResource EditField}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Border>

                    <!-- بطاقة تعديل الوصفة الطبية -->
                    <Border Background="{DynamicResource VisitCardBg}" BorderBrush="{DynamicResource VisitCardBorder}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="الوصفة الطبية" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Text="أضف أدوية جديدة أو اختر دواءً من القائمة لتعديله أو حذفه." Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,0,12"/>

                            <TextBlock Text="اسم الدواء" Style="{StaticResource EditLabel}"/>
                            <TextBox x:Name="TxtPrescriptionMedicine" Tag="اسم الدواء..." Style="{StaticResource EditField}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="العيار" Style="{StaticResource EditLabel}"/>
                                    <TextBox x:Name="TxtPrescriptionDosage" Tag="500mg" Style="{StaticResource EditField}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="التكرار (ساعات)" Style="{StaticResource EditLabel}"/>
                                    <TextBox x:Name="TxtPrescriptionFrequency" Tag="8" Style="{StaticResource EditField}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="التوقيت" Style="{StaticResource EditLabel}"/>
                                    <ComboBox x:Name="CmbPrescriptionTiming" Style="{StaticResource EditCombo}" SelectedIndex="0">
                                        <ComboBoxItem Content="بعد الطعام"/>
                                        <ComboBoxItem Content="قبل الطعام"/>
                                        <ComboBoxItem Content="عند اللزوم"/>
                                        <ComboBoxItem Content="قبل النوم"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="ملاحظات إضافية" Style="{StaticResource EditLabel}"/>
                            <TextBox x:Name="TxtPrescriptionNotes" Style="{StaticResource EditField}" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,12"/>

                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="إضافة للوصفة" Click="AddPrescription_Click" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,6"/>
                                <Button x:Name="BtnUpdatePrescription" Content="تحديث المحدد" Click="UpdatePrescription_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,6" IsEnabled="False"/>
                                <Button Content="حذف المحدد" Click="RemovePrescription_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,0,6"/>
                            </WrapPanel>

                            <TextBlock Text="عناصر الوصفة الحالية (انقر على أي عنصر لتعديله)" Style="{StaticResource EditLabel}"/>
                            <ListBox x:Name="LstPrescriptionEntries"
                                     MinHeight="110"
                                     MaxHeight="200"
                                     Background="{DynamicResource VisitSubCardBg}"
                                     BorderBrush="{DynamicResource VisitSubCardBorder}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource AppTextPrimary}"
                                     Padding="6"
                                     SelectionChanged="LstPrescriptionEntries_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource VisitCardBg}" BorderBrush="{DynamicResource VisitCardBorder}" BorderThickness="1" CornerRadius="18" Padding="18">
                        <StackPanel>
                            <TextBlock Text="صور ومرفقات الزيارة" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock x:Name="ImageSelectionHint"
                                       Text="يمكن إضافة صور جديدة دون حذف الصور الموجودة."
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       Margin="0,4,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="إضافة صور"
                                        Click="SelectImages_Click"
                                        Style="{StaticResource PrimaryBtn}"/>
                                <Button Content="مسح الصور المحددة"
                                        Click="ClearSelectedImages_Click"
                                        Style="{StaticResource SecondaryBtn}"
                                        Margin="10,0,0,0"/>
                            </StackPanel>
                            <ItemsControl x:Name="SelectedImagesList" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                <Button Content="حفظ التعديل" Width="135" Height="44" Margin="0,0,10,0" Style="{StaticResource PrimaryBtn}" Click="Save_Click"/>
                <Button Content="إلغاء" Width="105" Height="44" Style="{StaticResource SecondaryBtn}" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
