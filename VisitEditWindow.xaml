<Window x:Class="MyClinic.VisitEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل الزيارة"
        Width="820"
        Height="780"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppWindowBg}"
        Foreground="{DynamicResource AppTextPrimary}"
        FontFamily="Segoe UI"
        FontSize="14">
    <Window.Resources>
        <Style x:Key="EditField" TargetType="TextBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EditLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="5"
                                    Background="{DynamicResource AppInputBg}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 3,10 L 8,15 L 17,5"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#0D9488"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#0D9488"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="تعديل بيانات الزيارة"
                       FontFamily="Traditional Arabic"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppTextPrimary}"/>
            <TextBlock Text="سيُحفظ كل تغيير مع وقته الدقيق وقيمته قبل التعديل وبعده. تاريخ الزيارة والبيانات المالية والعلاجات والأسنان والوصفة والصور لا تتغير."
                       Foreground="{DynamicResource AppTextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="الحالة الصحية" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox x:Name="IsPregnantCheckBox" Content="حامل" Margin="0,0,20,0" Foreground="{DynamicResource AppTextPrimary}"/>
                            <CheckBox x:Name="IsNursingCheckBox" Content="مرضع" Foreground="{DynamicResource AppTextPrimary}"/>
                        </WrapPanel>
                        <Grid>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="شهر الحمل" Style="{StaticResource EditLabel}"/>
                                <TextBox x:Name="PregnancyMonthText" Style="{StaticResource EditField}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="العلامات الحيوية" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="ضغط الدم" Style="{StaticResource EditLabel}"/><TextBox x:Name="BloodPressureText" Style="{StaticResource EditField}"/></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="النبض" Style="{StaticResource EditLabel}"/><TextBox x:Name="HeartRateText" Style="{StaticResource EditField}"/></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4"><TextBlock Text="الحرارة" Style="{StaticResource EditLabel}"/><TextBox x:Name="TemperatureText" Style="{StaticResource EditField}"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0"><TextBlock Text="معدل التنفس" Style="{StaticResource EditLabel}"/><TextBox x:Name="RespiratoryRateText" Style="{StaticResource EditField}"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"><TextBlock Text="الوزن" Style="{StaticResource EditLabel}"/><TextBox x:Name="WeightText" Style="{StaticResource EditField}"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,12,0,0"><TextBlock Text="الطول" Style="{StaticResource EditLabel}"/><TextBox x:Name="HeightText" Style="{StaticResource EditField}"/></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0"><TextBlock Text="سكر الدم" Style="{StaticResource EditLabel}"/><TextBox x:Name="BloodSugarText" Style="{StaticResource EditField}"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="الشكوى والتشخيص والعلاج" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="شكوى المريض" Style="{StaticResource EditLabel}"/>
                        <TextBox x:Name="SymptomsText" Style="{StaticResource EditField}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                        <TextBlock Text="التشخيص" Style="{StaticResource EditLabel}" Margin="0,12,0,6"/>
                        <TextBox x:Name="DiagnosisText" Style="{StaticResource EditField}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                        <TextBlock Text="خطة العلاج والملاحظات" Style="{StaticResource EditLabel}" Margin="0,12,0,6"/>
                        <TextBox x:Name="TreatmentPlanText" Style="{StaticResource EditField}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                        <TextBlock Text="الإجراء النهائي" Style="{StaticResource EditLabel}" Margin="0,12,0,6"/>
                        <TextBox x:Name="FinalTreatmentText" Style="{StaticResource EditField}" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AppCardBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="صور ومرفقات الزيارة" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="ImageSelectionHint"
                                   Text="يمكن إضافة صور جديدة دون حذف الصور الموجودة."
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   Margin="0,4,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="إضافة صور"
                                    Click="SelectImages_Click"
                                    Padding="14,8"
                                    Background="#0D9488"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                            <Button Content="مسح الصور المحددة"
                                    Click="ClearSelectedImages_Click"
                                    Padding="14,8"
                                    Margin="8,0,0,0"
                                    Background="{DynamicResource AppInputBg}"
                                    Foreground="{DynamicResource AppTextPrimary}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    Cursor="Hand"/>
                        </StackPanel>
                        <ItemsControl x:Name="SelectedImagesList" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ التعديل" Width="130" Height="42" Margin="0,0,10,0" Background="#0D9488" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="Save_Click"/>
            <Button Content="إلغاء" Width="100" Height="42" Background="{DynamicResource AppInputBg}" Foreground="{DynamicResource AppTextPrimary}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Cursor="Hand" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
