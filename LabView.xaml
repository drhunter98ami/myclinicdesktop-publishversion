<UserControl x:Class="MyClinic.LabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:MyClinic"
             FlowDirection="RightToLeft"
             Background="Transparent"
             FontFamily="Segoe UI"
             FontSize="14"
             PreviewMouseMove="Lab_PreviewMouseMove"
             MouseLeave="Lab_MouseLeave">

    <UserControl.Resources>
        <!-- ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Margin="2,0,0,0">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{DynamicResource AppBorder}" CornerRadius="4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style (Rounded, Theme-Aware) -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Margin="12,0"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DashCalendarTodayBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme-Aware ComboBoxItem & ComboBox Styles -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DashCalendarTodayBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DashCalendarTodayNumFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Background="{TemplateBinding Background}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="Transparent">
                                                    <TextBlock Text="&#xE70D;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AppTextSecondary}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              TextElement.Foreground="{DynamicResource AppTextPrimary}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource AppCardBg}"
                                            BorderBrush="{DynamicResource SettingsCardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Margin="0,4,0,8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.22"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="{DynamicResource SettingsPrimaryBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsPrimaryBtnBorder}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBg}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="FormLabel">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="LabActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabReceivedButton" TargetType="Button" BasedOn="{StaticResource LabActionButton}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="تم الإستلام">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="تم الدفع">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabPaidButton" TargetType="Button" BasedOn="{StaticResource LabActionButton}">
            <Setter Property="Background" Value="{DynamicResource SettingsGreenBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsGreenBtnBorder}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="تم الدفع">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="تم الدفع ولم يتم الاستلام">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SettingsTableContainerBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsTableRowBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabGridTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Calendar Styles for DatePicker -->
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CalendarDayButton">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DashActiveFilterBg}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CalendarButton">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RangeButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RangeButtonSelectedStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource DashActiveFilterBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsPrimaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="LabRootGrid" ClipToBounds="True">
        <!-- طبقة الإضاءة الخلفية التفاعلية للوضع الداكن -->
        <Canvas x:Name="LabSpotlightCanvas"
                Panel.ZIndex="0"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Ellipse x:Name="LabSpotlightEllipse" CacheMode="BitmapCache"
                     Width="620"
                     Height="620"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#4514B8A6" Offset="0.0"/>
                        <GradientStop Color="#220EA5E9" Offset="0.42"/>
                        <GradientStop Color="#0C2DD4BF" Offset="0.72"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="LabSpotlightTransform" X="-1200" Y="-1200"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <ScrollViewer Panel.ZIndex="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="4,2,4,20">
                <!-- ═══ Header Banner ═══ -->
                <Border motion:NavigationTransition.Motion="Header" motion:NavigationTransition.Order="0" Background="{DynamicResource SettingsBannerBg}"
                        BorderBrush="{DynamicResource SettingsBannerBorder}"
                        BorderThickness="1.2"
                        CornerRadius="18"
                        Padding="28,18"
                        Margin="0,0,0,14"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#2DD4BF"
                                          BlurRadius="20"
                                          ShadowDepth="0"
                                          Opacity="{DynamicResource SettingsBannerGlowOpacity}"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="المخبر"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SettingsBannerTitleFg}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="إدارة الأعمال المرسلة للمخابر ومتابعة حالات الاستلام والدفعات المالية"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SettingsBannerSubFg}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{DynamicResource SettingsBannerPillBg}"
                                BorderBrush="{DynamicResource SettingsBannerPillBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,9"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE9F9;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Foreground="{DynamicResource SettingsBannerPillFg}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="أعمال المخابر"
                                           FontSize="14.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SettingsBannerPillFg}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══ Summary Cards ═══ -->
                <Grid motion:NavigationTransition.Motion="Cards" motion:NavigationTransition.Order="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="13" Background="#1810B981" BorderBrush="#4010B981" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="المدفوعات" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}"/>
                                <TextBlock x:Name="TxtTotalPaid" Text="$0.00" FontSize="26" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TxtTotalPaidSYP" Text="0 ل.س" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="13" Background="{DynamicResource PatientAvatarBg}" BorderBrush="{DynamicResource PatientAvatarBorder}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="$" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PatientAvatarFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي المطلوب" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}"/>
                                <TextBlock x:Name="TxtTotalRequired" Text="$0.00" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TxtTotalRequiredSYP" Text="0 ل.س" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="13" Background="#18EF4444" BorderBrush="#40EF4444" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="المتبقي" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}"/>
                                <TextBlock x:Name="TxtRemaining" Text="$0.00" FontSize="26" FontWeight="Bold" Foreground="#EF4444" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TxtRemainingSYP" Text="0 ل.س" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══ Add Work + Search & Date Filter Grid (2 Connected Columns) ═══ -->
                <Grid motion:NavigationTransition.Motion="Cards" motion:NavigationTransition.Order="3" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.22*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="0.98*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Add Work Section (Right Column) -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="إضافة عمل مخبري جديد" FontSize="18.5" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0" Text="اسم المريض" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="TxtPatientName" Grid.Column="0" Grid.Row="1" Margin="0,0,0,12" Tag="أدخل اسم المريض..."/>

                                <TextBlock Grid.Column="2" Grid.Row="0" Text="اسم المخبر" Style="{StaticResource FormLabel}"/>
                                <Grid Grid.Column="2" Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbLabName" Grid.Column="0" Style="{StaticResource DarkComboBox}"/>
                                    <Button x:Name="BtnAddLabName" Grid.Column="2" Content="+" Width="40"
                                            Style="{StaticResource PrimaryButton}" Click="BtnAddLabName_Click" Padding="0" FontSize="18"/>
                                </Grid>

                                <TextBlock Grid.Column="0" Grid.Row="2" Text="التكلفة ($)" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="TxtCost" Grid.Column="0" Grid.Row="3" Margin="0,0,0,12" Tag="0.00"/>

                                <TextBlock Grid.Column="2" Grid.Row="2" Text="رقم السن" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="TxtTeeth" Grid.Column="2" Grid.Row="3" Margin="0,0,0,12" Tag="مثال: 11, 21"/>

                                <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="4" Text="ملاحظات" Style="{StaticResource FormLabel}"/>
                                <Grid Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtNotes" Grid.Column="0" Tag="ملاحظات إضافية حول العمل..."/>
                                    <Button x:Name="BtnAddWork" Grid.Column="2" Content="إضافة عمل" Style="{StaticResource PrimaryButton}" Click="BtnAddWork_Click"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Search and Date Filter Section (Left Column) -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="البحث والتصفية" FontSize="18.5" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="0.95*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="البحث باسم المريض" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="TxtSearch" Grid.Column="0" Grid.Row="1" Tag="ابحث عن مريض..." TextChanged="TxtSearch_TextChanged"/>

                                    <TextBlock Grid.Column="2" Grid.Row="0" Text="الحالة" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="CmbStatusFilter"
                                              Style="{StaticResource DarkComboBox}"
                                              Grid.Column="2" Grid.Row="1"
                                              SelectionChanged="CmbStatusFilter_SelectionChanged">
                                        <ComboBoxItem Content="الكل"/>
                                        <ComboBoxItem Content="تم الإرسال"/>
                                        <ComboBoxItem Content="تم الإستلام"/>
                                        <ComboBoxItem Content="تم الدفع"/>
                                        <ComboBoxItem Content="تم الدفع ولم يتم الاستلام"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="تصفية حسب التاريخ" FontSize="18.5" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,12"/>

                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border BorderBrush="{DynamicResource DashFilterGroupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Background="{DynamicResource DashFilterGroupBg}"
                                            Padding="4"
                                            Margin="0,0,10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnDayRange" Content="يومي" Style="{StaticResource RangeButtonStyle}" Width="66" Click="BtnDayRange_Click"/>
                                            <Button x:Name="BtnMonthRange" Content="شهري" Style="{StaticResource RangeButtonStyle}" Width="66" Click="BtnMonthRange_Click"/>
                                            <Button x:Name="BtnYearRange" Content="سنوي" Style="{StaticResource RangeButtonStyle}" Width="66" Click="BtnYearRange_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource DashFilterGroupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Background="{DynamicResource DashFilterGroupBg}"
                                            Padding="8,4"
                                            Height="44"
                                            Margin="0,0,10,6">
                                        <DatePicker x:Name="DpFilterDate"
                                                    Width="136"
                                                    VerticalContentAlignment="Center"
                                                    Foreground="{DynamicResource AppTextPrimary}"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    SelectedDateChanged="DpFilterDate_SelectedDateChanged"
                                                    CalendarOpened="DpFilterDate_CalendarOpened"/>
                                    </Border>

                                    <Button x:Name="BtnCurrentDate"
                                            Content="التاريخ الحالي"
                                            Height="44"
                                            Padding="14,0"
                                            Margin="0,0,0,6"
                                            Background="{DynamicResource DashCalendarTodayBg}"
                                            BorderBrush="{DynamicResource DashCalendarTodayBorder}"
                                            BorderThickness="1"
                                            Foreground="{DynamicResource DashCalendarTodayNumFg}"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            Visibility="Collapsed"
                                            Click="BtnCurrentDate_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}"
                                                        CornerRadius="12">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ═══ Works List ═══ -->
                <Border motion:NavigationTransition.Motion="Content" motion:NavigationTransition.Order="5" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="الأعمال المرسلة" FontSize="18.5" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,14"/>

                        <Border Background="{DynamicResource SettingsTableContainerBg}"
                                BorderBrush="{DynamicResource SettingsTableContainerBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                ClipToBounds="True">
                            <DataGrid motion:NavigationTransition.Motion="Items" motion:NavigationTransition.Order="4" x:Name="DgLabWorks"
                                      MaxHeight="480"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource SettingsTableRowBorder}"
                                      RowBackground="{DynamicResource SettingsTableRowBg}"
                                      AlternatingRowBackground="{DynamicResource SettingsTableRowAltBg}"
                                      Foreground="{DynamicResource AppTextPrimary}"
                                      FontSize="13.5"
                                      HeadersVisibility="Column">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource LabGridHeaderStyle}"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DashCalendarTodayBg}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Height" Value="46"/>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="اسم المريض" Binding="{Binding PatientName}" Width="*" ElementStyle="{StaticResource LabGridTextStyle}"/>
                                    <DataGridTextColumn Header="اسم المخبر" Binding="{Binding LabName}" Width="120" ElementStyle="{StaticResource LabGridTextStyle}"/>
                                    <DataGridTextColumn Header="التكلفة" Binding="{Binding Cost, StringFormat=${0:F2}}" Width="90" ElementStyle="{StaticResource LabGridTextStyle}"/>
                                    <DataGridTextColumn Header="رقم السن" Binding="{Binding Teeth}" Width="80" ElementStyle="{StaticResource LabGridTextStyle}"/>
                                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="130" ElementStyle="{StaticResource LabGridTextStyle}"/>
                                    <DataGridTemplateColumn Header="الحالة" Width="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Border CornerRadius="7" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#EF4444"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="تم الإستلام">
                                                                        <Setter Property="Background" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="تم الدفع">
                                                                        <Setter Property="Background" Value="#10B981"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="تم الدفع ولم يتم الاستلام">
                                                                        <Setter Property="Background" Value="#8B5CF6"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11.5" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="تاريخ الإرسال" Binding="{Binding DateSent, StringFormat=dd/MM/yyyy}" Width="110" ElementStyle="{StaticResource LabGridTextStyle}"/>
                                    <DataGridTextColumn Header="تاريخ الاستلام" Binding="{Binding DateReceived, StringFormat=dd/MM/yyyy, TargetNullValue=—}" Width="110" ElementStyle="{StaticResource LabGridTextStyle}"/>
                                    <DataGridTextColumn Header="تاريخ الدفع" Binding="{Binding DatePaid, StringFormat=dd/MM/yyyy, TargetNullValue=—}" Width="110" ElementStyle="{StaticResource LabGridTextStyle}"/>
                                    <DataGridTemplateColumn Header="إجراءات" Width="165">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Content="تم الإستلام"
                                                                Style="{StaticResource LabReceivedButton}"
                                                                Click="BtnMarkReceived_Click"
                                                                Tag="{Binding Id}"/>
                                                        <Button Content="تم الدفع"
                                                                Style="{StaticResource LabPaidButton}"
                                                                Click="BtnMarkPaid_Click"
                                                                Tag="{Binding Id}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Add Lab Name Dialog Overlay -->
        <Grid motion:OverlayMotion.Enabled="True" x:Name="AddLabNameDialogOverlay" Panel.ZIndex="20" Visibility="Collapsed">
            <Border Background="#A00F172A" MouseLeftButtonDown="AddLabNameDialogBackdrop_MouseLeftButtonDown"/>

            <Border Width="420"
                    Padding="28,24"
                    Background="{DynamicResource VisitModalOuterBg}"
                    BorderBrush="{DynamicResource VisitModalOuterBorder}"
                    BorderThickness="1.2"
                    CornerRadius="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="8" Opacity="0.32"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="إضافة مخبر جديد" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>

                        <Button Grid.Column="1" Width="34" Height="34" Background="{DynamicResource SettingsOutlineBtnBg}" BorderBrush="{DynamicResource SettingsOutlineBtnBorder}" BorderThickness="1" Click="BtnCloseAddLabNameDialog_Click" Cursor="Hand">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Dialog Content -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="اسم المخبر" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtNewLabName" Tag="أدخل اسم المخبر..." Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- Dialog Actions -->
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                x:Name="BtnCancelAddLabName"
                                Content="إلغاء"
                                Height="40"
                                Background="{DynamicResource SettingsOutlineBtnBg}"
                                BorderBrush="{DynamicResource SettingsOutlineBtnBorder}"
                                Foreground="{DynamicResource SettingsOutlineBtnFg}"
                                BorderThickness="1"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnCancelAddLabName_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2"
                                x:Name="BtnConfirmAddLabName"
                                Content="إضافة"
                                Height="40"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnConfirmAddLabName_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
