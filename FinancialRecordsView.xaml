<UserControl x:Class="MyClinic.FinancialRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:MyClinic"
             FlowDirection="RightToLeft"
             Background="Transparent"
             Foreground="{DynamicResource AppTextPrimary}"
             FontFamily="Segoe UI"
             FontSize="14"
             PreviewMouseMove="Financial_PreviewMouseMove"
             MouseLeave="Financial_MouseLeave">

    <UserControl.Resources>
        <!-- ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Margin="2,0,0,0">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{DynamicResource AppBorder}" CornerRadius="4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- أنماط التقويم لـ DatePicker -->
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CalendarDayButton">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DashActiveFilterBg}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CalendarButton">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RangeButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Margin="12,0"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="6,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DashCalendarTodayBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExpenseCategoryItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Right"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource DashCalendarTodayBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DashCalendarTodayNumFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExpenseCategoryComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ExpenseCategoryItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="&#xE70D;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                           Foreground="{DynamicResource AppTextSecondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"/>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource AppCardBg}"
                                            BorderBrush="{DynamicResource SettingsCardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,4,0,8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.22"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="FinancialRootGrid" ClipToBounds="True">
        <!-- طبقة الإضاءة الخلفية التفاعلية للوضع الداكن -->
        <Canvas x:Name="FinancialSpotlightCanvas"
                Panel.ZIndex="0"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Ellipse x:Name="FinancialSpotlightEllipse" CacheMode="BitmapCache"
                     Width="620"
                     Height="620"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#4514B8A6" Offset="0.0"/>
                        <GradientStop Color="#220EA5E9" Offset="0.42"/>
                        <GradientStop Color="#0C2DD4BF" Offset="0.72"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="FinancialSpotlightTransform" X="-1200" Y="-1200"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <ScrollViewer Panel.ZIndex="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="4,2,4,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ Header Banner ═══ -->
                <Border motion:NavigationTransition.Motion="Header" motion:NavigationTransition.Order="0" Grid.Row="0"
                        Background="{DynamicResource SettingsBannerBg}"
                        BorderBrush="{DynamicResource SettingsBannerBorder}"
                        BorderThickness="1.2"
                        CornerRadius="18"
                        Padding="28,18"
                        Margin="0,0,0,14"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#2DD4BF"
                                          BlurRadius="20"
                                          ShadowDepth="0"
                                          Opacity="{DynamicResource SettingsBannerGlowOpacity}"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="الإدارة المالية"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SettingsBannerTitleFg}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="تتبع الدخل والمصاريف والدفع المالي للمرضى"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SettingsBannerSubFg}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{DynamicResource SettingsBannerPillBg}"
                                BorderBrush="{DynamicResource SettingsBannerPillBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,9"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8C7;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Foreground="{DynamicResource SettingsBannerPillFg}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="السجل المالي"
                                           FontSize="14.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SettingsBannerPillFg}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══ Summary Cards ═══ -->
                <Grid motion:NavigationTransition.Motion="Cards" motion:NavigationTransition.Order="1" Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource PanelCardStyle}"
                            Padding="20,16">
                        <Border.Effect>
                            <DropShadowEffect Color="#2DD4BF"
                                              BlurRadius="16"
                                              ShadowDepth="0"
                                              Opacity="{DynamicResource DashCanalBoxGlowOpacity}"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="46"
                                    Height="46"
                                    CornerRadius="13"
                                    Background="#1810B981"
                                    BorderBrush="#4010B981"
                                    BorderThickness="1">
                                <TextBlock Text="&#xE8FB;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="#10B981"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي الدخل" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}"/>
                                <TextBlock x:Name="TxtTotalIncome" Text="0" Margin="0,4,0,0" FontSize="24" FontWeight="Bold" Foreground="#10B981">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#2DD4BF"
                                                          BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="{DynamicResource DashCanalBoxGlowOpacity}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource PanelCardStyle}"
                            Padding="20,16">
                        <Border.Effect>
                            <DropShadowEffect Color="#2DD4BF"
                                              BlurRadius="16"
                                              ShadowDepth="0"
                                              Opacity="{DynamicResource DashCanalBoxGlowOpacity}"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="46"
                                    Height="46"
                                    CornerRadius="13"
                                    Background="#18EF4444"
                                    BorderBrush="#40EF4444"
                                    BorderThickness="1">
                                <TextBlock Text="&#xE7C1;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="#EF4444"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي المصاريف" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}"/>
                                <TextBlock x:Name="TxtTotalExpenses" Text="0" Margin="0,4,0,0" FontSize="24" FontWeight="Bold" Foreground="#EF4444">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#2DD4BF"
                                                          BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="{DynamicResource DashCanalBoxGlowOpacity}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4"
                            Style="{StaticResource PanelCardStyle}"
                            Padding="20,16">
                        <Border.Effect>
                            <DropShadowEffect Color="#2DD4BF"
                                              BlurRadius="16"
                                              ShadowDepth="0"
                                              Opacity="{DynamicResource DashCanalBoxGlowOpacity}"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="46"
                                    Height="46"
                                    CornerRadius="13"
                                    Background="{DynamicResource PatientAvatarBg}"
                                    BorderBrush="{DynamicResource PatientAvatarBorder}"
                                    BorderThickness="1">
                                <TextBlock Text="ل.س"
                                           FontSize="16"
                                           Foreground="{DynamicResource PatientAvatarFg}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="الصافي" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}"/>
                                <TextBlock x:Name="TxtNetAmount" Text="0" Margin="0,4,0,0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DashCalendarTodayNumFg}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#2DD4BF"
                                                          BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="{DynamicResource DashCanalBoxGlowOpacity}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="6"
                            Style="{StaticResource PanelCardStyle}"
                            Padding="20,16">
                        <Border.Effect>
                            <DropShadowEffect Color="#2DD4BF"
                                              BlurRadius="16"
                                              ShadowDepth="0"
                                              Opacity="{DynamicResource DashCanalBoxGlowOpacity}"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="46"
                                    Height="46"
                                    CornerRadius="13"
                                    Background="{DynamicResource PatientChipBg}"
                                    BorderBrush="{DynamicResource PatientChipBorder}"
                                    BorderThickness="1">
                                <TextBlock Text="&#xE787;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="{DynamicResource PatientAvatarFg}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="عدد الزيارات (الحالات)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}"/>
                                <TextBlock x:Name="TxtVisitCount" Text="0" Margin="0,4,0,0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#2DD4BF"
                                                          BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="{DynamicResource DashCanalBoxGlowOpacity}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══ Action Bar ═══ -->
                <Border motion:NavigationTransition.Motion="Toolbar" motion:NavigationTransition.Order="3" Grid.Row="2"
                        Style="{StaticResource PanelCardStyle}"
                        Padding="18,14"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search & Unpaid Buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnOpenSearchOverlay"
                                    Height="42"
                                    Padding="18,0"
                                    Background="{DynamicResource SettingsPrimaryBtnBg}"
                                    BorderBrush="{DynamicResource SettingsPrimaryBtnBorder}"
                                    BorderThickness="1"
                                    Foreground="White"
                                    Cursor="Hand"
                                    Click="BtnOpenSearchOverlay_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="11">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Text="بحث عن سجل لمريض" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnOpenUnpaidOverlay"
                                    Height="42"
                                    Padding="18,0"
                                    Margin="10,0,0,0"
                                    Background="#F59E0B"
                                    BorderBrush="#FBBF24"
                                    BorderThickness="1"
                                    Foreground="White"
                                    Cursor="Hand"
                                    Click="BtnOpenUnpaidOverlay_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="11">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Text="حسابات لم تسدد" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Date Filters -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource DashFilterGroupBg}"
                                    BorderBrush="{DynamicResource DashFilterGroupBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,4"
                                    Height="42">
                                <DatePicker x:Name="DpFilterDate"
                                            Width="150"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource AppTextPrimary}"
                                            CalendarOpened="DpFilterDate_CalendarOpened"
                                            SelectedDateChanged="DpFilterDate_SelectedDateChanged"/>
                            </Border>

                            <Button x:Name="BtnCurrentDate"
                                    Margin="10,0,0,0"
                                    Height="42"
                                    Padding="14,0"
                                    Content="اليوم الحالي"
                                    Background="{DynamicResource DashCalendarTodayBg}"
                                    BorderBrush="{DynamicResource DashCalendarTodayBorder}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource DashCalendarTodayNumFg}"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="BtnCurrentDate_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="11">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Range Pills (يومي / شهري / سنوي) -->
                        <Border Grid.Column="4"
                                Background="{DynamicResource DashFilterGroupBg}"
                                BorderBrush="{DynamicResource DashFilterGroupBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnDayRange" Content="يومي" Style="{StaticResource RangeButtonStyle}" Click="BtnDayRange_Click"/>
                                <Button x:Name="BtnMonthRange" Content="شهري" Style="{StaticResource RangeButtonStyle}" Click="BtnMonthRange_Click"/>
                                <Button x:Name="BtnYearRange" Content="سنوي" Style="{StaticResource RangeButtonStyle}" Click="BtnYearRange_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══ Income and Expenses Grid ═══ -->
                <Grid motion:NavigationTransition.Motion="Cards" motion:NavigationTransition.Order="4" Grid.Row="3" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.22*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="0.88*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Income Section -->
                    <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="9" Background="#1810B981" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="سجل الدخل" FontSize="20" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Padding="18,12" Background="{DynamicResource SettingsTableContainerBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="85"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="5" Text="التاريخ" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="4" Text="الوقت" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="3" Text="اسم المريض/المصدر" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="2" Text="الهاتف" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="1" Text="المبلغ المدفوع" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="0" Text="التفاصيل" Style="{StaticResource TableHeaderTextStyle}"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" MaxHeight="350">
                                    <ItemsControl motion:NavigationTransition.Motion="Items" motion:NavigationTransition.Order="4" x:Name="IncomeItemsControl" Style="{StaticResource VirtualizedRecordsStyle}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="18,11" Background="{DynamicResource SettingsTableRowBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="85"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="85"/>
                                                            <ColumnDefinition Width="85"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="5" Text="{Binding DateText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding TimeText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding PatientName}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding PhoneNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PaidAmountText}" HorizontalAlignment="Center" Foreground="{Binding PaidAmountBrush}" FontWeight="Bold" FontSize="15.5"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="0" Tag="{Binding}" Click="BtnIncomeDetails_Click"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Width="34" Height="34" Cursor="Hand"
                                                                Background="{DynamicResource SettingsPrimaryBtnBg}"
                                                                BorderBrush="{DynamicResource SettingsPrimaryBtnBorder}"
                                                                BorderThickness="1"
                                                                ToolTip="عرض تفاصيل العلاجات">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="9">
                                                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="EmptyIncomeText" Text="لا توجد سجلات دخل للفترة المحددة." Margin="0,36,0,36" FontSize="15" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>

                            <Border Grid.Row="3" Background="{DynamicResource SettingsTableContainerBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,1,0,0" Padding="20,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="المجموع الكلي للفترة المحددة" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtIncomeFooterTotal" Text="0" FontSize="20" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Expenses Section -->
                    <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1" Padding="20,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="9" Background="#18EF4444" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="المصاريف" FontSize="20" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Padding="16,12" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="+" Background="#EF4444" Foreground="White" BorderThickness="0" FontSize="22" FontWeight="Bold" Cursor="Hand" Height="40" Click="BtnAddExpense_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <TextBox x:Name="TxtExpenseAmount" Grid.Column="2" Style="{StaticResource InputBoxStyle}" TextAlignment="Center" Tag="القيمة"/>
                                    <ComboBox x:Name="CmbExpenseCategory" Grid.Column="4" Height="40" Padding="8,0"
                                              VerticalContentAlignment="Center" Style="{StaticResource ExpenseCategoryComboBoxStyle}"
                                              FlowDirection="RightToLeft">
                                        <ComboBoxItem Content="اختر الفئة" IsEnabled="False" IsSelected="True"/>
                                    </ComboBox>
                                    <TextBox x:Name="TxtExpenseDetails" Grid.Column="6" Style="{StaticResource InputBoxStyle}"
                                             TextAlignment="Right" Tag="تفاصيل إضافية (اختياري)..."/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Padding="18,12" Background="{DynamicResource SettingsTableContainerBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="85"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="3" Text="التاريخ" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="2" Text="الوقت" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="1" Text="التفاصيل" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="0" Text="القيمة" Style="{StaticResource TableHeaderTextStyle}"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3" MaxHeight="290">
                                    <ItemsControl motion:NavigationTransition.Motion="Items" motion:NavigationTransition.Order="4" x:Name="ExpenseItemsControl" Style="{StaticResource VirtualizedRecordsStyle}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="18,12" Background="{DynamicResource SettingsTableRowBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="85"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="3" Text="{Binding DateText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="0" Text="{Binding AmountText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EF4444" FontWeight="Bold" FontSize="15.5"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="EmptyExpenseText" Text="لا توجد مصاريف للفترة المحددة." Margin="0,36,0,36" FontSize="15" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>

                            <Border Grid.Row="4" Background="{DynamicResource SettingsTableContainerBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,1,0,0" Padding="20,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="مجموع المصاريف" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtExpenseFooterTotal" Text="0" FontSize="20" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══ Upcoming Payments Section (دفعات قادمة) ═══ -->
                <Border motion:NavigationTransition.Motion="Content" motion:NavigationTransition.Order="5" Grid.Row="4" Style="{StaticResource PanelCardStyle}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1" Padding="20,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="9" Background="#18F59E0B" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="دفعات قادمة (مستحقات)" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Inputs -->
                        <Border Grid.Row="1" Padding="20,12" Background="{DynamicResource VisitSubCardBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="+"
                                        Height="40"
                                        Background="{DynamicResource SettingsPrimaryBtnBg}"
                                        BorderBrush="{DynamicResource SettingsPrimaryBtnBorder}"
                                        BorderThickness="1"
                                        Foreground="White"
                                        FontSize="22"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="BtnAddUpcoming_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <TextBox x:Name="TxtUpcomingAmount" Grid.Column="2" Style="{StaticResource InputBoxStyle}" TextAlignment="Center" Tag="القيمة"/>
                                <ComboBox x:Name="CmbUpcomingCategory" Grid.Column="4" Height="40" Padding="8,0"
                                          VerticalContentAlignment="Center" Style="{StaticResource ExpenseCategoryComboBoxStyle}"
                                          FlowDirection="RightToLeft">
                                    <ComboBoxItem Content="اختر الفئة" IsEnabled="False" IsSelected="True"/>
                                </ComboBox>
                                <TextBox x:Name="TxtUpcomingDescription" Grid.Column="6" Style="{StaticResource InputBoxStyle}" TextAlignment="Right" Tag="تفاصيل الدفعة..."/>
                            </Grid>
                        </Border>

                        <!-- List Headers -->
                        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource SettingsTableContainerBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="التفاصيل" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="القيمة" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="0" Text="الإجراءات" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Items -->
                        <Grid Grid.Row="3" MaxHeight="320">
                                <ItemsControl motion:NavigationTransition.Motion="Items" motion:NavigationTransition.Order="4" x:Name="UpcomingItemsControl" Style="{StaticResource VirtualizedRecordsStyle}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="20,12" Background="{DynamicResource SettingsTableRowBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="2" Text="{Binding Description}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding AmountText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F59E0B" FontWeight="Bold" FontSize="15.5"/>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="White" Background="{DynamicResource SettingsGreenBtnBg}" BorderBrush="{DynamicResource SettingsGreenBtnBorder}" BorderThickness="1" Width="36" Height="36" Margin="0,0,8,0" ToolTip="تم الدفع (تحويل للمصاريف)" Cursor="Hand" Click="BtnPayUpcoming_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SettingsDeleteBtnFg}" Background="{DynamicResource SettingsDeleteBtnBg}" BorderBrush="{DynamicResource SettingsDeleteBtnBorder}" BorderThickness="1" Width="36" Height="36" ToolTip="إلغاء الدفعة" Cursor="Hand" Click="BtnCancelUpcoming_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="EmptyUpcomingText" Text="لا توجد دفعات قادمة مسجلة حالياً." Margin="0,32,0,32" FontSize="15" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Income Treatments Overlay -->
        <Border x:Name="IncomeTreatmentsOverlay" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="50"
                MouseLeftButtonDown="IncomeTreatmentsDimmer_MouseLeftButtonDown">
            <Border Width="620" MaxHeight="540" Background="{DynamicResource VisitModalOuterBg}" CornerRadius="22"
                    BorderBrush="{DynamicResource VisitModalOuterBorder}" BorderThickness="1.2" Padding="0"
                    ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="Border_MouseLeftButtonDown_StopPropagation">
                <Grid FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{DynamicResource SettingsBannerBg}" BorderBrush="{DynamicResource SettingsBannerBorder}" BorderThickness="0,0,0,1" Padding="24,18">
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource VisitModalChipBg}" BorderBrush="{DynamicResource VisitModalChipBorder}" BorderThickness="1"
                                    Cursor="Hand" Click="BtnCloseIncomeTreatmentsOverlay_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource SettingsBannerTitleFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                                <TextBlock x:Name="TxtIncomeTreatmentsPatient" Text="العلاجات المحددة"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource SettingsBannerTitleFg}"/>
                                <TextBlock x:Name="TxtIncomeTreatmentsDate" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SettingsBannerSubFg}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table header -->
                    <Border Grid.Row="1" Background="{DynamicResource SettingsTableContainerBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1" Padding="24,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="2" Text="العلاج" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="المسامحة" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="0" Text="المبلغ المدفوع" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Items -->
                    <Grid Grid.Row="2" MaxHeight="340">
                            <ItemsControl x:Name="IncomeTreatmentsItemsControl" Style="{StaticResource VirtualizedRecordsStyle}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="24,14" Background="{DynamicResource SettingsTableRowBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="2" Text="{Binding TreatmentName}" FontSize="15.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AdjustmentText}" FontSize="14" Foreground="{Binding AdjustmentBrush}" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="0" Text="{Binding CostText}" FontSize="15" Foreground="#10B981" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="EmptyIncomeTreatmentsText"
                                       Text="لا توجد علاجات محددة لهذه الزيارة."
                                       Margin="0,32,0,32" FontSize="15"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       HorizontalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="30">
            <Border Width="280" Padding="24" Background="{DynamicResource SettingsCardBg}" BorderBrush="{DynamicResource SettingsCardBorder}" BorderThickness="1" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="جارٍ تحميل السجل المالي" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" TextAlignment="Center"/>
                    <TextBlock Text="يتم تجهيز الدخل والمصاريف والملخصات." Margin="0,8,0,18" FontSize="14" Foreground="{DynamicResource AppTextSecondary}" TextAlignment="Center"/>
                    <ProgressBar Height="8" IsIndeterminate="True" Foreground="#14B8A6" Background="{DynamicResource AppInputBg}"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Unpaid Accounts Overlay -->
        <Border x:Name="UnpaidAccountsOverlay" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="40">
            <Border Width="860" MaxHeight="650" Background="{DynamicResource VisitModalOuterBg}" CornerRadius="22" BorderBrush="{DynamicResource VisitModalOuterBorder}" BorderThickness="1.2" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="حسابات لم تسدد (الديون)" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                            <Border Background="#18EF4444" BorderBrush="#40EF4444" BorderThickness="1" CornerRadius="9" Padding="12,4" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtUnpaidTotal" Text="الإجمالي: 0 ل.س" FontSize="14.5" FontWeight="Bold" Foreground="#EF4444"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="ترتيب حسب:" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                            <ComboBox x:Name="CmbUnpaidSort" Width="155" Height="38" Style="{StaticResource ExpenseCategoryComboBoxStyle}" SelectionChanged="CmbUnpaidSort_SelectionChanged" FlowDirection="RightToLeft">
                                <ComboBoxItem Content="الأعلى مديونية" IsSelected="True"/>
                                <ComboBoxItem Content="الأبجدية (أ-ي)"/>
                                <ComboBoxItem Content="الأقدم تاريخاً"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="2" Width="34" Height="34" VerticalAlignment="Center" Background="{DynamicResource SettingsOutlineBtnBg}" BorderBrush="{DynamicResource SettingsOutlineBtnBorder}" BorderThickness="1" Cursor="Hand" Click="BtnCloseUnpaidOverlay_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource SettingsCardBg}" BorderBrush="{DynamicResource SettingsCardBorder}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource SettingsTableContainerBg}" Padding="18,12" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="3" Text="اسم المريض" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="رقم الهاتف" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="1" Text="تاريخ أول دين" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="0" Text="المبلغ المتبقي" Style="{StaticResource TableHeaderTextStyle}"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <ItemsControl x:Name="UnpaidItemsControl" Style="{StaticResource VirtualizedRecordsStyle}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="18,12" Background="{DynamicResource SettingsTableRowBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="130"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="3" Text="{Binding PatientName}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PhoneNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FirstDebtDateText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                                                    <TextBlock Grid.Column="0" Text="{Binding RemainingAmountText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EF4444" FontWeight="Bold"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <TextBlock x:Name="EmptyUnpaidText" Grid.Row="1" Text="لا توجد حسابات غير مسددة." Margin="0,40" FontSize="15" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- Patient Search History Overlay -->
        <Border x:Name="PatientSearchOverlay" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="40">
            <Border Width="1050" MaxHeight="650" Background="{DynamicResource VisitModalOuterBg}" CornerRadius="22" BorderBrush="{DynamicResource VisitModalOuterBorder}" BorderThickness="1.2" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="السجل المالي للمريض" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="34" Background="{DynamicResource SettingsOutlineBtnBg}" BorderBrush="{DynamicResource SettingsOutlineBtnBorder}" BorderThickness="1" Cursor="Hand" Click="BtnCloseSearchOverlay_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,16" Panel.ZIndex="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="TxtPatientSearchInput" Grid.Row="0" Style="{StaticResource InputBoxStyle}" Tag="أدخل اسم المريض أو رقم الهاتف..." TextChanged="TxtPatientSearchInput_TextChanged" Height="44" FontSize="15"/>

                        <Border x:Name="SuggestionsPopupBorder" Grid.Row="1" Background="{DynamicResource SettingsCardBg}" BorderBrush="{DynamicResource SettingsCardBorder}" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0" MaxHeight="180" Visibility="Collapsed">
                            <ListBox x:Name="LstPatientSuggestions" BorderThickness="0" Background="Transparent" SelectionChanged="LstPatientSuggestions_SelectionChanged" DisplayMemberPath="DisplayName">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="12,10"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource SettingsCardBg}" BorderBrush="{DynamicResource SettingsCardBorder}" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Panel.ZIndex="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource SettingsTableContainerBg}" Padding="16,12" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="5" Text="التاريخ" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="4" Text="الوقت" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="3" Text="التكلفة" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="2" Text="المسامحة" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="1" Text="المدفوع" Style="{StaticResource TableHeaderTextStyle}"/>
                                    <TextBlock Grid.Column="0" Text="التفاصيل" Style="{StaticResource TableHeaderTextStyle}"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <ItemsControl x:Name="PatientHistoryItemsControl" Style="{StaticResource VirtualizedRecordsStyle}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="16,12" Background="{DynamicResource SettingsTableRowBg}" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="5" Text="{Binding DateText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding TimeText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding CostText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding CostColor}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ForgivenessText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding ForgivenessColor}" FontWeight="Bold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PaidText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#10B981" FontWeight="Bold"/>
                                                    <Button Grid.Column="0" Tag="{Binding}" Click="BtnPatientHistoryDetails_Click"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Width="34" Height="34" Cursor="Hand"
                                                            Background="{DynamicResource SettingsPrimaryBtnBg}"
                                                            BorderBrush="{DynamicResource SettingsPrimaryBtnBorder}"
                                                            BorderThickness="1"
                                                            ToolTip="عرض تفاصيل العلاجات">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                                                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <TextBlock x:Name="EmptyPatientHistoryText" Grid.Row="1" Text="يرجى البحث واختيار مريض لعرض السجل." Margin="0,40" FontSize="15" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Border x:Name="PatientHistoryFooter" Grid.Row="2" Background="{DynamicResource SettingsTableContainerBg}" Padding="16,12" BorderBrush="{DynamicResource SettingsTableRowBorder}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Add Payment Form -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button x:Name="BtnAddPatientPayment" Content="+" Background="{DynamicResource SettingsGreenBtnBg}" BorderBrush="{DynamicResource SettingsGreenBtnBorder}" BorderThickness="1" Foreground="White" FontSize="22" FontWeight="Bold" Cursor="Hand" Width="40" Height="40" Click="BtnAddPatientPayment_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <TextBox x:Name="TxtAddPaymentAmount" Width="105" Height="40" Margin="10,0,0,0" Style="{StaticResource InputBoxStyle}" TextAlignment="Center" Tag="الدفعة"/>
                                        <TextBox x:Name="TxtAddForgivenessAmount" Width="145" Height="40" Margin="10,0,0,0" Style="{StaticResource InputBoxStyle}" TextAlignment="Center" Tag="مسامحة"/>
                                    </StackPanel>

                                    <!-- Summary Values -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtPatientTotalCost" Text="إجمالي التكلفة: 0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,0"/>
                                        <TextBlock x:Name="TxtPatientTotalPaid" Text="إجمالي الدفعات: 0" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="16,0,0,0"/>
                                        <TextBlock x:Name="TxtPatientTotalForgiven" Text="إجمالي المسامحة: 0" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Margin="16,0,0,0"/>
                                        <TextBlock x:Name="TxtPatientTotalRemaining" Text="المتبقي: 0" FontSize="14" FontWeight="Bold" Foreground="#EF4444" Margin="16,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
