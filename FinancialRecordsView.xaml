                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding PatientName}" Click="OpenPatient_Click" HorizontalContentAlignment="Right" Style="{StaticResource Link}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" SortMemberPath="Phone" Width="125" ElementStyle="{StaticResource MoneyText}"/>
