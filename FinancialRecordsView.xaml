                                        <TextBox x:Name="TxtExpenseAmount" AutomationProperties.Name="المبلغ (ل.س)" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                    <StackPanel Width="135" Margin="0,0,10,6">
                                        <TextBlock Text="تاريخ المصروف" Style="{StaticResource Label}"/>
