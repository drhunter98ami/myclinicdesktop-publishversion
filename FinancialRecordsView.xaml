                                        <DataGridTextColumn Header="الاستحقاق" Binding="{Binding DueText}" SortMemberPath="DueSort" Width="115" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTemplateColumn Header="الحالة" Width="100" SortMemberPath="StatusOrder">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource AppInputBg}" CornerRadius="6" Padding="8,4" Margin="4,6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource FinanceWarning}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusOrder}" Value="0">
                                                                            <Setter Property="Foreground" Value="{DynamicResource FinanceNegative}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusOrder}" Value="4">
                                                                            <Setter Property="Foreground" Value="{DynamicResource FinancePositive}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusOrder}" Value="5">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="التفاصيل" Binding="{Binding Description}" SortMemberPath="Description" Width="*" ElementStyle="{StaticResource CellText}" MinWidth="160"/>
                                        <DataGridTextColumn Header="القيمة" Binding="{Binding AmountText}" SortMemberPath="Amount" Width="140" ElementStyle="{StaticResource MoneyText}"/>
