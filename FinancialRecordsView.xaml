                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyPatientHistoryText" Text="اختر مريضاً لعرض حسابه." HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Row="4" Margin="0,10,0,0" x:Name="PatientEntryForm" IsEnabled="False">
                    <TextBlock Text="عملية جديدة" FontWeight="Bold" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <StackPanel Width="145" Margin="0,0,10,6">
                            <TextBlock Text="المبلغ (ل.س)" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtAddPaymentAmount" AutomationProperties.Name="المبلغ (ل.س)" FlowDirection="LeftToRight" TextChanged="PaymentPreview_Changed"/>
                        </StackPanel>
                        <StackPanel Width="135" Margin="0,0,10,6">
                            <TextBlock Text="تاريخ العملية" Style="{StaticResource Label}"/>
                            <DatePicker x:Name="DpPaymentDate" AutomationProperties.Name="تاريخ العملية"/>
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,10,6">
                            <TextBlock Text="ملاحظة / سبب المسامحة" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtPaymentReason" AutomationProperties.Name="ملاحظة الدفعة أو سبب المسامحة"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="PaymentPreview" TextWrapping="Wrap" Margin="0,8" Foreground="{DynamicResource AppTextSecondary}"/>
                    <WrapPanel>
                        <Button Content="تسجيل دفعة" Click="RecordPayment_Click" Margin="0,0,8,0" Style="{StaticResource Primary}"/>
                        <Button Content="تسجيل مسامحة" Click="RecordForgiveness_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="LoadingOverlay" Grid.ColumnSpan="2" Background="#70000000" Visibility="Collapsed" Panel.ZIndex="25" Grid.RowSpan="2">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                <StackPanel>
                    <TextBlock Text="جارٍ تحميل السجل المالي…" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="LoadingProgress" Height="4" Margin="0,16,0,0" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Border>
        <Border x:Name="ConfirmationOverlay" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="50" KeyboardNavigation.TabNavigation="Cycle" Grid.RowSpan="2">
            <Border Style="{StaticResource Card}" MaxWidth="480" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" motion:FinanceMotion.Reveal="True">
                <StackPanel>
                    <TextBlock x:Name="ConfirmationTitle" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ConfirmationText" TextWrapping="Wrap" Margin="0,14,0,20"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="تأكيد" Click="ConfirmAccept_Click" x:Name="ConfirmButton" Margin="0,0,10,0" Style="{StaticResource Primary}"/>
                        <Button Content="رجوع" Click="ConfirmCancel_Click" x:Name="ConfirmCancelButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Border x:Name="StatusHost" Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" Grid.ColumnSpan="2">
            <DockPanel>
                <Button Content="إعادة المحاولة" Click="Retry_Click" x:Name="RetryButton" DockPanel.Dock="Left" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
