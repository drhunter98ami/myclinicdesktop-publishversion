                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource AppInputBg}" CornerRadius="6" Padding="8,4" Margin="4,6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" Foreground="{DynamicResource AppTextSecondary}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="التفاصيل" Binding="{Binding Description}" SortMemberPath="Description" Width="*" ElementStyle="{StaticResource CellText}" MinWidth="160"/>
                                        <DataGridTextColumn Header="القيمة" Binding="{Binding AmountText}" SortMemberPath="Amount" Width="160" ElementStyle="{StaticResource MoneyText}"/>
