                                                    <TextBlock Grid.Column="2" Text="{Binding AmountText}" TextAlignment="Left"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Expander>
