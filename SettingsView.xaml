<UserControl x:Class="MyClinic.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MyClinic" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" Background="Transparent">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspaceStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="20" SizeChanged="Page_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Border Style="{StaticResource WorkspaceCard}" local:NavigationTransition.Motion="Header" Margin="0,0,0,14"><StackPanel><TextBlock Text="الإعدادات" Style="{StaticResource WorkspaceHeading}" FontSize="28"/><TextBlock Text="إعدادات واضحة للحسابات والمظهر وبيانات العيادة." Style="{StaticResource WorkspaceHint}" Margin="0,5,0,12"/>
   <TextBlock Text="البحث في الإعدادات" Style="{StaticResource WorkspaceLabel}"/>
   <TextBox x:Name="SettingsSearch" Style="{StaticResource WorkspaceInput}" TextChanged="SettingsSearch_Changed" AutomationProperties.Name="البحث في الإعدادات" ToolTip="ابحث باسم الإعداد، مثل سعر الصرف أو النسخ الاحتياطي"/>
  </StackPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="164"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource WorkspaceCard}" Padding="6" VerticalAlignment="Top"><ListBox x:Name="Categories" SelectionChanged="Category_Changed" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppTextPrimary}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/><Setter Property="FontWeight" Value="Bold"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WorkspaceAccent}"/><Setter TargetName="Bd" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style></ListBox.ItemContainerStyle>
   </ListBox></Border>
   <ScrollViewer x:Name="ContentScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="Content_Scrolled">
    <StackPanel x:Name="CategoryContent">
     <TextBlock x:Name="NoResults" Text="لا توجد إعدادات تطابق البحث." Style="{StaticResource WorkspaceHint}" Visibility="Collapsed"/>
     <Border x:Name="GeneralCard" Style="{StaticResource WorkspaceCard}"><StackPanel>
      <TextBlock Text="عام · اسم المستخدم" Style="{StaticResource WorkspaceHeading}"/>
      <TextBlock Text="هذا هو اسم تسجيل الدخول والاسم الظاهر في الشاشة الرئيسية." Style="{StaticResource WorkspaceHint}" Margin="0,8,0,18"/>
      <TextBlock Text="اسم المستخدم" Style="{StaticResource WorkspaceLabel}"/><TextBox x:Name="Username" Style="{StaticResource WorkspaceInput}" TextChanged="Username_Changed" MaxWidth="450" HorizontalAlignment="Stretch"/>
      <Button x:Name="SaveUsername" Content="حفظ اسم المستخدم" Style="{StaticResource WorkspacePrimary}" Click="SaveUsername_Click" HorizontalAlignment="Left" Margin="0,12,0,8" IsEnabled="False"/>
      <TextBlock x:Name="UsernameStatus" Style="{StaticResource WorkspaceHint}"/>
     </StackPanel></Border>
     <Border x:Name="AppearanceCard" Style="{StaticResource WorkspaceCard}" Visibility="Collapsed"><StackPanel>
      <TextBlock Text="المظهر" Style="{StaticResource WorkspaceHeading}"/><TextBlock Text="تُطبّق اختيارات المظهر فوراً." Style="{StaticResource WorkspaceHint}" Margin="0,6,0,16"/>
      <TextBlock Text="تصميم الواجهة" Style="{StaticResource WorkspaceLabel}"/>
      <WrapPanel Margin="0,0,0,20">
       <Button x:Name="ModernPreview" Style="{StaticResource WorkspaceButton}" Click="Modern_Click" Width="190" Margin="0,0,0,8"><StackPanel><Border Height="65" CornerRadius="8" Background="#0F766E" Padding="8" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#66FFFFFF" CornerRadius="4"/><StackPanel Grid.Column="1" Margin="8,0,0,0"><Border Background="#DDFFFFFF" Height="12" CornerRadius="3" Margin="0,0,0,6"/><Border Background="#88FFFFFF" Height="24" CornerRadius="4"/></StackPanel></Grid></Border><TextBlock Text="التصميم الجديد"/></StackPanel></Button>
       <Button x:Name="OriginalPreview" Style="{StaticResource WorkspaceButton}" Click="Original_Click" Width="190" Margin="12,0,0,8"><StackPanel><Border Height="65" CornerRadius="4" Background="#344B67" Padding="8" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#66FFFFFF"/><StackPanel Grid.Column="1" Margin="8,0,0,0"><Border Background="#DDFFFFFF" Height="12" Margin="0,0,0,6"/><Border Background="#88FFFFFF" Height="24"/></StackPanel></Grid></Border><TextBlock Text="التصميم الأصلي"/></StackPanel></Button>
      </WrapPanel>
      <TextBlock Text="ألوان التطبيق" Style="{StaticResource WorkspaceLabel}"/><ComboBox x:Name="ColorMode" Style="{StaticResource WorkspaceCombo}" SelectionChanged="ColorMode_Changed" MaxWidth="300" HorizontalAlignment="Left"/>
      <TextBlock Text="الحركة والتأثيرات" Style="{StaticResource WorkspaceLabel}" Margin="0,22,0,6"/><ComboBox x:Name="MotionLevelComboBox" Style="{StaticResource WorkspaceCombo}" SelectionChanged="Motion_Changed" MaxWidth="300" HorizontalAlignment="Left"/>
      <TextBlock Text="يتبع التطبيق أيضاً إعدادات الحركة في Windows. تبقى رسائل النجاح والأخطاء واضحة عند إيقاف الحركة." Style="{StaticResource WorkspaceHint}" Margin="0,8,0,12"/>
      <Button Content="معاينة الحركة" Style="{StaticResource WorkspaceButton}" Click="PreviewMotion_Click" HorizontalAlignment="Left"/>
      <Border x:Name="MotionSample" Style="{StaticResource WorkspaceCard}" Padding="12" Margin="0,12,0,0"><TextBlock x:Name="AppearanceStatus" Text="معاينة · تم حفظ الإعداد" Style="{StaticResource WorkspaceHint}"/></Border>
     </StackPanel></Border>
     <Border x:Name="AccountsCard" Style="{StaticResource WorkspaceCard}" Visibility="Collapsed"><StackPanel>
      <TextBlock Text="الحسابات · سعر الصرف" Style="{StaticResource WorkspaceHeading}"/><TextBlock x:Name="SavedRate" Style="{StaticResource WorkspaceHint}" Margin="0,8,0,16"/>
      <TextBlock Text="SYP لكل 1 USD" Style="{StaticResource WorkspaceLabel}"/><TextBox x:Name="ExchangeRate" Style="{StaticResource WorkspaceInput}" FlowDirection="LeftToRight" TextChanged="Rate_Changed" MaxWidth="400"/>
      <TextBlock x:Name="RateExample" Style="{StaticResource WorkspaceHint}" Margin="0,8,0,12"/>
      <Button x:Name="SaveRate" Content="حفظ سعر الصرف" Style="{StaticResource WorkspacePrimary}" Click="SaveRate_Click" HorizontalAlignment="Left"/>
      <TextBlock x:Name="RateStatus" Style="{StaticResource WorkspaceHint}" Margin="0,8,0,0"/>
      <TextBlock Text="يُستخدم السعر الحالي في التقديرات والعمليات الجديدة. تحتفظ إيصالات الشراء والدفعات الجديدة بسعر الصرف وقت التسجيل؛ لا يعيد تغييره كتابة المصاريف السابقة." Style="{StaticResource WorkspaceHint}" Margin="0,18,0,22"/>
      <Expander Header="إعدادات متقدمة · وقت التطبيق" Foreground="{DynamicResource AppTextPrimary}"><StackPanel Margin="0,16,0,0">
       <TextBlock x:Name="ClockStatus" Style="{StaticResource WorkspaceHint}" Margin="0,0,0,14"/>
       <TextBlock Text="التاريخ والوقت المستخدمان للسجلات الجديدة" Style="{StaticResource WorkspaceLabel}"/>
       <WrapPanel><DatePicker Style="{StaticResource WorkspaceDate}" x:Name="AppDate" Width="165" MinHeight="40" Margin="0,0,0,8"/><TextBox x:Name="AppTime" Style="{StaticResource WorkspaceInput}" Width="120" FlowDirection="LeftToRight" Margin="8,0,0,8" ToolTip="HH:mm · مثال 14:30"/></WrapPanel>
       <WrapPanel Margin="0,8,0,0"><Button Content="حفظ وقت التطبيق" Style="{StaticResource WorkspacePrimary}" Click="SaveClock_Click" Margin="0,0,0,8"/><Button Content="العودة للوقت الافتراضي" Style="{StaticResource WorkspaceButton}" Click="ResetClock_Click" Margin="8,0,0,8"/></WrapPanel>
       <TextBlock Text="لا تتغير ساعة الكمبيوتر أو السجلات السابقة. ساعة التطبيق الأساسية في هذا الإصدار تساوي ساعة الكمبيوتر + 7 ساعات." Style="{StaticResource WorkspaceHint}" Margin="0,8,0,0"/>
      </StackPanel></Expander>
     </StackPanel></Border>
     <Border x:Name="TreatmentsCard" Style="{StaticResource WorkspaceCard}" Visibility="Collapsed"><StackPanel>
      <TextBlock Text="العلاجات والأسعار" Style="{StaticResource WorkspaceHeading}"/><TextBlock Text="يمكن تعديل السعر والعملة مباشرة في الصف ثم حفظه. تبقى أسعار الزيارات السابقة محفوظة." Style="{StaticResource WorkspaceHint}" Margin="0,8,0,16"/>
      <WrapPanel><StackPanel Width="190" Margin="0,0,0,12"><TextBlock Text="اسم العلاج" Style="{StaticResource WorkspaceLabel}"/><TextBox x:Name="TreatmentName" Style="{StaticResource WorkspaceInput}"/></StackPanel><StackPanel Width="110" Margin="8,0,0,12"><TextBlock Text="السعر" Style="{StaticResource WorkspaceLabel}"/><TextBox x:Name="TreatmentPrice" Style="{StaticResource WorkspaceInput}" FlowDirection="LeftToRight"/></StackPanel><StackPanel Width="90" Margin="8,0,0,12"><TextBlock Text="العملة" Style="{StaticResource WorkspaceLabel}"/><ComboBox x:Name="TreatmentCurrency" Style="{StaticResource WorkspaceCombo}"/></StackPanel></WrapPanel>
      <CheckBox x:Name="RequiresCanals" Content="يتطلب بيانات الأقنية" Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,12"/>
      <TextBlock Text="اختر هذا الخيار لأي علاج يتطلب عدد الأقنية وأطوالها، مهما كان اسمه." Style="{StaticResource WorkspaceHint}" Margin="0,0,0,12"/>
      <Button x:Name="AddTreatment" Content="إضافة علاج" Style="{StaticResource WorkspacePrimary}" Click="AddTreatment_Click" HorizontalAlignment="Left"/>
      <WrapPanel Margin="0,22,0,12"><StackPanel Width="210"><TextBlock Text="البحث بالعلاج" Style="{StaticResource WorkspaceLabel}"/><TextBox x:Name="TreatmentSearch" Style="{StaticResource WorkspaceInput}" TextChanged="TreatmentFilter_Changed"/></StackPanel><StackPanel Width="120" Margin="8,0,0,0"><TextBlock Text="تصفية العملة" Style="{StaticResource WorkspaceLabel}"/><ComboBox x:Name="TreatmentFilterCurrency" Style="{StaticResource WorkspaceCombo}" SelectionChanged="TreatmentFilter_Changed"/></StackPanel></WrapPanel>
      <TextBlock x:Name="TreatmentStatus" Style="{StaticResource WorkspaceHint}" Margin="0,0,0,10"/>
      <DataGrid x:Name="TreatmentsGrid" Style="{StaticResource WorkspaceGrid}" MaxHeight="420">
       <DataGrid.Columns><DataGridTextColumn Header="العلاج" Binding="{Binding Name}" Width="*" MinWidth="130"/>
        <DataGridTemplateColumn Header="السعر" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceInput}" FlowDirection="LeftToRight" AutomationProperties.Name="سعر العلاج"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="العملة" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WorkspaceCombo}" AutomationProperties.Name="عملة العلاج"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="حفظ" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="حفظ" Style="{StaticResource WorkspaceButton}" Click="SaveTreatmentRow_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="التفاصيل" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="تعديل" Style="{StaticResource WorkspaceButton}" Click="EditTreatment_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="حذف" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="حذف" Style="{StaticResource WorkspaceButton}" Click="DeleteTreatment_Click" Foreground="{DynamicResource WorkspaceDanger}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </StackPanel></Border>
     <Border x:Name="BackupCard" Style="{StaticResource WorkspaceCard}" Visibility="Collapsed"><StackPanel>
      <TextBlock Text="النسخ الاحتياطي" Style="{StaticResource WorkspaceHeading}"/><TextBlock Text="Google Drive · نسخة من قاعدة بيانات العيادة" Style="{StaticResource WorkspaceHint}" Margin="0,8,0,16"/>
      <TextBlock x:Name="BackupInfo" Style="{StaticResource WorkspaceHint}" Margin="0,0,0,16"/>
      <WrapPanel><Button x:Name="BackupNow" Content="نسخ الآن" Style="{StaticResource WorkspacePrimary}" Click="BackupNow_Click" Margin="0,0,0,8"/><Button x:Name="InspectBackup" Content="عرض نسخة Drive" Style="{StaticResource WorkspaceButton}" Click="InspectBackup_Click" Margin="8,0,0,8"/><Button x:Name="RestoreBackup" Content="استعادة نسخة" Style="{StaticResource WorkspaceButton}" Click="RestoreBackup_Click" Margin="8,0,0,8"/></WrapPanel>
      <ProgressBar x:Name="BackupProgress" Height="4" Visibility="Collapsed" Margin="0,12,0,12"/>
      <TextBlock x:Name="BackupStatus" Style="{StaticResource WorkspaceHint}" Margin="0,8,0,0"/>
      <TextBlock Text="قبل الاستعادة تُحفظ نسخة استرداد محلية، ويظهر تاريخ نسخة Drive قبل التأكيد. يتطلب تطبيق الاستعادة إعادة تشغيل التطبيق. صور المرضى ليست ضمن نسخة قاعدة البيانات." Style="{StaticResource WorkspaceHint}" Margin="0,18,0,0"/>
     </StackPanel></Border>
     <Border x:Name="AboutCard" Style="{StaticResource WorkspaceCard}" Visibility="Collapsed"><StackPanel>
      <TextBlock Text="المساعدة وحول التطبيق" Style="{StaticResource WorkspaceHeading}"/><TextBlock x:Name="VersionLabel" Style="{StaticResource WorkspaceHint}" Margin="0,8,0,16"/>
      <WrapPanel><Button x:Name="CheckUpdates" Content="التحقق من التحديثات" Style="{StaticResource WorkspacePrimary}" Click="CheckUpdates_Click" Margin="0,0,0,8"/><Button Content="نسخ معلومات الإصدار" Style="{StaticResource WorkspaceButton}" Click="CopyVersion_Click" Margin="8,0,0,8"/></WrapPanel>
      <TextBlock x:Name="UpdateStatus" Style="{StaticResource WorkspaceHint}" Margin="0,8,0,14"/>
      <TextBlock Text="ملاحظات التحديث" Style="{StaticResource WorkspaceLabel}"/><TextBlock x:Name="ReleaseNotes" Style="{StaticResource WorkspaceHint}" Margin="0,0,0,22"/>
      <TextBlock Text="تواصل مع المطور" Style="{StaticResource WorkspaceLabel}"/><TextBlock Text="للاقتراحات والاستفسارات والإبلاغ عن الأخطاء." Style="{StaticResource WorkspaceHint}" Margin="0,0,0,12"/>
      <TextBlock Text="د. أحمد خليف · +963935606912" Style="{StaticResource WorkspaceHint}"/>
      <WrapPanel Margin="0,12,0,0"><Button Content="تواصل عبر واتساب" Style="{StaticResource WorkspaceButton}" Click="Contact_Click" Margin="0,0,0,8"/><Button Content="نسخ الرقم" Style="{StaticResource WorkspaceButton}" Click="CopyPhone_Click" Margin="8,0,0,8"/></WrapPanel>
      <TextBlock x:Name="AboutStatus" Style="{StaticResource WorkspaceHint}" Margin="0,8,0,0"/>
     </StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
