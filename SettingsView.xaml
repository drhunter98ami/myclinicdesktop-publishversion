<UserControl x:Class="MyClinic.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:MyClinic"
             xmlns:local="clr-namespace:MyClinic"
             FlowDirection="RightToLeft"
             Background="Transparent"
             Foreground="{DynamicResource AppTextPrimary}"
             FontFamily="Segoe UI"
             FontSize="14"
             PreviewMouseMove="Settings_PreviewMouseMove"
             MouseLeave="Settings_MouseLeave">
    <UserControl.Resources>
        <local:RowNumberConverter x:Key="RowNumberConverter"/>

        <!-- شريط التمرير (ScrollBar) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Margin="2,0,0,0">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{DynamicResource AppBorder}" CornerRadius="3.5"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- أنماط التقويم لـ DatePicker -->
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CalendarDayButton">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DashActiveFilterBg}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CalendarButton">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- نمط البطاقات القياسي -->
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <!-- حقول الإدخال النصية مع دعم النص الإرشادي (Tag) -->
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Margin="12,0"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="10,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBd" Property="BorderBrush" Value="{DynamicResource DashCalendarTodayBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- القوائم المنسدلة (ComboBox) -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SettingsInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="2,1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource DashCalendarTodayBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource DashCalendarTodayNumFg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid>
                                <ToggleButton Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press"/>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="10,0,26,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontWeight="SemiBold"/>
                                <Path Fill="{DynamicResource AppTextSecondary}"
                                      Width="9"
                                      Height="5"
                                      Margin="0,0,10,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 9 0 L 4.5 5 Z"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border Background="{DynamicResource AppCardBg}"
                                            BorderBrush="{DynamicResource SettingsCardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Margin="0,4,0,8"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.22"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="200" Margin="4">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- الزر الأساسي (أزرق ملكي في الفاتح / زمردي متدرج في الداكن) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsPrimaryBtnFg}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsPrimaryBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsPrimaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- الزر الأخضر (للإضافة والتحديثات وواتساب) -->
        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsGreenBtnFg}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsGreenBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsGreenBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- الزر الثانوي المؤطر (لتفقد التحديثات والوقت الافتراضي) -->
        <Style x:Key="SecondaryOutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsOutlineBtnFg}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsOutlineBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsOutlineBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- زر تعديل السعر في جدول العلاجات -->
        <Style x:Key="EditTreatmentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsEditPriceBtnFg}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsEditPriceBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsEditPriceBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSidebarHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- زر الحذف (✕) في جدول العلاجات -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsDeleteBtnFg}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsDeleteBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsDeleteBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <TextBlock Text="✕" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- مفتاح تبديل المظهر (ToggleSwitch) -->
        <Style x:Key="SettingsToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                CornerRadius="14"
                                Background="{DynamicResource SettingsToggleTrackOffBg}"
                                BorderThickness="1.2"
                                BorderBrush="Transparent">
                            <Ellipse x:Name="Knob"
                                     Width="22"
                                     Height="22"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SettingsToggleTrackOnBg}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource SettingsToggleTrackOnBorder}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="SettingsRootGrid" ClipToBounds="True">
        <!-- طبقة الإضاءة الخلفية التفاعلية للوضع الداكن -->
        <Canvas x:Name="SettingsBackSpotlightCanvas"
                Panel.ZIndex="0"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Ellipse x:Name="SettingsBackSpotlight" CacheMode="BitmapCache"
                     Width="620"
                     Height="620"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#4514B8A6" Offset="0.0"/>
                        <GradientStop Color="#220EA5E9" Offset="0.42"/>
                        <GradientStop Color="#0C2DD4BF" Offset="0.72"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="SettingsBackSpotlightTransform" X="-1200" Y="-1200"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <ScrollViewer Panel.ZIndex="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="4,2,4,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.02*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.02*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.08*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.96*"/>
                </Grid.ColumnDefinitions>

                <!-- ══════════════════════════════════════════════════════════════════ -->
                <!-- الصف 0: ترويسة الإعدادات العلوية (تمتد على الأعمدة الأربعة)          -->
                <!-- ══════════════════════════════════════════════════════════════════ -->
                <Border motion:NavigationTransition.Motion="Header" motion:NavigationTransition.Order="0" Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="7"
                        Background="{DynamicResource SettingsBannerBg}"
                        BorderBrush="{DynamicResource SettingsBannerBorder}"
                        BorderThickness="1.2"
                        CornerRadius="18"
                        Padding="28,18"
                        Margin="0,0,0,14"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#2DD4BF"
                                          BlurRadius="20"
                                          ShadowDepth="0"
                                          Opacity="{DynamicResource SettingsBannerGlowOpacity}"/>
                    </Border.Effect>
                    <Grid>
                        <!-- إضاءة علوية ناعمة في الوضع الداكن -->
                        <Ellipse x:Name="SettingsBannerDarkGlow"
                                 Width="360"
                                 Height="180"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="0,-90,0,0"
                                 IsHitTestVisible="False"
                                 Visibility="Collapsed">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#385EEAD4" Offset="0"/>
                                    <GradientStop Color="#005EEAD4" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="الإعدادات"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SettingsBannerTitleFg}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="اضبط القيم التي تؤثر على الحسابات وسير العمل في العيادة"
                                           FontSize="14.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SettingsBannerSubFg}"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource SettingsBannerPillBg}"
                                    BorderBrush="{DynamicResource SettingsBannerPillBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,9"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙"
                                               FontSize="18"
                                               Foreground="{DynamicResource SettingsBannerPillFg}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="مركز التحكم"
                                               FontSize="14.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SettingsBannerPillFg}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════════════ -->
                <!-- الصف 1: البطاقات الأربع العلوية (التحديثات | اسم المستخدم | النسخ الاحتياطي | المظهر) -->
                <!-- ══════════════════════════════════════════════════════════════════ -->

                <!-- 1. التحديثات (أقصى اليمين - العمود 0) -->
                <Border motion:NavigationTransition.Motion="Card" motion:NavigationTransition.Order="1" Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource PanelCardStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="التحديثات" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="تحقق من توفر نسخة جديدة من التطبيق." Style="{StaticResource HintStyle}" Margin="0,4,0,12"/>
                        <Button x:Name="BtnCheckForUpdates"
                                Content="تفقد وجود نسخة جديدة"
                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="BtnCheckForUpdates_Click"/>
                        <Button x:Name="BtnWhatsNew"
                                Content="لمحة عن التحديث الجديد"
                                Style="{StaticResource GreenButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                Click="BtnWhatsNew_Click"/>
                    </StackPanel>
                </Border>

                <!-- 2. اسم المستخدم (العمود 2) -->
                <Border motion:NavigationTransition.Motion="Card" motion:NavigationTransition.Order="2" Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource PanelCardStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="اسم المستخدم" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="غيّر الاسم المستخدم لتسجيل الدخول والظاهر في الشاشة الرئيسية." Style="{StaticResource HintStyle}" Margin="0,4,0,12"/>
                        <TextBox x:Name="TxtUsername" Style="{StaticResource InputBoxStyle}"/>
                        <Button x:Name="BtnSaveUsername"
                                Content="حفظ اسم المستخدم"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                Click="BtnSaveUsername_Click"/>
                    </StackPanel>
                </Border>

                <!-- 3. النسخ الاحتياطي (العمود 4) -->
                <Border motion:NavigationTransition.Motion="Card" motion:NavigationTransition.Order="3" Grid.Row="1"
                        Grid.Column="4"
                        Style="{StaticResource PanelCardStyle}"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="النسخ الاحتياطي" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Grid.Row="1" Text="استعادة نسخة البيانات من Google Drive." Style="{StaticResource HintStyle}" Margin="0,4,0,14"/>
                        <Button Grid.Row="2"
                                x:Name="BtnRestoreDrive"
                                Content="استعادة البيانات"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="BtnRestoreDrive_Click"/>
                    </Grid>
                </Border>

                <!-- 4. المظهر (أقصى اليسار - العمود 6) -->
                <Border motion:NavigationTransition.Motion="Card" motion:NavigationTransition.Order="4" Grid.Row="1"
                        Grid.Column="6"
                        Style="{StaticResource PanelCardStyle}"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="المظهر" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Grid.Row="1" Text="اختر تصميم واجهة التطبيق." Style="{StaticResource HintStyle}" Margin="0,4,0,8"/>
                        <ComboBox Grid.Row="2"
                                  x:Name="InterfaceThemeComboBox"
                                  Style="{StaticResource ComboBoxStyle}"
                                  SelectionChanged="InterfaceThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="التصميم الجديد" Tag="Modern"/>
                            <ComboBoxItem Content="التصميم الأصلي" Tag="Original"/>
                        </ComboBox>
                        <TextBlock Grid.Row="3" Text="الوضع الداكن" Style="{StaticResource HintStyle}" Margin="0,8,0,6"/>
                        <ToggleButton Grid.Row="4"
                                      x:Name="ThemeToggle"
                                      Style="{StaticResource SettingsToggleSwitchStyle}"
                                      Checked="ThemeToggle_Checked"
                                      Unchecked="ThemeToggle_Unchecked"
                                      HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="5" Text="الحركة والتأثيرات" Foreground="{DynamicResource AppTextSecondary}" Margin="0,12,0,6"/>
                        <ComboBox Grid.Row="6" x:Name="MotionLevelComboBox" Style="{StaticResource ComboBoxStyle}" ToolTip="يتبع أيضاً إعدادات الحركة في Windows." SelectionChanged="MotionLevelComboBox_SelectionChanged" MinWidth="120" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="بدون حركة"/>
                            <ComboBoxItem Content="حركة خفيفة"/>
                            <ComboBoxItem Content="حركة كاملة"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════════════ -->
                <!-- الصف 2: سعر الصرف (العمود 0) | ضبط وقت التطبيق (العمود 2)           -->
                <!-- ══════════════════════════════════════════════════════════════════ -->

                <!-- سعر الصرف -->
                <Border motion:NavigationTransition.Motion="Card" motion:NavigationTransition.Order="3" Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource PanelCardStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="سعر الصرف" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="القيمة المستخدمة لتحويل الدولار الأمريكي إلى الليرة السورية في الحسابات الجديدة." Style="{StaticResource HintStyle}" Margin="0,4,0,12"/>

                        <Border Background="{DynamicResource SettingsRateBoxBg}"
                                BorderBrush="{DynamicResource SettingsRateBoxBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,10"
                                Margin="0,0,0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="سعر التحويل الحالي"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SettingsRateBoxLabelFg}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtCurrentExchangeRate"
                                           Text="—"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SettingsRateBoxValueFg}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="1 USD يساوي"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   Margin="0,0,0,6"/>

                        <Border Background="{DynamicResource SettingsInputBg}"
                                BorderBrush="{DynamicResource SettingsInputBorder}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Height="38">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtExchangeRate"
                                         Grid.Column="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource AppTextPrimary}"
                                         CaretBrush="{DynamicResource AppTextPrimary}"
                                         VerticalContentAlignment="Center"
                                         FontWeight="SemiBold"
                                         Padding="10,0"/>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource SettingsCurrencyUnitBg}"
                                        BorderBrush="{DynamicResource SettingsCurrencyUnitBorder}"
                                        BorderThickness="1,0,0,0"
                                        CornerRadius="8,0,0,8"
                                        Padding="14,0">
                                    <TextBlock Text="ل.س"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SettingsCurrencyUnitFg}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Button x:Name="BtnSaveExchangeRate"
                                Content="حفظ سعر الصرف"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,10,0,0"
                                Click="BtnSaveExchangeRate_Click"/>

                        <TextBlock Text="سيتم تحديث التبويبات المرتبطة تلقائياً بعد الحفظ."
                                   Style="{StaticResource HintStyle}"
                                   FontSize="11.5"
                                   TextAlignment="Center"
                                   Margin="0,8,0,8"/>

                        <Border Background="{DynamicResource SettingsTipBoxBg}"
                                BorderBrush="{DynamicResource SettingsTipBoxBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,7">
                            <TextBlock Text="تلميح: غيّر سعر الصرف عند الحاجة فقط؛ القيم المسجلة سابقاً تحتفظ بسعرها وقت الحفظ."
                                       Style="{StaticResource HintStyle}"
                                       FontSize="11"
                                       TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ضبط وقت التطبيق -->
                <Border motion:NavigationTransition.Motion="Card" motion:NavigationTransition.Order="4" Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource PanelCardStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ضبط وقت التطبيق" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="حدد التاريخ والوقت اللذين سيستخدمهما التطبيق في الشاشات والسجلات، دون تغيير ساعة الكمبيوتر." Style="{StaticResource HintStyle}" Margin="0,4,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtAppClockTime"
                                     Grid.Column="0"
                                     Style="{StaticResource InputBoxStyle}"
                                     FlowDirection="LeftToRight"
                                     TextAlignment="Center"
                                     FontWeight="SemiBold"
                                     ToolTip="الوقت بصيغة ساعة:دقيقة (مثال 14:30)"/>
                            <Border Grid.Column="2"
                                    Background="{DynamicResource SettingsInputBg}"
                                    BorderBrush="{DynamicResource SettingsInputBorder}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Height="38"
                                    Padding="8,0">
                                <DatePicker x:Name="DpAppDate"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource AppTextPrimary}"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="الوقت الافتراضي"
                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                    Padding="8,0"
                                    Click="BtnResetAppTime_Click"/>
                            <Button Grid.Column="2"
                                    Content="حفظ الوقت"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="8,0"
                                    Click="BtnSaveAppTime_Click"/>
                        </Grid>

                        <TextBlock Text="سيُحفظ الضبط ويُطبّق على التواريخ والأوقات الجديدة في جميع أقسام التطبيق. يعيد زر الوقت الافتراضي إلى ساعة التطبيق الأساسية دون تغيير ساعة الكمبيوتر."
                                   Style="{StaticResource HintStyle}"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════════════════ -->
                <!-- الصف 3: تواصل مع المطور (يمتد على العمودين 0 و 2)                   -->
                <!-- ══════════════════════════════════════════════════════════════════ -->
                <Border motion:NavigationTransition.Motion="Toolbar" motion:NavigationTransition.Order="5" Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="تواصل مع المطور" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="إذا كان لديك أي اقتراحات أو استفسارات أو أخطاء في التطبيق يمكنك التواصل مع المطور على الواتس أب"
                                       Style="{StaticResource HintStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button Style="{StaticResource GreenButtonStyle}"
                                    Height="36"
                                    Padding="16,0"
                                    Click="BtnContactDeveloper_Click">
                                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center">
                                    <Viewbox Width="17" Height="17" Margin="0,0,7,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="White" Data="M12,1 C5.93,1 1,5.93 1,12 C1,14.13 1.61,16.12 2.67,17.8 L1.5,23 L6.83,21.88 C8.4,22.74 10.16,23.2 12,23.2 C18.07,23.2 23,18.27 23,12.2 C23,6.13 18.07,1.2 12,1.2 Z M12,3.2 C16.97,3.2 21,7.23 21,12.2 C21,17.17 16.97,21.2 12,21.2 C10.34,21.2 8.75,20.75 7.38,19.91 L7,19.68 L4.25,20.26 L4.85,17.59 L4.6,17.2 C3.55,15.74 3,14.01 3,12.2 C3,7.23 7.03,3.2 12,3.2 Z"/>
                                            <Path Fill="White" Data="M9.05,7.1 C8.78,6.5 8.49,6.49 8.23,6.48 C8.02,6.47 7.77,6.47 7.52,6.47 C7.27,6.47 6.86,6.56 6.51,6.94 C6.16,7.32 5.17,8.24 5.17,10.12 C5.17,12 6.54,13.82 6.73,14.07 C6.92,14.32 9.38,18.31 13.28,19.85 C16.52,21.13 17.18,20.88 17.88,20.82 C18.58,20.76 20.14,19.9 20.46,19 C20.78,18.1 20.78,17.33 20.68,17.17 C20.58,17.01 20.32,17.01 19.94,16.72 C19.56,16.53 17.68,15.61 17.33,15.48 C16.98,15.35 16.73,15.29 16.48,15.67 C16.23,16.05 15.52,16.88 15.3,17.13 C15.08,17.38 14.86,17.41 14.48,17.22 C14.1,17.03 12.88,16.61 11.43,15.31 C10.3,14.3 9.54,13.05 9.32,12.67 C9.1,12.29 9.3,12.14 9.49,11.95 C9.66,11.78 9.87,11.51 10.06,11.29 C10.25,11.07 10.31,10.91 10.44,10.66 C10.57,10.41 10.5,10.19 10.4,10 C10.3,9.81 9.56,7.93 9.21,7.18 Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="تواصل عبر واتساب" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="د.أحمد خليف  •  +963935606912"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════════════ -->
                <!-- الصف 2 و 3 (الجانب الأيسر): تكاليف العلاجات (يمتد على العمودين 4 و 6) -->
                <!-- ══════════════════════════════════════════════════════════════════ -->
                <Border motion:NavigationTransition.Motion="Content" motion:NavigationTransition.Order="5" Grid.Row="2"
                        Grid.RowSpan="2"
                        Grid.Column="4"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="تكاليف العلاجات" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Grid.Row="1" Text="أضف الخدمات العلاجية وأسعارها لتظهر بسرعة عند تسجيل الزيارات." Style="{StaticResource HintStyle}" Margin="0,4,0,10"/>

                        <Border Grid.Row="2"
                                Background="{DynamicResource SettingsCalloutBg}"
                                BorderBrush="{DynamicResource SettingsCalloutBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,9"
                                Margin="0,0,0,12">
                            <TextBlock Text="يجب أن يكون (سحب عصب) من ضمن المعالجات ويجب أن تكتب تماماً كما هي مكتوبة هنا لضمان ظهور خيار عدد الأقنية/أطوال الأقنية عند إضافة مريض واختيار سحب عصب من المعالجات."
                                       Foreground="{DynamicResource SettingsCalloutFg}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       LineHeight="18"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- صف إضافة / تعديل علاج -->
                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtTreatmentName"
                                     Grid.Column="0"
                                     Style="{StaticResource InputBoxStyle}"
                                     Tag="اسم العلاج"
                                     ToolTip="اسم العلاج"
                                     Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtTreatmentCost"
                                     Grid.Column="1"
                                     Style="{StaticResource InputBoxStyle}"
                                     Tag="السعر"
                                     ToolTip="التكلفة"
                                     Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbTreatmentCurrency"
                                      Grid.Column="2"
                                      Style="{StaticResource ComboBoxStyle}"
                                      Margin="0,0,8,0">
                                <ComboBoxItem Content="SYP"/>
                                <ComboBoxItem Content="USD"/>
                            </ComboBox>
                            <Button x:Name="BtnAddTreatment"
                                    Grid.Column="3"
                                    Content="إضافة"
                                    MinWidth="82"
                                    Style="{StaticResource GreenButtonStyle}"
                                    Click="BtnAddTreatment_Click"/>
                            <Button x:Name="BtnCancelTreatmentEdit"
                                    Grid.Column="4"
                                    Content="إلغاء"
                                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                                    Margin="8,0,0,0"
                                    Click="BtnCancelTreatmentEdit_Click"
                                    Visibility="Collapsed"/>
                        </Grid>

                        <!-- قائمة العلاجات المسجلة -->
                        <Border Grid.Row="4"
                                Background="{DynamicResource SettingsTableContainerBg}"
                                BorderBrush="{DynamicResource SettingsTableContainerBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                MaxHeight="390"
                                Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl motion:NavigationTransition.Motion="Items" motion:NavigationTransition.Order="4" x:Name="TreatmentItemsControl" AlternationCount="10000">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SettingsTableRowBg}"
                                                    BorderBrush="{DynamicResource SettingsTableRowBorder}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="10,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource RowNumberConverter}}"
                                                               Foreground="{DynamicResource AppTextSecondary}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding TreatmentName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13.5"
                                                               Foreground="{DynamicResource AppTextPrimary}"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,0,0"/>

                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                FlowDirection="LeftToRight"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Cost, StringFormat={}{0:N0}}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13.5"
                                                                   Foreground="{DynamicResource AppTextPrimary}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Currency}"
                                                                   FontWeight="Bold"
                                                                   FontSize="12.5"
                                                                   Foreground="{DynamicResource AppTextSecondary}"
                                                                   Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="3"
                                                            Content="تعديل السعر"
                                                            Margin="6,0,6,0"
                                                            Style="{StaticResource EditTreatmentButtonStyle}"
                                                            Tag="{Binding Id}"
                                                            Click="BtnEditTreatment_Click"/>

                                                    <Button Grid.Column="4"
                                                            Style="{StaticResource DeleteButtonStyle}"
                                                            Tag="{Binding Id}"
                                                            Click="BtnDeleteTreatment_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
